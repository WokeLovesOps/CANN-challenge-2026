// 独立正确性测试入口；不修改赛题 src/main.asc 和 src/CMakeLists.txt。
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include "acl/acl.h"

struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#include "../src/kernel.asc"

#define CHECK(call) do { \
    const aclError code = (call); \
    if (code != ACL_SUCCESS) { \
        std::fprintf(stderr, "%s: %d\n", #call, code); \
        return 1; \
    } \
} while (0)

bool Read(const char* path, std::vector<uint8_t>& data)
{
    FILE* file = std::fopen(path, "rb");
    if (file == nullptr) {
        return false;
    }
    const bool valid = std::fread(data.data(), 1, data.size(), file) == data.size()
        && std::fgetc(file) == EOF;
    std::fclose(file);
    return valid;
}

int main(int argc, char** argv)
{
    if (argc != 8) {
        std::fprintf(stderr, "参数: B M N K dtype transposeX1 transposeX2\n");
        return 2;
    }
    const int64_t batch = std::stoll(argv[1]);
    const int64_t m = std::stoll(argv[2]);
    const int64_t n = std::stoll(argv[3]);
    const int64_t k = std::stoll(argv[4]);
    const int32_t dtype = std::stoi(argv[5]);
    const bool transA = std::stoi(argv[6]) != 0;
    const bool transB = std::stoi(argv[7]) != 0;
    int64_t aShape[] = {batch, transA ? k : m, transA ? m : k};
    int64_t bShape[] = {batch, transB ? n : k, transB ? k : n};
    int64_t yShape[] = {batch};
    TensorInfo aInfo{aShape, 3, dtype};
    TensorInfo bInfo{bShape, 3, dtype};
    TensorInfo yInfo{yShape, 1, 0};
    TensorGroupInfo aGroup{&aInfo, 1};
    TensorGroupInfo bGroup{&bInfo, 1};
    TensorGroupInfo yGroup{&yInfo, 1};
    std::vector<uint8_t> a(batch * m * k * 2);
    std::vector<uint8_t> b(batch * n * k * 2);
    // 前后保护区用于检查输出越界；同时检查输入是否被修改。
    std::vector<uint8_t> y(batch * sizeof(float) + 128, 0xa5);
    if (!Read("x1.bin", a) || !Read("x2.bin", b)) {
        std::fprintf(stderr, "输入文件大小错误或无法读取\n");
        return 2;
    }
    CHECK(aclInit(nullptr));
    CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK(aclrtCreateStream(&stream));
    int64_t cores = 0;
    CHECK(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_CUBE_CORE_NUM, &cores));
    void* deviceA = nullptr;
    void* deviceB = nullptr;
    void* deviceY = nullptr;
    CHECK(aclrtMalloc(&deviceA, a.size(), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&deviceB, b.size(), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&deviceY, y.size(), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(deviceA, a.size(), a.data(), a.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(deviceB, b.size(), b.data(), b.size(), ACL_MEMCPY_HOST_TO_DEVICE));
    std::vector<uint8_t> previous;
    for (int repeat = 0; repeat < 2; ++repeat) {
        CHECK(aclrtMemcpy(deviceY, y.size(), y.data(), y.size(), ACL_MEMCPY_HOST_TO_DEVICE));
        run_kernel((GM_ADDR)deviceA, aGroup, (GM_ADDR)deviceB, bGroup,
            (GM_ADDR)(static_cast<uint8_t*>(deviceY) + 64), yGroup, cores, stream, transA, transB);
        CHECK(aclrtSynchronizeStreamWithTimeout(stream, 60000));
        std::vector<uint8_t> actual(y.size());
        CHECK(aclrtMemcpy(actual.data(), actual.size(), deviceY, actual.size(), ACL_MEMCPY_DEVICE_TO_HOST));
        for (size_t i = 0; i < actual.size(); ++i) {
            if ((i < 64 || i >= 64 + batch * sizeof(float)) && actual[i] != 0xa5) {
                std::fprintf(stderr, "输出保护区被覆盖\n");
                return 1;
            }
        }
        if (repeat != 0 && actual != previous) {
            std::fprintf(stderr, "相同输入重复执行结果不一致\n");
            return 1;
        }
        previous = std::move(actual);
    }
    std::vector<uint8_t> checkA(a.size());
    std::vector<uint8_t> checkB(b.size());
    CHECK(aclrtMemcpy(checkA.data(), checkA.size(), deviceA, a.size(), ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK(aclrtMemcpy(checkB.data(), checkB.size(), deviceB, b.size(), ACL_MEMCPY_DEVICE_TO_HOST));
    if (checkA != a || checkB != b) {
        std::fprintf(stderr, "算子修改了输入\n");
        return 1;
    }
    FILE* file = std::fopen("y.bin", "wb");
    if (file == nullptr) {
        return 2;
    }
    const size_t written = std::fwrite(previous.data() + 64, sizeof(float), batch, file);
    std::fclose(file);
    CHECK(aclrtFree(deviceA));
    CHECK(aclrtFree(deviceB));
    CHECK(aclrtFree(deviceY));
    CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(0));
    CHECK(aclFinalize());
    return written == static_cast<size_t>(batch) ? 0 : 2;
}
