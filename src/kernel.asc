constexpr uint32_t DEFAULT_COLS = 128;
constexpr uint32_t LARGE_BALANCED_ROWS = 128;
constexpr uint32_t LARGE_BALANCED_COLS = 512;
constexpr uint32_t LARGE_BALANCED_BASE_ROWS = 128;
constexpr uint32_t LARGE_BALANCED_BASE_COLS = 256;
constexpr uint32_t LARGE_REDUCE_COLS = 128;
constexpr uint32_t MIN_N_PARTS = 4;
constexpr uint32_t SMALL_VECTOR_K_LIMIT = 64;
constexpr uint32_t SMALL_VECTOR_OUTPUT_LIMIT = 16;
constexpr uint32_t SMALL_VECTOR_MATRIX_ELEMENTS = SMALL_VECTOR_OUTPUT_LIMIT * SMALL_VECTOR_K_LIMIT;
constexpr uint32_t SMALL_BATCH_LIMIT = 4;
constexpr uint32_t SMALL_BATCH_M_LIMIT = 8;
constexpr uint32_t SMALL_BATCH_N_LIMIT = 16;
constexpr uint32_t SMALL_BATCH_A_ELEMENTS = SMALL_BATCH_M_LIMIT * SMALL_VECTOR_K_LIMIT;
constexpr uint32_t SMALL_BATCH_B_ELEMENTS = SMALL_BATCH_N_LIMIT * SMALL_VECTOR_K_LIMIT;
constexpr uint32_t SMALL_BATCH_PRODUCT_ELEMENTS =
    SMALL_BATCH_M_LIMIT * SMALL_BATCH_N_LIMIT * SMALL_VECTOR_K_LIMIT;
constexpr uint32_t MEDIUM_BATCH_LIMIT = 8;
constexpr uint32_t MEDIUM_BATCH_M_LIMIT = 16;
constexpr uint32_t MEDIUM_BATCH_N_LIMIT = 32;
constexpr uint32_t MEDIUM_BATCH_K_LIMIT = 128;
constexpr uint32_t MEDIUM_BATCH_COL_TILE = 16;
constexpr uint32_t MEDIUM_BATCH_K_TILE = 64;
constexpr uint32_t MEDIUM_BATCH_ROW_TILE = 4;
constexpr uint32_t MEDIUM_BATCH_A_ELEMENTS = MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_K_LIMIT;
constexpr uint32_t MEDIUM_BATCH_B_ELEMENTS = MEDIUM_BATCH_N_LIMIT * MEDIUM_BATCH_K_LIMIT;
constexpr uint32_t MEDIUM_BATCH_PRODUCT_ELEMENTS =
    MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE;
constexpr uint32_t MEDIUM_BATCH_DOT_ELEMENTS = MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_COL_TILE;
constexpr uint32_t MEDIUM_BATCH_OUTPUT_STRIDE = 8;
constexpr uint32_t LARGE_BATCH_LIMIT = 16;
constexpr uint32_t LARGE_BATCH_M_LIMIT = 32;
constexpr uint32_t LARGE_BATCH_N_LIMIT = 128;
constexpr uint32_t LARGE_BATCH_K_LIMIT = 256;
constexpr uint32_t LARGE_BATCH_M_TILE = 8;
constexpr uint32_t LARGE_BATCH_COL_TILE = 16;
constexpr uint32_t LARGE_BATCH_K_TILE = 64;
constexpr uint32_t LARGE_BATCH_A_ELEMENTS = LARGE_BATCH_M_TILE * LARGE_BATCH_K_TILE;
constexpr uint32_t LARGE_BATCH_B_ELEMENTS = LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE;
constexpr uint32_t LARGE_BATCH_PRODUCT_ELEMENTS =
    LARGE_BATCH_M_TILE * LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE;
constexpr uint32_t LARGE_BATCH_DOT_ELEMENTS = LARGE_BATCH_M_TILE * LARGE_BATCH_COL_TILE;
constexpr uint32_t LARGE_BATCH_M_TILES = LARGE_BATCH_M_LIMIT / LARGE_BATCH_M_TILE;
// 每个任务独占一个 64 字节槽，避免不同核写同一缓存行。
constexpr uint32_t PARTIAL_STRIDE = 16;

enum class ShapeKey : uint32_t {
    DEFAULT,
    COMPACT_16,
    COMPACT_32,
    LARGE_BALANCED,
    LARGE_TALL,
    SPLIT_K,
    TALL_NARROW,
    WIDE_SHALLOW,
};

struct Parameters {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t rowTiles;
    uint32_t cores;
    AscendC::tiling::TCubeTiling cube;
};

// 冷路径单独下发调度参数，保持热路径Parameters的布局与入口不变。
struct GenericParameters {
    Parameters base;
    uint32_t splitN;
    uint32_t directOutput;
    uint32_t parts;
    uint32_t partialStride;
};

// 单点积的Max和Sum均为恒等操作，用纯Vector消除Cube/KFC固定开销。
template <typename T>
__global__ __aicore__ void ComputeDot(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> convertedBuffer;
    pipe.InitBuffer(inputQueue, 1, 2 * SMALL_VECTOR_K_LIMIT * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(convertedBuffer, 2 * SMALL_VECTOR_K_LIMIT * sizeof(float));

    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    auto input = inputQueue.AllocTensor<T>();
    DataCopyExtParams inputCopy{1, static_cast<uint32_t>(k * sizeof(T)), 0, 0, 0};
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyPad(input, a, inputCopy, padding);
    DataCopyPad(input[SMALL_VECTOR_K_LIMIT], b, inputCopy, padding);
    inputQueue.EnQue(input);
    input = inputQueue.DeQue<T>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[SMALL_VECTOR_K_LIMIT];
    // 两个输入槽分别以128字节间隔存放half、256字节间隔存放float。
    // 用两个repeat合并Cast发射，每次仅转换有效的k个元素，不读槽内空隙。
    UnaryRepeatParams castRepeats{1, 1, 8, 4};
    Cast(aFloat, input, RoundMode::CAST_NONE, static_cast<uint64_t>(k),
        static_cast<uint8_t>(2), castRepeats);
    PipeBarrier<PIPE_V>();
    Mul(aFloat, aFloat, bFloat, k);
    PipeBarrier<PIPE_V>();
    auto result = outputQueue.AllocTensor<float>();
    // 单点积路径的 K 不超过 64，FP32 一次 repeat 即可完成全部归约。
    WholeReduceSum(result, aFloat, static_cast<int32_t>(k), 1, 1, 1, 8);
    inputQueue.FreeTensor(input);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output, result, outputCopy);
    outputQueue.FreeTensor(result);
}

// K=32单点积使用紧凑对齐槽，减少TPipe初始化和运行时参数开销。
template <typename T>
__global__ __aicore__ void ComputeDot32(GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    // 只由核0计算和写出，额外启动核立即退出，避免输出竞争。
    if (GetBlockIdx() != 0) {
        return;
    }
    constexpr uint32_t K = 32;
    // 单任务固定UB布局，保留必要硬件状态设置，省去TPipe资源登记。
    SetAtomicNone();
    SetMaskNorm();
    ResetMask();
    constexpr uint32_t inputBufferOffset = 0;
    // A/B各留128B槽，只转换各槽前64B。
    constexpr uint32_t inputStride = 2 * K;
    constexpr uint32_t inputBufferBytes = 2 * inputStride * sizeof(T);
    constexpr uint32_t convertedBufferOffset = (inputBufferOffset + inputBufferBytes + 31) / 32 * 32;
    constexpr uint32_t convertedBufferBytes = 2 * K * sizeof(float);
    constexpr uint32_t outputBufferOffset = (convertedBufferOffset + convertedBufferBytes + 31) / 32 * 32;
    constexpr uint32_t outputBufferBytes = 32;
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    auto input = LocalTensor<T>(TPosition::VECCALC, inputBufferOffset, inputBufferBytes / sizeof(T));
    auto aFloat = LocalTensor<float>(TPosition::VECCALC, convertedBufferOffset, convertedBufferBytes / sizeof(float));
    auto bFloat = aFloat[K];
    auto result = LocalTensor<float>(TPosition::VECCALC, outputBufferOffset, outputBufferBytes / sizeof(float));
    DataCopyExtParams inputCopy{1, 64, 0, 0, 0};
    DataCopyPadExtParams<T> noPadding{false, 0, 0, 0};
    DataCopyPad(input, a, inputCopy, noPadding);
    DataCopyPad(input[inputStride], b, inputCopy, noPadding);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    // 每槽只Cast32个half，跳过额外读入的后64B，不参与数学计算。
    UnaryRepeatParams castRepeats{1, 1, 4, 4};
    Cast(aFloat, input, RoundMode::CAST_NONE, static_cast<uint64_t>(K),
        static_cast<uint8_t>(2), castRepeats);
    PipeBarrier<PIPE_V>();
    Mul(aFloat, aFloat, bFloat, K);
    PipeBarrier<PIPE_V>();
    WholeReduceSum(result, aFloat, static_cast<int32_t>(K), 1, 1, 1, 4);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output, result, outputCopy);
}

// 点6精确形状：手动GM->L1->L0->FP32 MMAD->GM，随后同一个混合核完成Vector归约。
// 仅使用基础API，flag8遵循官方CrossCoreSetFlag的AIC->AIV示例，不与Matmul高阶API混用。
__global__ __aicore__ void ComputePoint6ManualCube(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch, GM_ADDR y)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    constexpr uint32_t M = 23, N = 73, K = 192, PAD_M = 32, PAD_N = 80;
    const uint32_t batch = GetBlockIdx();
    TPipe pipe;
    GlobalTensor<float> matrix;
    matrix.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + batch * PAD_M * PAD_N);
    if ASCEND_IS_AIC {
        TQue<TPosition::A1, 1> a1Queue;
        TQue<TPosition::B1, 1> b1Queue, bTailQueue;
        TQue<TPosition::A2, 1> a2Queue;
        TQue<TPosition::B2, 1> b2Queue;
        TQue<TPosition::CO1, 1> c1Queue;
        pipe.InitBuffer(a1Queue, 1, PAD_M * K * sizeof(bfloat16_t));
        pipe.InitBuffer(b1Queue, 1, 32 * K * sizeof(bfloat16_t));
        pipe.InitBuffer(bTailQueue, 1, 48 * K * sizeof(bfloat16_t));
        pipe.InitBuffer(a2Queue, 1, PAD_M * K * sizeof(bfloat16_t));
        pipe.InitBuffer(b2Queue, 1, PAD_N * K * sizeof(bfloat16_t));
        pipe.InitBuffer(c1Queue, 1, PAD_M * PAD_N * sizeof(float));
        GlobalTensor<bfloat16_t> a, b;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x1) + batch * M * K);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x2) + batch * N * K);
        auto a1 = a1Queue.AllocTensor<bfloat16_t>();
        auto b1 = b1Queue.AllocTensor<bfloat16_t>();
        auto bTail = bTailQueue.AllocTensor<bfloat16_t>();
        Nd2NzParams copyA{};
        copyA.ndNum = 1;
        copyA.nValue = M;
        copyA.dValue = K;
        copyA.srcDValue = K;
        copyA.dstNzC0Stride = PAD_M;
        copyA.dstNzNStride = 1;
        Nd2NzParams copyB = copyA;
        copyB.nValue = 32;
        copyB.dstNzC0Stride = 32;
        Nd2NzParams copyTail = copyB;
        copyTail.nValue = N - 32;
        copyTail.dstNzC0Stride = 48;
        DataCopy(a1, a, copyA);
        a1Queue.EnQue(a1);
        DataCopy(b1, b, copyB);
        b1Queue.EnQue(b1);
        DataCopy(bTail, b[32 * K], copyTail);
        bTailQueue.EnQue(bTail);
        a1 = a1Queue.DeQue<bfloat16_t>();
        auto a2 = a2Queue.AllocTensor<bfloat16_t>();
        auto b2 = b2Queue.AllocTensor<bfloat16_t>();
        LoadData2DParams loadA{};
        loadA.repeatTimes = K / 16;
        loadA.srcStride = PAD_M / 16;
        loadA.ifTranspose = false;
        for (uint32_t rowBlock = 0; rowBlock < PAD_M / 16; ++rowBlock) {
            LoadData(a2[rowBlock * K * 16], a1[rowBlock * 256], loadA);
        }
        LoadData2DParams loadB{};
        loadB.repeatTimes = K / 16;
        loadB.srcStride = 2;
        loadB.dstGap = 4;
        loadB.ifTranspose = false;
        b1 = b1Queue.DeQue<bfloat16_t>();
        for (uint32_t col = 0; col < 2; ++col) {
            LoadData(b2[col * 256], b1[col * 256], loadB);
        }
        bTail = bTailQueue.DeQue<bfloat16_t>();
        loadB.srcStride = 3;
        for (uint32_t col = 0; col < 3; ++col) {
            LoadData(b2[(col + 2) * 256], bTail[col * 256], loadB);
        }
        a2Queue.EnQue(a2);
        b2Queue.EnQue(b2);
        a1Queue.FreeTensor(a1);
        b1Queue.FreeTensor(b1);
        bTailQueue.FreeTensor(bTail);
        a2 = a2Queue.DeQue<bfloat16_t>();
        b2 = b2Queue.DeQue<bfloat16_t>();
        auto c1 = c1Queue.AllocTensor<float>();
        MmadParams multiply{};
        multiply.m = M;
        multiply.n = N;
        multiply.k = K;
        multiply.cmatrixInitVal = true;
        Mmad(c1, a2, b2, multiply);
        a2Queue.FreeTensor(a2);
        b2Queue.FreeTensor(b2);
        c1Queue.EnQue(c1);
        c1 = c1Queue.DeQue<float>();
        FixpipeParamsV220 copyC{};
        copyC.nSize = PAD_N;
        copyC.mSize = M;
        copyC.srcStride = PAD_M;
        copyC.dstStride = M * 16 * sizeof(float) / 32;
        copyC.ndNum = 1;
        copyC.quantPre = QuantMode_t::NoQuant;
        Fixpipe<float, float, CFG_NZ>(matrix, c1, copyC);
        CrossCoreSetFlag<0x2, PIPE_FIX>(0x8);
        c1Queue.FreeTensor(c1);
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> inputQueue;
        TQue<TPosition::VECOUT, 1> outputQueue;
        TBuf<TPosition::VECCALC> firstBuffer, secondBuffer;
        pipe.InitBuffer(inputQueue, 1, M * PAD_N * sizeof(float));
        pipe.InitBuffer(outputQueue, 1, 32);
        pipe.InitBuffer(firstBuffer, PAD_M * sizeof(float));
        pipe.InitBuffer(secondBuffer, PAD_M * sizeof(float));
        GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
        CrossCoreWaitFlag(0x8);
        auto input = inputQueue.AllocTensor<float>();
        DataCopy(input, matrix, M * PAD_N);
        inputQueue.EnQue(input);
        input = inputQueue.DeQue<float>();
        auto first = firstBuffer.Get<float>();
        auto second = secondBuffer.Get<float>();
        // 每行分两组8列，从5个N16块跨块归约；最后一块第二组仅1列有效。
        WholeReduceMax(first, input, 40, M, 1, M * 2, 2, ReduceOrder::ORDER_ONLY_VALUE);
        WholeReduceMax(second, input[8], 33, M, 1, M * 2, 2, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        Max(first, first, second, M);
        PipeBarrier<PIPE_V>();
        auto result = outputQueue.AllocTensor<float>();
        WholeReduceSum(result, first, M, 1, 1, 1, 4);
        inputQueue.FreeTensor(input);
        outputQueue.EnQue(result);
        result = outputQueue.DeQue<float>();
        DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
        DataCopyPad(output[batch], result, copy);
        outputQueue.FreeTensor(result);
    }
}

// 点7精确形状：手动GM->L1->L0->FP32 MMAD->GM，随后同一个混合核完成Vector归约。
// 仅使用基础API，flag8遵循官方CrossCoreSetFlag的AIC->AIV示例，不与Matmul高阶API混用。
__global__ __aicore__ void ComputePoint7ManualCube(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch, GM_ADDR y)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    constexpr uint32_t M = 32, N = 128, K = 256, PAD_M = 32, PAD_N = 128;
    const uint32_t batch = GetBlockIdx();
    TPipe pipe;
    GlobalTensor<float> matrix;
    matrix.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + batch * PAD_M * PAD_N);
    if ASCEND_IS_AIC {
        TQue<TPosition::A1, 1> a1Queue;
        TQue<TPosition::B1, 1> b1Queue;
        TQue<TPosition::A2, 1> a2Queue;
        TQue<TPosition::B2, 1> b2Queue;
        TQue<TPosition::CO1, 1> c1Queue;
        pipe.InitBuffer(a1Queue, 1, PAD_M * K * sizeof(half));
        pipe.InitBuffer(b1Queue, 1, PAD_N * K * sizeof(half));
        pipe.InitBuffer(a2Queue, 1, PAD_M * K * sizeof(half));
        pipe.InitBuffer(b2Queue, 1, PAD_N * K * sizeof(half));
        pipe.InitBuffer(c1Queue, 1, PAD_M * PAD_N * sizeof(float));
        GlobalTensor<half> a, b;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + batch * M * K);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) + batch * N * K);
        auto a1 = a1Queue.AllocTensor<half>();
        auto b1 = b1Queue.AllocTensor<half>();
        Nd2NzParams copyA{};
        copyA.ndNum = 1;
        copyA.nValue = K;
        copyA.dValue = M;
        copyA.srcDValue = M;
        copyA.dstNzC0Stride = K;
        copyA.dstNzNStride = 1;
        Nd2NzParams copyB = copyA;
        copyB.nValue = K;
        copyB.dValue = N;
        copyB.srcDValue = N;
        copyB.dstNzC0Stride = K;
        DataCopy(a1, a, copyA);
        DataCopy(b1, b, copyB);
        a1Queue.EnQue(a1);
        b1Queue.EnQue(b1);
        a1 = a1Queue.DeQue<half>();
        b1 = b1Queue.DeQue<half>();
        auto a2 = a2Queue.AllocTensor<half>();
        auto b2 = b2Queue.AllocTensor<half>();
        LoadData2DParams loadA{};
        loadA.repeatTimes = K / 16;
        loadA.srcStride = 1;
        loadA.ifTranspose = true;
        for (uint32_t rowBlock = 0; rowBlock < PAD_M / 16; ++rowBlock) {
            LoadData(a2[rowBlock * K * 16], a1[rowBlock * K * 16], loadA);
        }
        LoadData2DParams loadB{};
        loadB.repeatTimes = PAD_N / 16;
        loadB.srcStride = K / 16;
        loadB.ifTranspose = true;
        for (uint32_t kBlock = 0; kBlock < K / 16; ++kBlock) {
            LoadData(b2[kBlock * PAD_N * 16], b1[kBlock * 256], loadB);
        }
        a2Queue.EnQue(a2);
        b2Queue.EnQue(b2);
        a1Queue.FreeTensor(a1);
        b1Queue.FreeTensor(b1);
        a2 = a2Queue.DeQue<half>();
        b2 = b2Queue.DeQue<half>();
        auto c1 = c1Queue.AllocTensor<float>();
        MmadParams multiply{};
        multiply.m = M;
        multiply.n = N;
        multiply.k = K;
        multiply.cmatrixInitVal = true;
        Mmad(c1, a2, b2, multiply);
        a2Queue.FreeTensor(a2);
        b2Queue.FreeTensor(b2);
        c1Queue.EnQue(c1);
        c1 = c1Queue.DeQue<float>();
        FixpipeParamsV220 copyC{};
        copyC.nSize = N;
        copyC.mSize = M;
        copyC.srcStride = PAD_M;
        copyC.dstStride = PAD_N;
        copyC.ndNum = 1;
        copyC.quantPre = QuantMode_t::NoQuant;
        Fixpipe(matrix, c1, copyC);
        CrossCoreSetFlag<0x2, PIPE_FIX>(0x8);
        c1Queue.FreeTensor(c1);
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> inputQueue;
        TQue<TPosition::VECOUT, 1> outputQueue;
        TBuf<TPosition::VECCALC> firstBuffer, secondBuffer;
        pipe.InitBuffer(inputQueue, 1, M * PAD_N * sizeof(float));
        pipe.InitBuffer(outputQueue, 1, 32);
        pipe.InitBuffer(firstBuffer, PAD_M * sizeof(float));
        pipe.InitBuffer(secondBuffer, PAD_M * sizeof(float));
        GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
        CrossCoreWaitFlag(0x8);
        auto input = inputQueue.AllocTensor<float>();
        DataCopy(input, matrix, M * PAD_N);
        inputQueue.EnQue(input);
        input = inputQueue.DeQue<float>();
        auto first = firstBuffer.Get<float>();
        auto second = secondBuffer.Get<float>();
        // 先把超过64列的尾段折叠到前段，再仅做一次水平Max。
        BinaryRepeatParams foldRepeat{1, 1, 1, PAD_N / 8, PAD_N / 8, PAD_N / 8};
        Max(input, input, input[64], N - 64, M, foldRepeat);
        PipeBarrier<PIPE_V>();
        WholeReduceMax(first, input, 64, M, 1, 1, PAD_N / 8,
            ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        auto result = outputQueue.AllocTensor<float>();
        WholeReduceSum(result, first, M, 1, 1, 1, 4);
        inputQueue.FreeTensor(input);
        outputQueue.EnQue(result);
        result = outputQueue.DeQue<float>();
        DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
        DataCopyPad(output[batch], result, copy);
        outputQueue.FreeTensor(result);
    }
}

// 紧凑矩阵的基础Cube与Vector融合；保留实际M/N，不依赖历史测试形状。
template <typename T, bool TRANS_A, bool TRANS_B, uint32_t PAD_N>
__global__ __aicore__ void ComputeSmallManualCube(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR y, uint32_t m, uint32_t n)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    constexpr uint32_t K = 128, PAD_M = 16;
    const uint32_t batch = GetBlockIdx();
    TPipe pipe;
    GlobalTensor<float> matrix;
    matrix.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + batch * PAD_M * PAD_N);
    if ASCEND_IS_AIC {
        TQue<TPosition::A1, 1> a1Queue;
        TQue<TPosition::B1, 1> b1Queue;
        TQue<TPosition::A2, 1> a2Queue;
        TQue<TPosition::B2, 1> b2Queue;
        TQue<TPosition::CO1, 1> c1Queue;
        pipe.InitBuffer(a1Queue, 1, PAD_M * K * sizeof(T));
        pipe.InitBuffer(b1Queue, 1, PAD_N * K * sizeof(T));
        pipe.InitBuffer(a2Queue, 1, PAD_M * K * sizeof(T));
        pipe.InitBuffer(b2Queue, 1, PAD_N * K * sizeof(T));
        pipe.InitBuffer(c1Queue, 1, PAD_M * PAD_N * sizeof(float));
        GlobalTensor<T> a, b;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1) + batch * m * K);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2) + batch * n * K);
        auto a1 = a1Queue.template AllocTensor<T>();
        auto b1 = b1Queue.template AllocTensor<T>();
        Nd2NzParams copyA{};
        copyA.ndNum = 1;
        copyA.nValue = TRANS_A ? K : m;
        copyA.dValue = TRANS_A ? m : K;
        copyA.srcDValue = TRANS_A ? m : K;
        copyA.dstNzC0Stride = TRANS_A ? K : PAD_M;
        copyA.dstNzNStride = 1;
        Nd2NzParams copyB{};
        copyB.ndNum = 1;
        copyB.nValue = TRANS_B ? n : K;
        copyB.dValue = TRANS_B ? K : n;
        copyB.srcDValue = TRANS_B ? K : n;
        copyB.dstNzC0Stride = TRANS_B ? PAD_N : K;
        copyB.dstNzNStride = 1;
        DataCopy(a1, a, copyA);
        DataCopy(b1, b, copyB);
        a1Queue.EnQue(a1);
        b1Queue.EnQue(b1);
        a1 = a1Queue.template DeQue<T>();
        b1 = b1Queue.template DeQue<T>();
        auto a2 = a2Queue.template AllocTensor<T>();
        auto b2 = b2Queue.template AllocTensor<T>();
        LoadData2DParams loadA{};
        loadA.repeatTimes = K / 16;
        loadA.srcStride = 1;
        loadA.ifTranspose = TRANS_A;
        LoadData(a2, a1, loadA);
        LoadData2DParams loadB{};
        if constexpr (TRANS_B) {
            loadB.repeatTimes = (K / 16) * (PAD_N / 16);
            loadB.srcStride = 1;
            loadB.ifTranspose = false;
            LoadData(b2, b1, loadB);
        } else {
            loadB.repeatTimes = PAD_N / 16;
            loadB.srcStride = K / 16;
            loadB.ifTranspose = true;
            for (uint32_t kBlock = 0; kBlock < K / 16; ++kBlock) {
                LoadData(b2[kBlock * PAD_N * 16], b1[kBlock * 256], loadB);
            }
        }
        a2Queue.EnQue(a2);
        b2Queue.EnQue(b2);
        a1Queue.FreeTensor(a1);
        b1Queue.FreeTensor(b1);
        a2 = a2Queue.template DeQue<T>();
        b2 = b2Queue.template DeQue<T>();
        auto c1 = c1Queue.template AllocTensor<float>();
        MmadParams multiply{};
        // 保持L0A的16行NZ布局，避免M=1切换为GEMV的ND布局。
        multiply.m = PAD_M;
        multiply.n = PAD_N;
        multiply.k = K;
        multiply.cmatrixInitVal = true;
        Mmad(c1, a2, b2, multiply);
        a2Queue.FreeTensor(a2);
        b2Queue.FreeTensor(b2);
        c1Queue.EnQue(c1);
        c1 = c1Queue.template DeQue<float>();
        FixpipeParamsV220 copyC{};
        copyC.nSize = n;
        copyC.mSize = m;
        copyC.srcStride = PAD_M;
        copyC.dstStride = PAD_N;
        copyC.ndNum = 1;
        copyC.quantPre = QuantMode_t::NoQuant;
        Fixpipe(matrix, c1, copyC);
        CrossCoreSetFlag<0x2, PIPE_FIX>(0x8);
        c1Queue.FreeTensor(c1);
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> inputQueue;
        TQue<TPosition::VECOUT, 1> outputQueue;
        TBuf<TPosition::VECCALC> maximumBuffer;
        pipe.InitBuffer(inputQueue, 1, PAD_M * PAD_N * sizeof(float));
        pipe.InitBuffer(outputQueue, 1, 32);
        pipe.InitBuffer(maximumBuffer, PAD_M * sizeof(float));
        GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
        CrossCoreWaitFlag(0x8);
        auto input = inputQueue.template AllocTensor<float>();
        DataCopy(input, matrix, m * PAD_N);
        inputQueue.EnQue(input);
        input = inputQueue.template DeQue<float>();
        auto maxima = maximumBuffer.template Get<float>();
        WholeReduceMax(maxima, input, n, m, 1, 1, PAD_N / 8, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        auto result = outputQueue.template AllocTensor<float>();
        WholeReduceSum(result, maxima, m, 1, 1, 1, 2);
        inputQueue.FreeTensor(input);
        outputQueue.EnQue(result);
        result = outputQueue.template DeQue<float>();
        DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
        DataCopyPad(output[batch], result, copy);
        outputQueue.FreeTensor(result);
    }
}

// 小输出矩阵先把转置方向打包为连续K向量，再以FP32 Vector点积完成Max-Sum。
template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputePackedDotsFixed(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t runtimeM, uint32_t runtimeN, uint32_t runtimeK)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    constexpr uint32_t m = 3;
    constexpr uint32_t n = 5;
    constexpr uint32_t k = 40;
    static_assert(TRANS_A && !TRANS_B, "compact Cast-Gather requires TN layout");
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    pipe.InitBuffer(inputQueue, 1, 2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);

    constexpr uint32_t outputEnd = 2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(T) + 32;
    constexpr uint32_t rawConvertedBufferOffset = (outputEnd + 31) / 32 * 32;
    constexpr uint32_t offsetBufferOffset = (rawConvertedBufferOffset + (2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float)) + 31) / 32 * 32;
    constexpr uint32_t convertedBufferOffset = (offsetBufferOffset + (2 * SMALL_VECTOR_K_LIMIT * sizeof(uint32_t)) + 31) / 32 * 32;
    constexpr uint32_t productBufferOffset = (convertedBufferOffset + (2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float)) + 31) / 32 * 32;
    constexpr uint32_t dotBufferOffset = (productBufferOffset + (SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float)) + 31) / 32 * 32;
    constexpr uint32_t maximumBufferOffset = (dotBufferOffset + (SMALL_VECTOR_OUTPUT_LIMIT * 8 * sizeof(float)) + 31) / 32 * 32;

    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    // 两段紧凑输入以32字节对齐相邻存放，搬运尾部补零。
    constexpr uint32_t inputBOffset = (m * k + 15) / 16 * 16;
    DataCopyPadExtParams<T> padding{true, 0, 8, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    // 连续 K 向量在搬入 UB 时按 64 元素分槽，保证每一行 Cast 的源地址对齐。
    // GM 行距仍为实际 K；转置布局继续保留紧凑输入供 Gather 重排。
    const uint32_t alignedK = (k + 15) / 16 * 16;
    const uint32_t gapBlocks = (SMALL_VECTOR_K_LIMIT - alignedK) / 16;
    if constexpr (!TRANS_A) {
        aCopy = {static_cast<uint16_t>(m), static_cast<uint32_t>(k * sizeof(T)),
            0, gapBlocks, 0};
    }
    if constexpr (TRANS_B) {
        bCopy = {static_cast<uint16_t>(n), static_cast<uint32_t>(k * sizeof(T)),
            0, gapBlocks, 0};
    }
    DataCopyPad(input, a, aCopy, padding);
    DataCopyPad(input[inputBOffset], b, bCopy, padding);
    inputQueue.EnQue(input);
    auto aOffsets = LocalTensor<int32_t>(TPosition::VECCALC, offsetBufferOffset, (2 * SMALL_VECTOR_K_LIMIT * sizeof(uint32_t)) / sizeof(int32_t));
    auto bOffsets = aOffsets[SMALL_VECTOR_K_LIMIT];
    if constexpr (TRANS_A && !TRANS_B) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(bOffsets, aOffsets, static_cast<int32_t>(n * sizeof(float)), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(float)), k);
        PipeBarrier<PIPE_V>();
    } else {
        if constexpr (TRANS_A) {
            CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
            PipeBarrier<PIPE_V>();
            Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
            PipeBarrier<PIPE_V>();
        }
        if constexpr (!TRANS_B) {
            CreateVecIndex(bOffsets, static_cast<int32_t>(0), k);
            PipeBarrier<PIPE_V>();
            Muls(bOffsets, bOffsets, static_cast<int32_t>(n * sizeof(T)), k);
            PipeBarrier<PIPE_V>();
        }
    }
    input = inputQueue.DeQue<T>();

    // 紧凑输入先连续转为FP32，再按原64元素行槽重排。
    auto rawA = LocalTensor<float>(TPosition::VECCALC, rawConvertedBufferOffset, (2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float)) / sizeof(float));
    auto rawB = rawA[inputBOffset];
    // 一次连续Cast处理两段输入，A尾部8个零不参与点积。
    Cast(rawA, input, RoundMode::CAST_NONE, inputBOffset + n * k);
    PipeBarrier<PIPE_V>();
    auto packedA = LocalTensor<float>(TPosition::VECCALC, convertedBufferOffset, (2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float)) / sizeof(float));
    auto packedB = packedA[SMALL_VECTOR_MATRIX_ELEMENTS];
    if constexpr (TRANS_A) {
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        #pragma unroll
    for (uint32_t row = 0; row < m; ++row) {
            Gather(packedA[row * SMALL_VECTOR_K_LIMIT], rawA, gatherOffsets,
                row * sizeof(float), k);
        }
    }
    if constexpr (!TRANS_B) {
        auto gatherOffsets = bOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t col = 0; col < n; ++col) {
            Gather(packedB[col * SMALL_VECTOR_K_LIMIT], rawB, gatherOffsets,
                col * sizeof(float), k);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = LocalTensor<float>(TPosition::VECCALC, convertedBufferOffset, (2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float)) / sizeof(float));
    auto bFloat = aFloat[SMALL_VECTOR_MATRIX_ELEMENTS];
    // Gather已经写入FP32行槽，直接沿用原乘法和归约布局。

    auto products = LocalTensor<float>(TPosition::VECCALC, productBufferOffset, (SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float)) / sizeof(float));
    auto dots = LocalTensor<float>(TPosition::VECCALC, dotBufferOffset, (SMALL_VECTOR_OUTPUT_LIMIT * 8 * sizeof(float)) / sizeof(float));
    BinaryRepeatParams multiplyRepeats{1, 1, 1, 8, 0, 8};
    #pragma unroll
    for (uint32_t row = 0; row < m; ++row) {
        auto aVector = aFloat[row * SMALL_VECTOR_K_LIMIT];
        Mul(products[row * n * SMALL_VECTOR_K_LIMIT], aVector, bFloat,
            static_cast<uint64_t>(k), static_cast<uint8_t>(n), multiplyRepeats);
    }
    PipeBarrier<PIPE_V>();
    WholeReduceSum(dots, products, static_cast<int32_t>(k),
        static_cast<int32_t>(m * n), 8, 1, 8);
    PipeBarrier<PIPE_V>();
    auto maxima = LocalTensor<float>(TPosition::VECCALC, maximumBufferOffset, (64) / sizeof(float));
    uint64_t maximumMask[2] = {0x101010101ULL, 0};
    WholeReduceMax(maxima, dots, maximumMask, static_cast<int32_t>(m),
        1, 1, static_cast<int32_t>(n), ReduceOrder::ORDER_ONLY_VALUE);
    PipeBarrier<PIPE_V>();
    inputQueue.FreeTensor(input);
    auto result = outputQueue.AllocTensor<float>();
    WholeReduceSum(result, maxima, static_cast<int32_t>(m), 1, 1, 1, 1);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output, result, outputCopy);
    outputQueue.FreeTensor(result);
}

template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputePackedDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t m, uint32_t n, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> packedBuffer;
    TBuf<TPosition::VECCALC> offsetBuffer;
    TBuf<TPosition::VECCALC> convertedBuffer;
    TBuf<TPosition::VECCALC> productBuffer;
    TBuf<TPosition::VECCALC> dotBuffer;
    TBuf<TPosition::VECCALC> maximumBuffer;
    pipe.InitBuffer(inputQueue, 1, 2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(packedBuffer, 2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(T));
    pipe.InitBuffer(offsetBuffer, 2 * SMALL_VECTOR_K_LIMIT * sizeof(uint32_t));
    pipe.InitBuffer(convertedBuffer, 2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float));
    pipe.InitBuffer(productBuffer, SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float));
    pipe.InitBuffer(dotBuffer, SMALL_VECTOR_OUTPUT_LIMIT * 8 * sizeof(float));
    pipe.InitBuffer(maximumBuffer, 64);

    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    // 连续 K 向量在搬入 UB 时按 64 元素分槽，保证每一行 Cast 的源地址对齐。
    // GM 行距仍为实际 K；转置布局继续保留紧凑输入供 Gather 重排。
    const uint32_t alignedK = (k + 15) / 16 * 16;
    const uint32_t gapBlocks = (SMALL_VECTOR_K_LIMIT - alignedK) / 16;
    if constexpr (!TRANS_A) {
        aCopy = {static_cast<uint16_t>(m), static_cast<uint32_t>(k * sizeof(T)),
            0, gapBlocks, 0};
    }
    if constexpr (TRANS_B) {
        bCopy = {static_cast<uint16_t>(n), static_cast<uint32_t>(k * sizeof(T)),
            0, gapBlocks, 0};
    }
    DataCopyPad(input, a, aCopy, padding);
    DataCopyPad(input[SMALL_VECTOR_MATRIX_ELEMENTS], b, bCopy, padding);
    inputQueue.EnQue(input);
    auto aOffsets = offsetBuffer.Get<int32_t>();
    auto bOffsets = aOffsets[SMALL_VECTOR_K_LIMIT];
    if constexpr (TRANS_A && !TRANS_B) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(bOffsets, aOffsets, static_cast<int32_t>(n * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
    } else {
        if constexpr (TRANS_A) {
            CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
            PipeBarrier<PIPE_V>();
            Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
            PipeBarrier<PIPE_V>();
        }
        if constexpr (!TRANS_B) {
            CreateVecIndex(bOffsets, static_cast<int32_t>(0), k);
            PipeBarrier<PIPE_V>();
            Muls(bOffsets, bOffsets, static_cast<int32_t>(n * sizeof(T)), k);
            PipeBarrier<PIPE_V>();
        }
    }
    input = inputQueue.DeQue<T>();

    auto rawA = input;
    auto rawB = input[SMALL_VECTOR_MATRIX_ELEMENTS];
    auto packedA = packedBuffer.Get<T>();
    auto packedB = packedA[SMALL_VECTOR_MATRIX_ELEMENTS];
    if constexpr (TRANS_A) {
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t row = 0; row < m; ++row) {
            Gather(packedA[row * SMALL_VECTOR_K_LIMIT], rawA, gatherOffsets,
                row * sizeof(T), k);
        }
    }
    if constexpr (!TRANS_B) {
        auto gatherOffsets = bOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t col = 0; col < n; ++col) {
            Gather(packedB[col * SMALL_VECTOR_K_LIMIT], rawB, gatherOffsets,
                col * sizeof(T), k);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[SMALL_VECTOR_MATRIX_ELEMENTS];
    // 保持每个输入向量的64元素对齐槽，只合并Cast发射；不改成实际K紧凑排布。
    UnaryRepeatParams castRepeats{1, 1, 8, 4};
    auto aSource = TRANS_A ? packedA : rawA;
    auto bSource = TRANS_B ? rawB : packedB;
    Cast(aFloat, aSource, RoundMode::CAST_NONE, static_cast<uint64_t>(k),
        static_cast<uint8_t>(m), castRepeats);
    Cast(bFloat, bSource, RoundMode::CAST_NONE, static_cast<uint64_t>(k),
        static_cast<uint8_t>(n), castRepeats);
    PipeBarrier<PIPE_V>();

    auto products = productBuffer.Get<float>();
    auto dots = dotBuffer.Get<float>();
    BinaryRepeatParams multiplyRepeats{1, 1, 1, 8, 0, 8};
    for (uint32_t row = 0; row < m; ++row) {
        auto aVector = aFloat[row * SMALL_VECTOR_K_LIMIT];
        Mul(products[row * n * SMALL_VECTOR_K_LIMIT], aVector, bFloat,
            static_cast<uint64_t>(k), static_cast<uint8_t>(n), multiplyRepeats);
    }
    PipeBarrier<PIPE_V>();
    for (uint32_t row = 0; row < m; ++row) {
        WholeReduceSum(dots[row * 8], products[row * n * SMALL_VECTOR_K_LIMIT],
            static_cast<int32_t>(k), static_cast<int32_t>(n), 1, 1, 8);
    }
    PipeBarrier<PIPE_V>();
    auto maxima = maximumBuffer.Get<float>();
    WholeReduceMax(maxima, dots, static_cast<int32_t>(n), static_cast<int32_t>(m),
        1, 1, 1, ReduceOrder::ORDER_ONLY_VALUE);
    PipeBarrier<PIPE_V>();
    inputQueue.FreeTensor(input);
    auto result = outputQueue.AllocTensor<float>();
    WholeReduceSum(result, maxima, static_cast<int32_t>(m), 1, 1, 1, 1);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output, result, outputCopy);
    outputQueue.FreeTensor(result);
}

// 小批量短矩阵按batch分核；点积、行最大值和最终求和均在Vector流水中完成。
template <typename T, bool TRANS_A, bool TRANS_B, bool COMPACT_K>
__global__ __aicore__ void ComputeSmallBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t m, uint32_t n, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    SetAtomicNone();
    SetMaskNorm();
    ResetMask();
    constexpr uint32_t inputQueueOffset = 0;
    constexpr uint32_t outputQueueOffset = (inputQueueOffset + ((SMALL_BATCH_A_ELEMENTS + SMALL_BATCH_B_ELEMENTS) * sizeof(T)) + 31) / 32 * 32;
    constexpr uint32_t packedBufferOffset = (outputQueueOffset + (32) + 31) / 32 * 32;
    constexpr uint32_t offsetBufferOffset = (packedBufferOffset + ((SMALL_BATCH_A_ELEMENTS + SMALL_BATCH_B_ELEMENTS) * sizeof(T)) + 31) / 32 * 32;
    constexpr uint32_t convertedBufferOffset = (offsetBufferOffset + (2 * SMALL_VECTOR_K_LIMIT * sizeof(uint32_t)) + 31) / 32 * 32;
    constexpr uint32_t productBufferOffset = (convertedBufferOffset + ((SMALL_BATCH_A_ELEMENTS + SMALL_BATCH_B_ELEMENTS) * sizeof(float)) + 31) / 32 * 32;
    constexpr uint32_t dotBufferOffset = (productBufferOffset + (SMALL_BATCH_PRODUCT_ELEMENTS * sizeof(float)) + 31) / 32 * 32;
    constexpr uint32_t maximumBufferOffset = (dotBufferOffset + (SMALL_BATCH_M_LIMIT * SMALL_BATCH_N_LIMIT * sizeof(float)) + 31) / 32 * 32;

    const uint32_t batch = GetBlockIdx();
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1)
        + static_cast<uint64_t>(batch) * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2)
        + static_cast<uint64_t>(batch) * n * k);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    const uint32_t inputAElements = COMPACT_K && !TRANS_A && TRANS_B
        ? m * k : SMALL_BATCH_A_ELEMENTS;
    auto input = LocalTensor<T>(TPosition::VECCALC, inputQueueOffset, (SMALL_BATCH_A_ELEMENTS + SMALL_BATCH_B_ELEMENTS) * sizeof(T) / sizeof(T));
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    const uint32_t alignedK = (k + 15) / 16 * 16;
    const uint32_t gapBlocks = (SMALL_VECTOR_K_LIMIT - alignedK) / 16;
    if constexpr (!COMPACT_K && !TRANS_A) {
        // K40/56 的连续行距不是 32 字节倍数，搬运时放入 64 元素对齐槽。
        DataCopyExtParams alignedACopy{static_cast<uint16_t>(m),
            static_cast<uint32_t>(k * sizeof(T)), 0, gapBlocks, 0};
        DataCopyPad(input, a, alignedACopy, padding);
    } else {
        DataCopyPad(input, a, aCopy, padding);
    }
    if constexpr (!COMPACT_K && TRANS_B) {
        DataCopyExtParams alignedBCopy{static_cast<uint16_t>(n),
            static_cast<uint32_t>(k * sizeof(T)), 0, gapBlocks, 0};
        DataCopyPad(input[inputAElements], b, alignedBCopy, padding);
    } else {
        DataCopyPad(input[inputAElements], b, bCopy, padding);
    }
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    // 产品区与输入区独立，利用输入DMA等待窗口完成尾槽初始化。
    auto products = LocalTensor<float>(TPosition::VECCALC, productBufferOffset, (SMALL_BATCH_PRODUCT_ELEMENTS * sizeof(float)) / sizeof(float));
    const bool useBlockReduction = m * n >= 32;
    const uint32_t productStride = useBlockReduction ? 64 : (COMPACT_K ? k : SMALL_VECTOR_K_LIMIT);
    if (useBlockReduction && k < 64) {
        Duplicate(products, 0.0f, m * SMALL_BATCH_N_LIMIT * productStride);
        PipeBarrier<PIPE_V>();
    }
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

    auto rawA = input;
    auto rawB = input[inputAElements];
    auto packedA = LocalTensor<T>(TPosition::VECCALC, packedBufferOffset, ((SMALL_BATCH_A_ELEMENTS + SMALL_BATCH_B_ELEMENTS) * sizeof(T)) / sizeof(T));
    auto packedB = packedA[SMALL_BATCH_A_ELEMENTS];
    auto aOffsets = LocalTensor<int32_t>(TPosition::VECCALC, offsetBufferOffset, (2 * SMALL_VECTOR_K_LIMIT * sizeof(uint32_t)) / sizeof(int32_t));
    auto bOffsets = aOffsets[SMALL_VECTOR_K_LIMIT];
    const uint32_t vectorStride = COMPACT_K ? k : SMALL_VECTOR_K_LIMIT;
    if constexpr (TRANS_A) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t row = 0; row < m; ++row) {
            Gather(packedA[row * vectorStride], rawA, gatherOffsets,
                row * sizeof(T), k);
        }
    }
    if constexpr (!TRANS_B) {
        CreateVecIndex(bOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(bOffsets, bOffsets, static_cast<int32_t>(n * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = bOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t col = 0; col < n; ++col) {
            Gather(packedB[col * vectorStride], rawB, gatherOffsets,
                col * sizeof(T), k);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = LocalTensor<float>(TPosition::VECCALC, convertedBufferOffset, ((SMALL_BATCH_A_ELEMENTS + SMALL_BATCH_B_ELEMENTS) * sizeof(float)) / sizeof(float));
    auto bFloat = aFloat[inputAElements];
    if constexpr (COMPACT_K) {
        auto aSource = TRANS_A ? packedA : rawA;
        auto bSource = TRANS_B ? rawB : packedB;
        if constexpr (!TRANS_A && TRANS_B) {
            Cast(aFloat, input, RoundMode::CAST_NONE, (m + n) * k);
        } else {
            Cast(aFloat, aSource, RoundMode::CAST_NONE, m * k);
            Cast(bFloat, bSource, RoundMode::CAST_NONE, n * k);
        }
    } else {
        for (uint32_t row = 0; row < m; ++row) {
            auto source = TRANS_A ? packedA[row * SMALL_VECTOR_K_LIMIT] : rawA[row * SMALL_VECTOR_K_LIMIT];
            Cast(aFloat[row * SMALL_VECTOR_K_LIMIT], source, RoundMode::CAST_NONE, k);
        }
        for (uint32_t col = 0; col < n; ++col) {
            auto source = TRANS_B ? rawB[col * SMALL_VECTOR_K_LIMIT] : packedB[col * SMALL_VECTOR_K_LIMIT];
            Cast(bFloat[col * SMALL_VECTOR_K_LIMIT], source, RoundMode::CAST_NONE, k);
        }
    }
    PipeBarrier<PIPE_V>();

    const uint32_t vectorBlocks = vectorStride * sizeof(float) / 32;
    BinaryRepeatParams multiplyRepeats{1, 1, 1,
        static_cast<uint8_t>(productStride / 8), 0, static_cast<uint8_t>(vectorBlocks)};
    for (uint32_t row = 0; row < m; ++row) {
        Mul(products[row * SMALL_BATCH_N_LIMIT * productStride],
            aFloat[row * vectorStride], bFloat,
            static_cast<uint64_t>(k), static_cast<uint8_t>(n), multiplyRepeats);
    }
    PipeBarrier<PIPE_V>();

    auto dots = LocalTensor<float>(TPosition::VECCALC, dotBufferOffset, (SMALL_BATCH_M_LIMIT * SMALL_BATCH_N_LIMIT * sizeof(float)) / sizeof(float));
    if (useBlockReduction) {
        // 点积计算已完成，复用原输入转换区存储每点积8个块和。
        BlockReduceSum(aFloat, products,
            static_cast<int32_t>(m * SMALL_BATCH_N_LIMIT), 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        BlockReduceSum(dots, aFloat,
            static_cast<int32_t>(m * SMALL_BATCH_N_LIMIT / 8), 64, 1, 1, 8);
    } else {
        WholeReduceSum(dots, products, static_cast<int32_t>(k),
            static_cast<int32_t>(m * SMALL_BATCH_N_LIMIT), 1, 1,
            static_cast<int32_t>(vectorBlocks));
    }
    PipeBarrier<PIPE_V>();

    auto maxima = LocalTensor<float>(TPosition::VECCALC, maximumBufferOffset, (SMALL_BATCH_M_LIMIT * sizeof(float)) / sizeof(float));
    WholeReduceMax(maxima, dots, static_cast<int32_t>(n), static_cast<int32_t>(m),
        1, 1, SMALL_BATCH_N_LIMIT * sizeof(float) / 32,
        ReduceOrder::ORDER_ONLY_VALUE);
    PipeBarrier<PIPE_V>();

    auto result = LocalTensor<float>(TPosition::VECCALC, outputQueueOffset, 8);
    WholeReduceSum(result, maxima, static_cast<int32_t>(m), 1, 1, 1, 1);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output[batch], result, outputCopy);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
}

// 点4按batch和行块并行；按16列复用转换结果，K=128分两段累加。
// 各任务先写独立32字节GM槽，再由0号任务合并写回，避免并发写同一缓存行。
template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputeMediumBatchDots(GM_ADDR x1, GM_ADDR x2,
    GM_ADDR staging, GM_ADDR y, uint32_t batchCount, uint32_t m, uint32_t n, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIV_1_0);
    using namespace AscendC;
    if ASCEND_IS_AIV {
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> packedBuffer;
    TBuf<TPosition::VECCALC> offsetBuffer;
    TBuf<TPosition::VECCALC> convertedBuffer;
    TBuf<TPosition::VECCALC> productBuffer;
    TBuf<TPosition::VECCALC> dotBuffer;
    TBuf<TPosition::VECCALC> maximumBuffer;
    TBuf<TPosition::VECCALC> tileMaximumBuffer;
    pipe.InitBuffer(inputQueue, 1,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(packedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(offsetBuffer, 2 * MEDIUM_BATCH_K_LIMIT * sizeof(uint32_t));
    pipe.InitBuffer(convertedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(float));
    pipe.InitBuffer(productBuffer, MEDIUM_BATCH_PRODUCT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(dotBuffer, MEDIUM_BATCH_DOT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(maximumBuffer, MEDIUM_BATCH_M_LIMIT * sizeof(float));
    pipe.InitBuffer(tileMaximumBuffer, MEDIUM_BATCH_M_LIMIT * sizeof(float));

    const uint32_t rowTiles = (m + MEDIUM_BATCH_ROW_TILE - 1) / MEDIUM_BATCH_ROW_TILE;
    const uint32_t taskIndex = GetBlockIdx();
    const uint32_t batchIndex = taskIndex / rowTiles;
    const uint32_t rowTileIndex = taskIndex % rowTiles;
    const uint32_t rowStart = rowTileIndex * MEDIUM_BATCH_ROW_TILE;
    const uint32_t validRows = m - rowStart < MEDIUM_BATCH_ROW_TILE
        ? m - rowStart : MEDIUM_BATCH_ROW_TILE;
    const uint32_t taskCount = batchCount * rowTiles;
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> stagedOutput;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1)
        + static_cast<uint64_t>(batchIndex) * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2)
        + static_cast<uint64_t>(batchIndex) * n * k);
    stagedOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(staging));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    if constexpr (TRANS_A) {
        // 转置存储仍保留完整输入，供下面按原始行距Gather。
        DataCopyPad(input, a, aCopy, padding);
    } else {
        // 当前任务只需要连续的validRows行，避免每个行片重复搬入整个A。
        aCopy.blockLen = static_cast<uint32_t>(validRows * k * sizeof(T));
        DataCopyPad(input, a[rowStart * k], aCopy, padding);
    }
    DataCopyPad(input[MEDIUM_BATCH_A_ELEMENTS], b, bCopy, padding);
    inputQueue.EnQue(input);
    input = inputQueue.DeQue<T>();

    auto rawA = input;
    auto rawB = input[MEDIUM_BATCH_A_ELEMENTS];
    auto packedA = packedBuffer.Get<T>();
    auto packedB = packedA[MEDIUM_BATCH_ROW_TILE * MEDIUM_BATCH_K_LIMIT];
    auto aOffsets = offsetBuffer.Get<int32_t>();
    auto bOffsets = aOffsets[MEDIUM_BATCH_K_LIMIT];
    if constexpr (TRANS_A) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
            Gather(packedA[localRow * k], rawA, gatherOffsets,
                (rowStart + localRow) * sizeof(T), k);
        }
    }
    if constexpr (!TRANS_B) {
        CreateVecIndex(bOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(bOffsets, bOffsets, static_cast<int32_t>(n * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = bOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t col = 0; col < n; ++col) {
            Gather(packedB[col * k], rawB, gatherOffsets, col * sizeof(T), k);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[MEDIUM_BATCH_ROW_TILE * MEDIUM_BATCH_K_LIMIT];
    auto aSource = TRANS_A ? packedA : rawA;
    auto bSource = TRANS_B ? rawB : packedB;
    Cast(aFloat, aSource, RoundMode::CAST_NONE, validRows * k);
    Cast(bFloat, bSource, RoundMode::CAST_NONE, n * k);
    PipeBarrier<PIPE_V>();
    inputQueue.FreeTensor(input);

    auto products = productBuffer.Get<float>();
    auto dots = dotBuffer.Get<float>();
    auto maxima = maximumBuffer.Get<float>();
    auto tileMaxima = tileMaximumBuffer.Get<float>();
    BinaryRepeatParams multiplyRepeats{1, 1, 1, 8, 0,
        static_cast<uint8_t>(k * sizeof(float) / 32)};
    for (uint32_t colStart = 0; colStart < n; colStart += MEDIUM_BATCH_COL_TILE) {
        const uint32_t validCols = n - colStart < MEDIUM_BATCH_COL_TILE
            ? n - colStart : MEDIUM_BATCH_COL_TILE;
        for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
            auto destination = products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE];
            Mul(destination, aFloat[localRow * k], bFloat[colStart * k],
                static_cast<uint64_t>(MEDIUM_BATCH_K_TILE),
                static_cast<uint8_t>(validCols), multiplyRepeats);
        }
        PipeBarrier<PIPE_V>();
        if (k > MEDIUM_BATCH_K_TILE) {
            for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
                auto destination = products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE];
                MulAddDst(destination, aFloat[localRow * k + MEDIUM_BATCH_K_TILE],
                    bFloat[colStart * k + MEDIUM_BATCH_K_TILE],
                    static_cast<uint64_t>(MEDIUM_BATCH_K_TILE),
                    static_cast<uint8_t>(validCols), multiplyRepeats);
            }
            PipeBarrier<PIPE_V>();
        }
        if (validCols == MEDIUM_BATCH_COL_TILE) {
            WholeReduceSum(dots, products,
                static_cast<int32_t>(MEDIUM_BATCH_K_TILE),
                static_cast<int32_t>(validRows * MEDIUM_BATCH_COL_TILE), 1, 1, 8);
        } else {
            for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
                WholeReduceSum(dots[localRow * MEDIUM_BATCH_COL_TILE],
                    products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE],
                    static_cast<int32_t>(MEDIUM_BATCH_K_TILE),
                    static_cast<int32_t>(validCols), 1, 1, 8);
            }
        }
        PipeBarrier<PIPE_V>();
        WholeReduceMax(tileMaxima, dots, static_cast<int32_t>(validCols),
            static_cast<int32_t>(validRows), 1, 1,
            MEDIUM_BATCH_COL_TILE * sizeof(float) / 32,
            ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        if (colStart == 0) {
            Adds(maxima, tileMaxima, 0.0f, validRows);
        } else {
            Max(maxima, maxima, tileMaxima, validRows);
        }
        PipeBarrier<PIPE_V>();
    }

    auto result = outputQueue.AllocTensor<float>();
    Duplicate(result, 0.0f, MEDIUM_BATCH_OUTPUT_STRIDE);
    PipeBarrier<PIPE_V>();
    WholeReduceSum(result, maxima, static_cast<int32_t>(validRows), 1, 1, 1, 1);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopy(stagedOutput[taskIndex * MEDIUM_BATCH_OUTPUT_STRIDE], result,
        MEDIUM_BATCH_OUTPUT_STRIDE);
    outputQueue.FreeTensor(result);

    SyncAll<true>();
    if (taskIndex == 0) {
        auto stagedInput = inputQueue.AllocTensor<T>();
        auto stagedFloat = stagedInput.template ReinterpretCast<float>();
        DataCopy(stagedFloat, stagedOutput,
            taskCount * MEDIUM_BATCH_OUTPUT_STRIDE);
        inputQueue.EnQue(stagedInput);
        stagedInput = inputQueue.DeQue<T>();
        stagedFloat = stagedInput.template ReinterpretCast<float>();

        auto gatherOffsets = offsetBuffer.Get<int32_t>();
        CreateVecIndex(gatherOffsets, static_cast<int32_t>(0), rowTiles);
        PipeBarrier<PIPE_V>();
        Muls(gatherOffsets, gatherOffsets,
            static_cast<int32_t>(MEDIUM_BATCH_OUTPUT_STRIDE * sizeof(float)),
            rowTiles);
        PipeBarrier<PIPE_V>();

        auto merged = productBuffer.Get<float>();
        for (uint32_t batch = 0; batch < batchCount; ++batch) {
            Gather(merged[batch * MEDIUM_BATCH_OUTPUT_STRIDE],
                stagedFloat[batch * rowTiles * MEDIUM_BATCH_OUTPUT_STRIDE],
                gatherOffsets.ReinterpretCast<uint32_t>(), static_cast<uint32_t>(0), rowTiles);
        }
        PipeBarrier<PIPE_V>();
        inputQueue.FreeTensor(stagedInput);

        auto finalResults = outputQueue.AllocTensor<float>();
        WholeReduceSum(finalResults, merged, static_cast<int32_t>(rowTiles),
            static_cast<int32_t>(batchCount), 1, 1,
            MEDIUM_BATCH_OUTPUT_STRIDE * sizeof(float) / 32);
        outputQueue.EnQue(finalResults);
        finalResults = outputQueue.DeQue<float>();
        DataCopyExtParams outputCopy{1,
            static_cast<uint32_t>(batchCount * sizeof(float)), 0, 0, 0};
        DataCopyPad(output, finalResults, outputCopy);
        outputQueue.FreeTensor(finalResults);
    }
    }
}

// 点4/5探索：一个AIV完成一个batch，避免全核同步和二次搬运。
template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputeBatchDirectDotsFixed(GM_ADDR x1, GM_ADDR x2,
    GM_ADDR staging, GM_ADDR y, uint32_t batchCount, uint32_t runtimeM, uint32_t runtimeN, uint32_t runtimeK)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    constexpr uint32_t m = 16;
    constexpr uint32_t n = 16;
    constexpr uint32_t k = 128;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    pipe.InitBuffer(inputQueue, 1,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);

    constexpr uint32_t outputEnd = (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T) + 32;
    constexpr uint32_t packedBufferOffset = (outputEnd + 31) / 32 * 32;
    constexpr uint32_t offsetBufferOffset = (packedBufferOffset + ((MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T)) + 31) / 32 * 32;
    constexpr uint32_t convertedBufferOffset = (offsetBufferOffset + (2 * MEDIUM_BATCH_K_LIMIT * sizeof(uint32_t)) + 31) / 32 * 32;
    constexpr uint32_t productBufferOffset = (convertedBufferOffset + ((MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(float)) + 31) / 32 * 32;
    constexpr uint32_t dotBufferOffset = (productBufferOffset + (MEDIUM_BATCH_PRODUCT_ELEMENTS * sizeof(float)) + 31) / 32 * 32;
    constexpr uint32_t maximumBufferOffset = (dotBufferOffset + (MEDIUM_BATCH_DOT_ELEMENTS * sizeof(float)) + 31) / 32 * 32;
    constexpr uint32_t tileMaximumBufferOffset = (maximumBufferOffset + (MEDIUM_BATCH_M_LIMIT * sizeof(float)) + 31) / 32 * 32;

    const uint32_t batchIndex = GetBlockIdx();
    const uint32_t rowStart = 0;
    const uint32_t validRows = m;
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> stagedOutput;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1)
        + static_cast<uint64_t>(batchIndex) * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2)
        + static_cast<uint64_t>(batchIndex) * n * k);
    stagedOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(staging));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    if constexpr (TRANS_A) {
        // 转置存储仍保留完整输入，供下面按原始行距Gather。
        DataCopyPad(input, a, aCopy, padding);
    } else {
        // 当前任务只需要连续的validRows行，避免每个行片重复搬入整个A。
        aCopy.blockLen = static_cast<uint32_t>(validRows * k * sizeof(T));
        DataCopyPad(input, a[rowStart * k], aCopy, padding);
    }
    DataCopyPad(input[MEDIUM_BATCH_A_ELEMENTS], b, bCopy, padding);
    inputQueue.EnQue(input);

    auto rawA = input;
    auto rawB = input[MEDIUM_BATCH_A_ELEMENTS];
    auto packedA = LocalTensor<T>(TPosition::VECCALC, packedBufferOffset, ((MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T)) / sizeof(T));
    auto packedB = packedA[MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_K_LIMIT];
    auto aOffsets = LocalTensor<int32_t>(TPosition::VECCALC, offsetBufferOffset, (2 * MEDIUM_BATCH_K_LIMIT * sizeof(uint32_t)) / sizeof(int32_t));
    auto bOffsets = aOffsets[MEDIUM_BATCH_K_LIMIT];
    if constexpr (TRANS_A) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
    }
    input = inputQueue.DeQue<T>();
    if constexpr (TRANS_A) {
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        #pragma unroll
        for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
            Gather(packedA[localRow * k], rawA, gatherOffsets,
                (rowStart + localRow) * sizeof(T), k);
        }
    }
    if constexpr (!TRANS_B) {
        auto sourceBits = rawB.template ReinterpretCast<uint16_t>();
        auto destinationBits = packedB.template ReinterpretCast<uint16_t>();
        for (uint32_t colStart = 0; colStart < n; colStart += 16) {
            uint64_t sourceAddresses[16];
            uint64_t destinationAddresses[16];
            for (uint32_t lane = 0; lane < 16; ++lane) {
                sourceAddresses[lane] = sourceBits[lane * n + colStart].GetPhyAddr();
                destinationAddresses[lane] = destinationBits[(lane + colStart) * k].GetPhyAddr();
            }
            TransDataTo5HDParams transposeParams{false, false,
                static_cast<uint8_t>(k / 16), 1, static_cast<uint16_t>(n)};
            TransDataTo5HD<uint16_t>(destinationAddresses, sourceAddresses, transposeParams);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = LocalTensor<float>(TPosition::VECCALC, convertedBufferOffset, ((MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(float)) / sizeof(float));
    auto bFloat = aFloat[MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_K_LIMIT];
    auto aSource = TRANS_A ? packedA : rawA;
    auto bSource = TRANS_B ? rawB : packedB;
    Cast(aFloat, aSource, RoundMode::CAST_NONE, validRows * k);
    Cast(bFloat, bSource, RoundMode::CAST_NONE, n * k);
    PipeBarrier<PIPE_V>();
    inputQueue.FreeTensor(input);

    auto products = LocalTensor<float>(TPosition::VECCALC, productBufferOffset, (MEDIUM_BATCH_PRODUCT_ELEMENTS * sizeof(float)) / sizeof(float));
    auto dots = LocalTensor<float>(TPosition::VECCALC, dotBufferOffset, (MEDIUM_BATCH_DOT_ELEMENTS * sizeof(float)) / sizeof(float));
    auto maxima = LocalTensor<float>(TPosition::VECCALC, maximumBufferOffset, (MEDIUM_BATCH_M_LIMIT * sizeof(float)) / sizeof(float));
    auto tileMaxima = LocalTensor<float>(TPosition::VECCALC, tileMaximumBufferOffset, (MEDIUM_BATCH_M_LIMIT * sizeof(float)) / sizeof(float));
    BinaryRepeatParams multiplyRepeats{1, 1, 1, 8, 0,
        static_cast<uint8_t>(k * sizeof(float) / 32)};
    for (uint32_t colStart = 0; colStart < n; colStart += MEDIUM_BATCH_COL_TILE) {
        const uint32_t validCols = n - colStart < MEDIUM_BATCH_COL_TILE
            ? n - colStart : MEDIUM_BATCH_COL_TILE;
        #pragma unroll
        for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
            auto destination = products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE];
            Mul(destination, aFloat[localRow * k], bFloat[colStart * k],
                static_cast<uint64_t>(MEDIUM_BATCH_K_TILE),
                static_cast<uint8_t>(validCols), multiplyRepeats);
        }
        PipeBarrier<PIPE_V>();
        if (k > MEDIUM_BATCH_K_TILE) {
            #pragma unroll
        for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
                auto destination = products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE];
                MulAddDst(destination, aFloat[localRow * k + MEDIUM_BATCH_K_TILE],
                    bFloat[colStart * k + MEDIUM_BATCH_K_TILE],
                    static_cast<uint64_t>(MEDIUM_BATCH_K_TILE),
                    static_cast<uint8_t>(validCols), multiplyRepeats);
            }
            PipeBarrier<PIPE_V>();
        }
        if (validCols >= 8) {
            // 两个首级分块的写区独立，先全部生产块和，再统一消费。
            // 每次仍最多128个repeat，保留原repeat上限。
            auto blockSums = LocalTensor<float>(TPosition::VECCALC, packedBufferOffset, ((MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T)) / sizeof(float));
            for (uint32_t row = 0; row < validRows; row += 8) {
                const uint32_t rows = validRows - row < 8 ? validRows - row : 8;
                BlockReduceSum(blockSums[row * MEDIUM_BATCH_COL_TILE * 8],
                    products[row * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE],
                    static_cast<int32_t>(rows * MEDIUM_BATCH_COL_TILE),
                    static_cast<int32_t>(MEDIUM_BATCH_K_TILE), 1, 1, 8);
            }
            PipeBarrier<PIPE_V>();
            BlockReduceSum(dots, blockSums,
                static_cast<int32_t>(validRows * MEDIUM_BATCH_COL_TILE / 8),
                64, 1, 1, 8);
        } else {
            for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
                WholeReduceSum(dots[localRow * MEDIUM_BATCH_COL_TILE],
                    products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE],
                    static_cast<int32_t>(MEDIUM_BATCH_K_TILE),
                    static_cast<int32_t>(validCols), 1, 1, 8);
            }
        }
        PipeBarrier<PIPE_V>();
        auto currentMaxima = colStart == 0 ? maxima : tileMaxima;
        WholeReduceMax(currentMaxima, dots, static_cast<int32_t>(validCols),
            static_cast<int32_t>(validRows), 1, 1,
            MEDIUM_BATCH_COL_TILE * sizeof(float) / 32,
            ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        if (colStart != 0) {
            Max(maxima, maxima, tileMaxima, validRows);
            PipeBarrier<PIPE_V>();
        }
    }

    auto result = outputQueue.AllocTensor<float>();
    WholeReduceSum(result, maxima, static_cast<int32_t>(validRows), 1, 1, 1, 1);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output[batchIndex], result, outputCopy);
    outputQueue.FreeTensor(result);
}

template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputeBatchDirectDots(GM_ADDR x1, GM_ADDR x2,
    GM_ADDR staging, GM_ADDR y, uint32_t batchCount, uint32_t m, uint32_t n, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> packedBuffer;
    TBuf<TPosition::VECCALC> offsetBuffer;
    TBuf<TPosition::VECCALC> convertedBuffer;
    TBuf<TPosition::VECCALC> productBuffer;
    TBuf<TPosition::VECCALC> dotBuffer;
    TBuf<TPosition::VECCALC> maximumBuffer;
    TBuf<TPosition::VECCALC> tileMaximumBuffer;
    pipe.InitBuffer(inputQueue, 1,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(packedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(offsetBuffer, 2 * MEDIUM_BATCH_K_LIMIT * sizeof(uint32_t));
    pipe.InitBuffer(convertedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(float));
    pipe.InitBuffer(productBuffer, MEDIUM_BATCH_PRODUCT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(dotBuffer, MEDIUM_BATCH_DOT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(maximumBuffer, MEDIUM_BATCH_M_LIMIT * sizeof(float));
    pipe.InitBuffer(tileMaximumBuffer, MEDIUM_BATCH_M_LIMIT * sizeof(float));

    const uint32_t batchIndex = GetBlockIdx();
    const uint32_t rowStart = 0;
    const uint32_t validRows = m;
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> stagedOutput;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1)
        + static_cast<uint64_t>(batchIndex) * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2)
        + static_cast<uint64_t>(batchIndex) * n * k);
    stagedOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(staging));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    if constexpr (TRANS_A) {
        if (m < 16) {
            // 补齐输入短行，以保证16×16转置的源行首均32B对齐。
            DataCopyExtParams paddedACopy{static_cast<uint16_t>(k),
                static_cast<uint32_t>(m * sizeof(T)), 0, 0, 0};
            DataCopyPad(input, a, paddedACopy, padding);
        } else {
            DataCopyPad(input, a, aCopy, padding);
        }
    } else {
        // 当前任务只需要连续的validRows行，避免每个行片重复搬入整个A。
        aCopy.blockLen = static_cast<uint32_t>(validRows * k * sizeof(T));
        DataCopyPad(input, a[rowStart * k], aCopy, padding);
    }
    DataCopyPad(input[MEDIUM_BATCH_A_ELEMENTS], b, bCopy, padding);
    inputQueue.EnQue(input);
    input = inputQueue.DeQue<T>();

    auto rawA = input;
    auto rawB = input[MEDIUM_BATCH_A_ELEMENTS];
    auto packedA = packedBuffer.Get<T>();
    auto packedB = packedA[MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_K_LIMIT];
    auto aOffsets = offsetBuffer.Get<int32_t>();
    auto bOffsets = aOffsets[MEDIUM_BATCH_K_LIMIT];
    if constexpr (TRANS_A) {
        if (m < 16) {
            auto sourceBits = rawA.template ReinterpretCast<uint16_t>();
            auto destinationBits = packedA.template ReinterpretCast<uint16_t>();
            uint64_t sourceAddresses[16];
            uint64_t destinationAddresses[16];
            for (uint32_t lane = 0; lane < 16; ++lane) {
                sourceAddresses[lane] = sourceBits[lane * 16].GetPhyAddr();
                destinationAddresses[lane] = destinationBits[lane * k].GetPhyAddr();
            }
            TransDataTo5HDParams transposeParams{false, false,
                static_cast<uint8_t>(k / 16), 1, 16};
            TransDataTo5HD<uint16_t>(destinationAddresses, sourceAddresses, transposeParams);
        } else {
            CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
            PipeBarrier<PIPE_V>();
            Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
            PipeBarrier<PIPE_V>();
            auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
            for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
                Gather(packedA[localRow * k], rawA, gatherOffsets,
                    (rowStart + localRow) * sizeof(T), k);
            }
        }
    }
    if constexpr (!TRANS_B) {
        auto sourceBits = rawB.template ReinterpretCast<uint16_t>();
        auto destinationBits = packedB.template ReinterpretCast<uint16_t>();
        for (uint32_t colStart = 0; colStart < n; colStart += 16) {
            uint64_t sourceAddresses[16];
            uint64_t destinationAddresses[16];
            for (uint32_t lane = 0; lane < 16; ++lane) {
                sourceAddresses[lane] = sourceBits[lane * n + colStart].GetPhyAddr();
                destinationAddresses[lane] = destinationBits[(lane + colStart) * k].GetPhyAddr();
            }
            TransDataTo5HDParams transposeParams{false, false,
                static_cast<uint8_t>(k / 16), 1, static_cast<uint16_t>(n)};
            TransDataTo5HD<uint16_t>(destinationAddresses, sourceAddresses, transposeParams);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_K_LIMIT];
    auto aSource = TRANS_A ? packedA : rawA;
    auto bSource = TRANS_B ? rawB : packedB;
    Cast(aFloat, aSource, RoundMode::CAST_NONE, validRows * k);
    Cast(bFloat, bSource, RoundMode::CAST_NONE, n * k);
    PipeBarrier<PIPE_V>();
    inputQueue.FreeTensor(input);

    auto products = productBuffer.Get<float>();
    auto dots = dotBuffer.Get<float>();
    auto maxima = maximumBuffer.Get<float>();
    auto tileMaxima = tileMaximumBuffer.Get<float>();
    BinaryRepeatParams multiplyRepeats{1, 1, 1, 8, 0,
        static_cast<uint8_t>(k * sizeof(float) / 32)};
    for (uint32_t colStart = 0; colStart < n; colStart += MEDIUM_BATCH_COL_TILE) {
        const uint32_t validCols = n - colStart < MEDIUM_BATCH_COL_TILE
            ? n - colStart : MEDIUM_BATCH_COL_TILE;
        for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
            auto destination = products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE];
            Mul(destination, aFloat[localRow * k], bFloat[colStart * k],
                static_cast<uint64_t>(MEDIUM_BATCH_K_TILE),
                static_cast<uint8_t>(validCols), multiplyRepeats);
        }
        PipeBarrier<PIPE_V>();
        if (k > MEDIUM_BATCH_K_TILE) {
            for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
                auto destination = products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE];
                MulAddDst(destination, aFloat[localRow * k + MEDIUM_BATCH_K_TILE],
                    bFloat[colStart * k + MEDIUM_BATCH_K_TILE],
                    static_cast<uint64_t>(MEDIUM_BATCH_K_TILE),
                    static_cast<uint8_t>(validCols), multiplyRepeats);
            }
            PipeBarrier<PIPE_V>();
        }
        if (validCols >= 8) {
            // 每次至多128个repeat，避免16行完整块产生256次repeat溢出。
            for (uint32_t row = 0; row < validRows; row += 8) {
                const uint32_t rows = validRows - row < 8 ? validRows - row : 8;
                // Cast已完成，可复用packed区存放每个点积的8个块和。
                auto blockSums = packedBuffer.Get<float>();
                BlockReduceSum(blockSums[row * MEDIUM_BATCH_COL_TILE * 8],
                    products[row * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE],
                    static_cast<int32_t>(rows * MEDIUM_BATCH_COL_TILE),
                    static_cast<int32_t>(MEDIUM_BATCH_K_TILE), 1, 1, 8);
                PipeBarrier<PIPE_V>();
                BlockReduceSum(dots[row * MEDIUM_BATCH_COL_TILE],
                    blockSums[row * MEDIUM_BATCH_COL_TILE * 8],
                    static_cast<int32_t>(rows * MEDIUM_BATCH_COL_TILE / 8),
                    64, 1, 1, 8);
            }
        } else {
            for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
                WholeReduceSum(dots[localRow * MEDIUM_BATCH_COL_TILE],
                    products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE],
                    static_cast<int32_t>(MEDIUM_BATCH_K_TILE),
                    static_cast<int32_t>(validCols), 1, 1, 8);
            }
        }
        PipeBarrier<PIPE_V>();
        auto currentMaxima = colStart == 0 ? maxima : tileMaxima;
        WholeReduceMax(currentMaxima, dots, static_cast<int32_t>(validCols),
            static_cast<int32_t>(validRows), 1, 1,
            MEDIUM_BATCH_COL_TILE * sizeof(float) / 32,
            ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        if (colStart != 0) {
            Max(maxima, maxima, tileMaxima, validRows);
            PipeBarrier<PIPE_V>();
        }
    }

    auto result = outputQueue.AllocTensor<float>();
    WholeReduceSum(result, maxima, static_cast<int32_t>(validRows), 1, 1, 1, 1);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output[batchIndex], result, outputCopy);
    outputQueue.FreeTensor(result);
}

// 紧凑批量按batch、行块和列块分核，让全部AIV并行计算后在核内合并行最大值。
template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputeLargeBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR staging,
    GM_ADDR y, uint32_t batchCount, uint32_t m, uint32_t n, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> packedBuffer;
    TBuf<TPosition::VECCALC> offsetBuffer;
    TBuf<TPosition::VECCALC> convertedBuffer;
    TBuf<TPosition::VECCALC> productBuffer;
    TBuf<TPosition::VECCALC> dotBuffer;
    TBuf<TPosition::VECCALC> maximumBuffer;
    pipe.InitBuffer(inputQueue, 1,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(packedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(offsetBuffer, 2 * MEDIUM_BATCH_K_LIMIT * sizeof(uint32_t));
    pipe.InitBuffer(convertedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(float));
    pipe.InitBuffer(productBuffer, LARGE_BATCH_PRODUCT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(dotBuffer, LARGE_BATCH_DOT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(maximumBuffer, LARGE_BATCH_M_TILE * sizeof(float));

    const uint32_t rowTiles = (m + LARGE_BATCH_M_TILE - 1) / LARGE_BATCH_M_TILE;
    const uint32_t colTiles = (n + LARGE_BATCH_COL_TILE - 1) / LARGE_BATCH_COL_TILE;
    const uint32_t tasksPerBatch = rowTiles * colTiles;
    const uint32_t taskIndex = GetBlockIdx();
    const uint32_t batch = taskIndex / tasksPerBatch;
    const uint32_t localTask = taskIndex % tasksPerBatch;
    const uint32_t rowTile = localTask / colTiles;
    const uint32_t colTile = localTask % colTiles;
    const uint32_t rowStart = rowTile * LARGE_BATCH_M_TILE;
    const uint32_t colStart = colTile * LARGE_BATCH_COL_TILE;
    const uint32_t validRows = m - rowStart < LARGE_BATCH_M_TILE
        ? m - rowStart : LARGE_BATCH_M_TILE;
    const uint32_t validCols = n - colStart < LARGE_BATCH_COL_TILE
        ? n - colStart : LARGE_BATCH_COL_TILE;
    const uint32_t taskCount = batchCount * tasksPerBatch;
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> stagedOutput;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1)
        + static_cast<uint64_t>(batch) * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2)
        + static_cast<uint64_t>(batch) * n * k);
    stagedOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(staging));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    if constexpr (TRANS_A) {
        // 转置存储保留完整A，供下面按原始行距Gather。
        DataCopyPad(input, a, aCopy, padding);
    } else {
        // 每个行列任务仅搬入所负责的连续A行片，列分片方式保持不变。
        aCopy.blockLen = static_cast<uint32_t>(validRows * k * sizeof(T));
        DataCopyPad(input, a[rowStart * k], aCopy, padding);
    }
    DataCopyPad(input[MEDIUM_BATCH_A_ELEMENTS], b, bCopy, padding);
    inputQueue.EnQue(input);
    input = inputQueue.DeQue<T>();

    auto rawA = input;
    auto rawB = input[MEDIUM_BATCH_A_ELEMENTS];
    auto packedA = packedBuffer.Get<T>();
    auto packedB = packedA[MEDIUM_BATCH_A_ELEMENTS];
    auto aOffsets = offsetBuffer.Get<int32_t>();
    auto bOffsets = aOffsets[MEDIUM_BATCH_K_LIMIT];
    if constexpr (TRANS_A) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t row = 0; row < validRows; ++row) {
            Gather(packedA[row * k], rawA, gatherOffsets,
                (rowStart + row) * sizeof(T), k);
        }
    }
    if constexpr (!TRANS_B) {
        if ((n & 15u) == 0 && validCols == LARGE_BATCH_COL_TILE) {
            // 原始 B 行距和列块起点均为 16 元素的倍数，可直接做 16 位硬件转置。
            auto sourceBits = rawB.template ReinterpretCast<uint16_t>();
            auto destinationBits = packedB.template ReinterpretCast<uint16_t>();
            uint64_t sourceAddresses[16];
            uint64_t destinationAddresses[16];
            for (uint32_t lane = 0; lane < 16; ++lane) {
                sourceAddresses[lane] = sourceBits[lane * n + colStart].GetPhyAddr();
                destinationAddresses[lane] = destinationBits[lane * k].GetPhyAddr();
            }
            TransDataTo5HDParams transposeParams{false, false,
                static_cast<uint8_t>(k / 16), 1, static_cast<uint16_t>(n)};
            TransDataTo5HD<uint16_t>(destinationAddresses, sourceAddresses, transposeParams);
        } else {
            CreateVecIndex(bOffsets, static_cast<int32_t>(0), k);
            PipeBarrier<PIPE_V>();
            Muls(bOffsets, bOffsets, static_cast<int32_t>(n * sizeof(T)), k);
            PipeBarrier<PIPE_V>();
            auto gatherOffsets = bOffsets.ReinterpretCast<uint32_t>();
            for (uint32_t col = 0; col < validCols; ++col) {
                Gather(packedB[col * k], rawB, gatherOffsets,
                    (colStart + col) * sizeof(T), k);
            }
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[MEDIUM_BATCH_A_ELEMENTS];
    auto aSource = TRANS_A ? packedA : rawA;
    auto bSource = TRANS_B ? rawB[colStart * k] : packedB;
    Cast(aFloat, aSource, RoundMode::CAST_NONE, validRows * k);
    Cast(bFloat, bSource, RoundMode::CAST_NONE, validCols * k);
    PipeBarrier<PIPE_V>();
    inputQueue.FreeTensor(input);

    auto products = productBuffer.Get<float>();
    auto dots = dotBuffer.Get<float>();
    auto maxima = maximumBuffer.Get<float>();
    BinaryRepeatParams multiplyRepeats{1, 1, 1, 8, 0,
        static_cast<uint8_t>(k * sizeof(float) / 32)};

    for (uint32_t row = 0; row < validRows; ++row) {
        auto destination = products[row * LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE];
        Mul(destination, aFloat[row * k], bFloat,
            static_cast<uint64_t>(LARGE_BATCH_K_TILE),
            static_cast<uint8_t>(validCols), multiplyRepeats);
    }
    PipeBarrier<PIPE_V>();
    if (k > LARGE_BATCH_K_TILE) {
        for (uint32_t row = 0; row < validRows; ++row) {
            auto destination = products[row * LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE];
            MulAddDst(destination, aFloat[row * k + LARGE_BATCH_K_TILE],
                bFloat[LARGE_BATCH_K_TILE], static_cast<uint64_t>(LARGE_BATCH_K_TILE),
                static_cast<uint8_t>(validCols), multiplyRepeats);
        }
        PipeBarrier<PIPE_V>();
    }
    if (validCols == LARGE_BATCH_COL_TILE) {
        // 完整列块的点积向量连续排列，至多8*16=128个repeat，可一次归约。
        WholeReduceSum(dots, products, static_cast<int32_t>(LARGE_BATCH_K_TILE),
            static_cast<int32_t>(validRows * LARGE_BATCH_COL_TILE), 1, 1, 8);
    } else {
        // 尾列之间仍有未初始化间隔，逐行归约只读取有效乘积。
        for (uint32_t row = 0; row < validRows; ++row) {
            WholeReduceSum(dots[row * LARGE_BATCH_COL_TILE],
                products[row * LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE],
                static_cast<int32_t>(LARGE_BATCH_K_TILE),
                static_cast<int32_t>(validCols), 1, 1, 8);
        }
    }
    PipeBarrier<PIPE_V>();
    WholeReduceMax(maxima, dots, static_cast<int32_t>(validCols),
        static_cast<int32_t>(validRows), 1, 1,
        LARGE_BATCH_COL_TILE * sizeof(float) / 32,
        ReduceOrder::ORDER_ONLY_VALUE);
    PipeBarrier<PIPE_V>();

    auto result = outputQueue.AllocTensor<float>();
    Duplicate(result, 0.0f, LARGE_BATCH_M_TILE);
    PipeBarrier<PIPE_V>();
    Adds(result, maxima, 0.0f, validRows);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopy(stagedOutput[taskIndex * LARGE_BATCH_M_TILE], result, LARGE_BATCH_M_TILE);
    outputQueue.FreeTensor(result);

    SyncAll<true>();
    if (taskIndex == 0) {
        auto stagedInput = inputQueue.AllocTensor<T>();
        auto stagedFloat = stagedInput.template ReinterpretCast<float>();
        DataCopy(stagedFloat, stagedOutput, taskCount * LARGE_BATCH_M_TILE);
        inputQueue.EnQue(stagedInput);
        stagedInput = inputQueue.DeQue<T>();
        stagedFloat = stagedInput.template ReinterpretCast<float>();

        auto merged = productBuffer.Get<float>();
        const uint32_t rowGroups = batchCount * rowTiles;
        if (colTiles == 1) {
            Adds(merged, stagedFloat, 0.0f, rowGroups * LARGE_BATCH_M_TILE);
        } else {
            // 此路径N至多32，恰好两个16列分片；每个repeat合并一个8行块。
            // 输入跨两个32字节块，输出连续，最多16个repeat，源和目的不重叠。
            BinaryRepeatParams mergeRepeats{1, 1, 1, 1, 2, 2};
            Max(merged, stagedFloat, stagedFloat[LARGE_BATCH_M_TILE],
                static_cast<uint64_t>(LARGE_BATCH_M_TILE),
                static_cast<uint8_t>(rowGroups), mergeRepeats);
        }
        PipeBarrier<PIPE_V>();
        inputQueue.FreeTensor(stagedInput);

        auto finalResults = outputQueue.AllocTensor<float>();
        // 每个batch连续存放一至两个8行块；尾行已补零，批量Sum仍保持先Max后Sum。
        WholeReduceSum(finalResults, merged,
            static_cast<int32_t>(rowTiles * LARGE_BATCH_M_TILE),
            static_cast<int32_t>(batchCount), 1, 1, static_cast<int32_t>(rowTiles));
        outputQueue.EnQue(finalResults);
        finalResults = outputQueue.DeQue<float>();
        DataCopyExtParams outputCopy{1,
            static_cast<uint32_t>(batchCount * sizeof(float)), 0, 0, 0};
        DataCopyPad(output, finalResults, outputCopy);
        outputQueue.FreeTensor(finalResults);
    }
}

__aicore__ inline void Finish(AscendC::TPipe& pipe, GM_ADDR partial, GM_ADDR y,
    uint32_t rowTiles, uint32_t batch)
{
    using namespace AscendC;
    if (batch > 1 && rowTiles <= 4) {
        // 每个batch至多64个float（有效局部和与零填充），一次搬入所有batch。
        // 每个repeat独立归约一个batch，输出连续，避免逐批Scalar取值和同步。
        const uint32_t count = rowTiles * PARTIAL_STRIDE;
        TQue<TPosition::VECIN, 1> batchInputQueue;
        TQue<TPosition::VECOUT, 1> batchOutputQueue;
        pipe.InitBuffer(batchInputQueue, 1, batch * count * sizeof(float));
        pipe.InitBuffer(batchOutputQueue, 1, 64 * sizeof(float));
        GlobalTensor<float> batchInput;
        GlobalTensor<float> batchOutput;
        batchInput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
        batchOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
        auto local = batchInputQueue.AllocTensor<float>();
        DataCopy(local, batchInput, batch * count);
        batchInputQueue.EnQue(local);
        local = batchInputQueue.DeQue<float>();
        auto result = batchOutputQueue.AllocTensor<float>();
        WholeReduceSum(result, local, static_cast<int32_t>(count),
            static_cast<int32_t>(batch), 1, 1, static_cast<int32_t>(count / 8));
        batchOutputQueue.EnQue(result);
        result = batchOutputQueue.DeQue<float>();
        DataCopyExtParams copy{1, static_cast<uint32_t>(batch * sizeof(float)), 0, 0, 0};
        DataCopyPad(batchOutput, result, copy);
        batchOutputQueue.FreeTensor(result);
        batchInputQueue.FreeTensor(local);
        return;
    }
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> tempBuffer;
    TBuf<TPosition::VECCALC> reduceBuffer;
    const uint32_t count = rowTiles * PARTIAL_STRIDE;
    pipe.InitBuffer(inputQueue, 1, count * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, 64 * sizeof(float));
    pipe.InitBuffer(tempBuffer, count * sizeof(float));
    pipe.InitBuffer(reduceBuffer, 32);
    GlobalTensor<float> input;
    GlobalTensor<float> output;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    auto result = outputQueue.AllocTensor<float>();
    auto reduced = reduceBuffer.Get<float>();
    for (uint32_t b = 0; b < batch; ++b) {
        auto local = inputQueue.AllocTensor<float>();
        DataCopy(local, input[b * count], count);
        inputQueue.EnQue(local);
        local = inputQueue.DeQue<float>();
        ReduceSum(reduced, local, tempBuffer.Get<float>(), count);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        result.SetValue(b, reduced.GetValue(0));
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        inputQueue.FreeTensor(local);
    }
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    // 单核连续写 B 个 float，既不越界，也不产生跨核缓存行共享写。
    DataCopyExtParams copy{1, static_cast<uint32_t>(batch * sizeof(float)), 0, 0, 0};
    DataCopyPad(output, result, copy);
    outputQueue.FreeTensor(result);
}


// N 分片不能先对行求和：先合并同一行的各片局部最大值，再沿 M 求和。
template <uint32_t TILE_ROWS>
__aicore__ inline void FinishSplitN(AscendC::TPipe& pipe, GM_ADDR partial, GM_ADDR y,
    const Parameters& params)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> maximaBuffer;
    TBuf<TPosition::VECCALC> sumsBuffer;
    TBuf<TPosition::VECCALC> tempBuffer;
    TBuf<TPosition::VECCALC> reduceBuffer;
    const uint32_t count = params.rowTiles * PARTIAL_STRIDE;
    // 分片分支的全部任务恰好各占一核，可由核数还原片数，无须扩展核参数布局。
    const uint32_t parts = params.cores / (params.batch * params.rowTiles);
    pipe.InitBuffer(inputQueue, 1, parts * TILE_ROWS * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, 64 * sizeof(float));
    pipe.InitBuffer(maximaBuffer, TILE_ROWS * sizeof(float));
    pipe.InitBuffer(sumsBuffer, count * sizeof(float));
    const uint32_t tempCount = TILE_ROWS > 64 && count < TILE_ROWS ? TILE_ROWS : count;
    pipe.InitBuffer(tempBuffer, tempCount * sizeof(float));
    pipe.InitBuffer(reduceBuffer, 32);
    GlobalTensor<float> input;
    GlobalTensor<float> output;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    auto result = outputQueue.AllocTensor<float>();
    auto maxima = maximaBuffer.Get<float>();
    auto sums = sumsBuffer.Get<float>();
    auto reduced = reduceBuffer.Get<float>();
    for (uint32_t b = 0; b < params.batch; ++b) {
        Duplicate(sums, 0.0f, count);
        PipeBarrier<PIPE_V>();
        for (uint32_t rowTile = 0; rowTile < params.rowTiles; ++rowTile) {
            const uint32_t rowStart = rowTile * TILE_ROWS;
            const uint32_t validRows = params.m - rowStart < TILE_ROWS ? params.m - rowStart : TILE_ROWS;
            const uint32_t offset = (b * params.rowTiles + rowTile) * parts * TILE_ROWS;
            auto local = inputQueue.AllocTensor<float>();
            DataCopy(local, input[offset], parts * TILE_ROWS);
            inputQueue.EnQue(local);
            local = inputQueue.DeQue<float>();
            Max(maxima, local, local[TILE_ROWS], validRows);
            for (uint32_t part = 2; part < parts; ++part) {
                PipeBarrier<PIPE_V>();
                Max(maxima, maxima, local[part * TILE_ROWS], validRows);
            }
            PipeBarrier<PIPE_V>();
            if constexpr (TILE_ROWS > 64) {
                // 128行N分片归约必须使用多段Sum，单条WholeReduceSum至多64个float。
                ReduceSum(sums[rowTile * PARTIAL_STRIDE], maxima,
                    tempBuffer.Get<float>(), validRows);
            } else {
                WholeReduceSum(sums[rowTile * PARTIAL_STRIDE], maxima,
                    static_cast<int32_t>(validRows), 1, 1, 1, 1);
            }
            PipeBarrier<PIPE_V>();
            inputQueue.FreeTensor(local);
        }
        ReduceSum(reduced, sums, tempBuffer.Get<float>(), count);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        result.SetValue(b, reduced.GetValue(0));
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
    }
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams copy{1, static_cast<uint32_t>(params.batch * sizeof(float)), 0, 0, 0};
    DataCopyPad(output, result, copy);
    outputQueue.FreeTensor(result);
}



// 异步模式显式请求完成通知，读回对应结果块前必须 WaitIterateAll。
template <uint32_t TILE_COLS, bool TRANS_A, bool TRANS_B, bool ASYNC, typename MM, typename T>
__aicore__ inline void StartColumn(MM& mm, const AscendC::GlobalTensor<T>& a,
    const AscendC::GlobalTensor<T>& b, const AscendC::GlobalTensor<float>& destination,
    const Parameters& params, uint64_t aOffset, uint64_t bOffset,
    uint32_t validRows, uint32_t colStart)
{
    const uint32_t validCols = params.n - colStart < TILE_COLS ? params.n - colStart : TILE_COLS;
    const uint64_t tileBOffset = bOffset
        + (TRANS_B ? static_cast<uint64_t>(colStart) * params.k : colStart);
    mm.SetTail(validRows, validCols, params.k);
    mm.SetTensorA(a[aOffset], TRANS_A);
    mm.SetTensorB(b[tileBOffset], TRANS_B);
    mm.template IterateAll<!ASYNC>(destination, 0, false, ASYNC);
}

// 大矩阵、512×64高窄块和64×256矮宽块使用MDL，保持UnitFlag。
// 其他块形状保持原执行模板。
template <uint32_t TILE_ROWS, uint32_t TILE_COLS>
constexpr MatmulConfig MakeComputeConfig()
{
    constexpr bool largeTile = (TILE_ROWS == 208 && TILE_COLS == 128) || ((TILE_ROWS == 128 || TILE_ROWS == 112) && TILE_COLS == 256)
        || (TILE_ROWS == 256 && TILE_COLS == 128);
    constexpr bool tallTile = (TILE_ROWS == 512 || TILE_ROWS == 416) && TILE_COLS == 64;
    constexpr bool wideTile = TILE_ROWS == 64 && TILE_COLS == 256;
    MatmulConfig config = TILE_COLS == 512 || largeTile || tallTile || wideTile
        ? CFG_MDL : CFG_NORM;
    if (largeTile || tallTile || wideTile) {
        // 高窄和矮宽块原NORM模板已开启UnitFlag，切换MDL时保持这一配置。
        config.enUnitFlag = true;
    }
    if constexpr ((TILE_ROWS == DEFAULT_ROWS && TILE_COLS == DEFAULT_COLS)
        || wideTile || tallTile || largeTile) {
        // 默认块、矮宽块、高窄块与大矩阵块使用官方双主模式，减少KFC消息发射。
        config.enableMixDualMaster = true;
    }
    return config;
}

template <uint32_t TILE_ROWS, uint32_t TILE_COLS>
constexpr MatmulConfig COMPUTE_CONFIG = MakeComputeConfig<TILE_ROWS, TILE_COLS>();

// 仅固定默认块和大矩阵块的base形状；singleCore和K步长仍由运行时tiling提供。
// 常量与Host实际参数匹配时才分发至此模板，其他场景保留动态版本。
template <typename T, bool TRANS_A, bool TRANS_B,
    uint32_t TILE_ROWS, uint32_t TILE_COLS, bool STATIC_BASE>
__aicore__ constexpr auto MakeKernelMatmulConfig()
{
    if constexpr (STATIC_BASE) {
        constexpr bool largeTile = (TILE_ROWS == 208 && TILE_COLS == 128) || (TILE_ROWS == 112 && TILE_COLS == 256) || ((TILE_ROWS == 128 || TILE_ROWS == 64) && TILE_COLS == 256)
            || (TILE_ROWS == 256 && TILE_COLS == 128);
        static_assert((TILE_ROWS == DEFAULT_ROWS && TILE_COLS == DEFAULT_COLS) || largeTile,
            "Static base tiling is restricted to default and large tiles");
        MatmulConfig config = COMPUTE_CONFIG<TILE_ROWS, TILE_COLS>;
        config.basicM = TILE_ROWS;
        config.basicN = TILE_COLS;
        config.basicK = largeTile ? 64 : 128;
        config.enableSetBias = false;
        using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TRANS_A>;
        using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TRANS_B>;
        using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
        auto constant = AscendC::GetMatmulApiTiling<AType, BType, CType, CType>(config);
        // 探索分支只固定已确认的点9/10/11/12，点8继续保留物理跨度实验能力。
        if constexpr (TILE_ROWS == 128 && TILE_COLS == 256 && !(TRANS_A && TRANS_B)) {
            constant.M = TRANS_A ? 1280 : (TRANS_B ? 2048 : 4096);
            constant.N = TRANS_A ? 4096 : (TRANS_B ? 1536 : 1280);
            constant.Ka = TRANS_A ? 1536 : (TRANS_B ? 1280 : 1152);
            constant.Kb = constant.Ka;
            constant.singleCoreM = 128;
            constant.singleCoreK = constant.Ka;
        } else if constexpr (TILE_ROWS == 64 && TILE_COLS == 256 && TRANS_A && !TRANS_B) {
            constant.M = 1280;
            constant.N = 4096;
            constant.Ka = 1536;
            constant.Kb = 1536;
            constant.singleCoreM = 64;
            constant.singleCoreK = 1536;
        } else if constexpr (TILE_ROWS == 112 && TILE_COLS == 256 && !TRANS_A && TRANS_B) {
            constant.M = 2048;
            constant.N = 1536;
            constant.Ka = 1280;
            constant.Kb = 1280;
            constant.singleCoreM = 112;
            constant.singleCoreK = 1280;
        } else if constexpr (TILE_ROWS == 208 && TILE_COLS == 128 && !TRANS_A && !TRANS_B) {
            constant.M = 4096;
            constant.N = 1280;
            constant.Ka = 1152;
            constant.Kb = 1152;
            constant.singleCoreM = 208;
            constant.singleCoreK = 1152;
        } else if constexpr (TILE_ROWS == 256 && TILE_COLS == 128) {
            constant.M = 1536;
            constant.N = 2048;
            constant.Ka = 2048;
            constant.Kb = 2048;
            constant.singleCoreM = 256;
            constant.singleCoreK = 2048;
        }
        return constant;
    } else {
        return COMPUTE_CONFIG<TILE_ROWS, TILE_COLS>;
    }
}

template <typename T, bool TRANS_A, bool TRANS_B,
    uint32_t TILE_ROWS, uint32_t TILE_COLS, bool STATIC_BASE>
constexpr auto KERNEL_MATMUL_CONFIG =
    MakeKernelMatmulConfig<T, TRANS_A, TRANS_B, TILE_ROWS, TILE_COLS, STATIC_BASE>();

// 点14：保持16核×512列，每核两次64×256×128基础Cube；单kernel确定性Max/Sum。
__global__ __aicore__ void ComputePoint14ManualCube(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR partial, GM_ADDR y, Parameters params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    constexpr uint32_t M = 64, COLS = 512, TILE_N = 256, K = 128;
    const uint32_t task = GetBlockIdx();
    TPipe pipe;
    GlobalTensor<float> matrix;
    // host为分N路径分配双槽，每核保持相同地址步长。
    matrix.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + task * 2 * M * COLS);
    if ASCEND_IS_AIC {
        TQue<TPosition::A1, 1> a1Queue;
        TQue<TPosition::B1, 1> b1Queue;
        TQue<TPosition::A2, 1> a2Queue;
        TQue<TPosition::B2, 1> b2Queue;
        TQue<TPosition::CO1, 1> c1Queue;
        pipe.InitBuffer(a1Queue, 1, M * K * sizeof(bfloat16_t));
        pipe.InitBuffer(b1Queue, 1, TILE_N * K * sizeof(bfloat16_t));
        pipe.InitBuffer(a2Queue, 1, M * K * sizeof(bfloat16_t));
        pipe.InitBuffer(b2Queue, 1, TILE_N * K * sizeof(bfloat16_t));
        pipe.InitBuffer(c1Queue, 1, M * TILE_N * sizeof(float));
        GlobalTensor<bfloat16_t> a, b;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x1));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x2) + task * COLS * K);
        auto a1 = a1Queue.AllocTensor<bfloat16_t>();
        Nd2NzParams copyA{};
        copyA.ndNum = 1;
        copyA.nValue = M;
        copyA.dValue = K;
        copyA.srcDValue = K;
        copyA.dstNzC0Stride = M;
        copyA.dstNzNStride = 1;
        DataCopy(a1, a, copyA);
        a1Queue.EnQue(a1);
        a1 = a1Queue.DeQue<bfloat16_t>();
        auto a2 = a2Queue.AllocTensor<bfloat16_t>();
        LoadData2DParams loadA{};
        loadA.repeatTimes = K / 16;
        loadA.srcStride = M / 16;
        loadA.ifTranspose = false;
        for (uint32_t rowBlock = 0; rowBlock < M / 16; ++rowBlock) {
            LoadData(a2[rowBlock * K * 16], a1[rowBlock * 256], loadA);
        }
        a2Queue.EnQue(a2);
        a1Queue.FreeTensor(a1);
        a2 = a2Queue.DeQue<bfloat16_t>();
        for (uint32_t col = 0; col < COLS; col += TILE_N) {
            auto b1 = b1Queue.AllocTensor<bfloat16_t>();
            Nd2NzParams copyB{};
            copyB.ndNum = 1;
            copyB.nValue = TILE_N;
            copyB.dValue = K;
            copyB.srcDValue = K;
            copyB.dstNzC0Stride = TILE_N;
            copyB.dstNzNStride = 1;
            DataCopy(b1, b[col * K], copyB);
            b1Queue.EnQue(b1);
            b1 = b1Queue.DeQue<bfloat16_t>();
            auto b2 = b2Queue.AllocTensor<bfloat16_t>();
            LoadData2DParams loadB{};
            loadB.repeatTimes = (K / 16) * (TILE_N / 16);
            loadB.srcStride = 1;
            loadB.ifTranspose = false;
            LoadData(b2, b1, loadB);
            b2Queue.EnQue(b2);
            b1Queue.FreeTensor(b1);
            b2 = b2Queue.DeQue<bfloat16_t>();
            auto c1 = c1Queue.AllocTensor<float>();
            MmadParams multiply{};
            multiply.m = M;
            multiply.n = TILE_N;
            multiply.k = K;
            multiply.cmatrixInitVal = true;
            Mmad(c1, a2, b2, multiply);
            b2Queue.FreeTensor(b2);
            c1Queue.EnQue(c1);
            c1 = c1Queue.DeQue<float>();
            FixpipeParamsV220 copyC{};
            copyC.nSize = TILE_N;
            copyC.mSize = M;
            copyC.srcStride = M;
            copyC.dstStride = COLS;
            copyC.ndNum = 1;
            copyC.quantPre = QuantMode_t::NoQuant;
            Fixpipe(matrix[col], c1, copyC);
            CrossCoreSetFlag<0x2, PIPE_FIX>(0x8 + col / TILE_N);
            c1Queue.FreeTensor(c1);
        }
        a2Queue.FreeTensor(a2);
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 2> inputQueue;
        TQue<TPosition::VECOUT, 1> outputQueue;
        TBuf<TPosition::VECCALC> maximumBuffer, tempBuffer;
        pipe.InitBuffer(inputQueue, 2, M * TILE_N * sizeof(float));
        pipe.InitBuffer(outputQueue, 1, M * sizeof(float));
        pipe.InitBuffer(maximumBuffer, M * sizeof(float));
        pipe.InitBuffer(tempBuffer, M * sizeof(float));
        GlobalTensor<float> scores;
        scores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
        auto maxima = maximumBuffer.Get<float>();
        auto temporary = tempBuffer.Get<float>();
        for (uint32_t tileCol = 0; tileCol < COLS; tileCol += TILE_N) {
            CrossCoreWaitFlag(0x8 + tileCol / TILE_N);
            auto input = inputQueue.AllocTensor<float>();
            DataCopyParams copyTile{M, TILE_N / 8, (COLS - TILE_N) / 8, 0};
            DataCopy(input, matrix[tileCol], copyTile);
            inputQueue.EnQue(input);
            input = inputQueue.DeQue<float>();
            BinaryRepeatParams foldRepeat{1, 1, 1, TILE_N / 8, TILE_N / 8, TILE_N / 8};
            for (uint32_t width = TILE_N / 2; width >= 64; width /= 2) {
                for (uint32_t col = 0; col < width; col += 64) {
                    Max(input[col], input[col], input[col + width], 64, M, foldRepeat);
                }
                PipeBarrier<PIPE_V>();
            }
            auto currentMaxima = tileCol == 0 ? maxima : temporary;
            WholeReduceMax(currentMaxima, input, 64, M, 1, 1, TILE_N / 8,
                ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            if (tileCol != 0) {
                Max(maxima, maxima, temporary, M);
                PipeBarrier<PIPE_V>();
            }
            inputQueue.FreeTensor(input);
        }
        auto result = outputQueue.AllocTensor<float>();
        Adds(result, maxima, 0.0f, M);
        outputQueue.EnQue(result);
        result = outputQueue.DeQue<float>();
        DataCopy(scores[task * M], result, M);
        outputQueue.FreeTensor(result);
        SyncAll<true>();
        if (task == 0) {
            // 点14为单batch单行片，保留各N片Max顺序，直接对64行求和写回。
            auto local = inputQueue.AllocTensor<float>();
            DataCopy(local, scores, params.cores * M);
            inputQueue.EnQue(local);
            local = inputQueue.DeQue<float>();
            Max(maxima, local, local[M], M);
            for (uint32_t part = 2; part < params.cores; ++part) {
                PipeBarrier<PIPE_V>();
                Max(maxima, maxima, local[part * M], M);
            }
            PipeBarrier<PIPE_V>();
            auto finalResult = outputQueue.AllocTensor<float>();
            WholeReduceSum(finalResult, maxima, M, 1, 1, 1, 1);
            inputQueue.FreeTensor(local);
            outputQueue.EnQue(finalResult);
            finalResult = outputQueue.DeQue<float>();
            GlobalTensor<float> output;
            output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
            DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
            DataCopyPad(output, finalResult, copy);
            outputQueue.FreeTensor(finalResult);
        }
    }
}

// 点13：保持20核×416行，每核最多两次208×64×128基础Cube；一次launch完成归约。
__global__ __aicore__ void ComputePoint13ManualCube(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR partial, GM_ADDR y, Parameters params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    constexpr uint32_t ROWS = 416, TILE_M = 128, N = 64, K = 128;
    const uint32_t task = GetBlockIdx();
    const uint32_t validRows = params.m - task * ROWS < ROWS ? params.m - task * ROWS : ROWS;
    TPipe pipe;
    GlobalTensor<float> matrix;
    matrix.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + task * ROWS * N);
    if ASCEND_IS_AIC {
        TQue<TPosition::A1, 1> a1Queue;
        TQue<TPosition::B1, 1> b1Queue;
        TQue<TPosition::A2, 1> a2Queue;
        TQue<TPosition::B2, 1> b2Queue;
        TQue<TPosition::CO1, 1> c1Queue;
        pipe.InitBuffer(a1Queue, 1, TILE_M * K * sizeof(half));
        pipe.InitBuffer(b1Queue, 1, N * K * sizeof(half));
        pipe.InitBuffer(a2Queue, 1, TILE_M * K * sizeof(half));
        pipe.InitBuffer(b2Queue, 1, N * K * sizeof(half));
        pipe.InitBuffer(c1Queue, 1, TILE_M * N * sizeof(float));
        GlobalTensor<half> a, b;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + task * ROWS * K);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2));
        auto b1 = b1Queue.AllocTensor<half>();
        Nd2NzParams copyB{};
        copyB.ndNum = 1;
        copyB.nValue = K;
        copyB.dValue = N;
        copyB.srcDValue = N;
        copyB.dstNzC0Stride = K;
        copyB.dstNzNStride = 1;
        DataCopy(b1, b, copyB);
        b1Queue.EnQue(b1);
        b1 = b1Queue.DeQue<half>();
        auto b2 = b2Queue.AllocTensor<half>();
        LoadData2DParams loadB{};
        loadB.repeatTimes = N / 16;
        loadB.srcStride = K / 16;
        loadB.ifTranspose = true;
        for (uint32_t kBlock = 0; kBlock < K / 16; ++kBlock) {
            LoadData(b2[kBlock * N * 16], b1[kBlock * 256], loadB);
        }
        b2Queue.EnQue(b2);
        b1Queue.FreeTensor(b1);
        b2 = b2Queue.DeQue<half>();
        for (uint32_t row = 0; row < validRows; row += TILE_M) {
            const uint32_t currentRows = validRows - row < TILE_M ? validRows - row : TILE_M;
            auto a1 = a1Queue.AllocTensor<half>();
            Nd2NzParams copyA{};
            copyA.ndNum = 1;
            copyA.nValue = currentRows;
            copyA.dValue = K;
            copyA.srcDValue = K;
            copyA.dstNzC0Stride = TILE_M;
            copyA.dstNzNStride = 1;
            DataCopy(a1, a[row * K], copyA);
            a1Queue.EnQue(a1);
            a1 = a1Queue.DeQue<half>();
            auto a2 = a2Queue.AllocTensor<half>();
            LoadData2DParams loadA{};
            loadA.repeatTimes = K / 16;
            loadA.srcStride = TILE_M / 16;
            loadA.ifTranspose = false;
            for (uint32_t rowBlock = 0; rowBlock < TILE_M / 16; ++rowBlock) {
                LoadData(a2[rowBlock * K * 16], a1[rowBlock * 256], loadA);
            }
            a2Queue.EnQue(a2);
            a1Queue.FreeTensor(a1);
            a2 = a2Queue.DeQue<half>();
            auto c1 = c1Queue.AllocTensor<float>();
            MmadParams multiply{};
            multiply.m = currentRows;
            multiply.n = N;
            multiply.k = K;
            multiply.cmatrixInitVal = true;
            Mmad(c1, a2, b2, multiply);
            a2Queue.FreeTensor(a2);
            c1Queue.EnQue(c1);
            c1 = c1Queue.DeQue<float>();
            FixpipeParamsV220 copyC{};
            copyC.nSize = N;
            copyC.mSize = currentRows;
            copyC.srcStride = currentRows;
            copyC.dstStride = N;
            copyC.ndNum = 1;
            copyC.quantPre = QuantMode_t::NoQuant;
            Fixpipe(matrix[row * N], c1, copyC);
            CrossCoreSetFlag<0x2, PIPE_FIX>(row / TILE_M);
            c1Queue.FreeTensor(c1);
        }
        b2Queue.FreeTensor(b2);
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 2> inputQueue;
        TQue<TPosition::VECOUT, 1> outputQueue;
        TBuf<TPosition::VECCALC> maximumBuffer, tempBuffer;
        pipe.InitBuffer(inputQueue, 2, TILE_M * N * sizeof(float));
        pipe.InitBuffer(outputQueue, 1, PARTIAL_STRIDE * sizeof(float));
        pipe.InitBuffer(maximumBuffer, ROWS * sizeof(float));
        pipe.InitBuffer(tempBuffer, ROWS * sizeof(float));
        GlobalTensor<float> scores;
        scores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
        auto maxima = maximumBuffer.Get<float>();
        // 两个不同事件分别保护两段GM结果，防止同一事件被提前重复置位。
        for (uint32_t row = 0; row < validRows; row += TILE_M) {
            const uint32_t currentRows = validRows - row < TILE_M ? validRows - row : TILE_M;
            CrossCoreWaitFlag(row / TILE_M);
            auto input = inputQueue.AllocTensor<float>();
            DataCopy(input, matrix[row * N], currentRows * N);
            inputQueue.EnQue(input);
            input = inputQueue.DeQue<float>();
            for (uint32_t localRow = 0; localRow < currentRows; localRow += 128) {
                const uint32_t count = currentRows - localRow < 128 ? currentRows - localRow : 128;
                WholeReduceMax(maxima[row + localRow], input[localRow * N], N, count,
                    1, 1, N / 8, ReduceOrder::ORDER_ONLY_VALUE);
            }
            inputQueue.FreeTensor(input);
        }
        PipeBarrier<PIPE_V>();
        auto result = outputQueue.AllocTensor<float>();
        Duplicate(result, 0.0f, PARTIAL_STRIDE);
        PipeBarrier<PIPE_V>();
        ReduceSum(result, maxima, tempBuffer.Get<float>(), validRows);
        outputQueue.EnQue(result);
        result = outputQueue.DeQue<float>();
        DataCopy(scores[task * PARTIAL_STRIDE], result, PARTIAL_STRIDE);
        outputQueue.FreeTensor(result);
        SyncAll<true>();
        if (task == 0) {
            // 点13为单batch，沿用原320元素ReduceSum顺序并直接由Vector写回。
            const uint32_t count = params.rowTiles * PARTIAL_STRIDE;
            auto local = inputQueue.AllocTensor<float>();
            DataCopy(local, scores, count);
            inputQueue.EnQue(local);
            local = inputQueue.DeQue<float>();
            auto finalResult = outputQueue.AllocTensor<float>();
            ReduceSum(finalResult, local, tempBuffer.Get<float>(), count);
            inputQueue.FreeTensor(local);
            outputQueue.EnQue(finalResult);
            finalResult = outputQueue.DeQue<float>();
            GlobalTensor<float> output;
            output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
            DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
            DataCopyPad(output, finalResult, copy);
            outputQueue.FreeTensor(finalResult);
        }
    }
}


// 点8：保留9行任务×2列分片；L1驻留完整A及当前112列B，固定K顺序累加。
__global__ __aicore__ void ComputePoint8ManualCube(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR partial, GM_ADDR y, Parameters params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    constexpr uint32_t ROWS = 128, TILE_N = 112, TILE_K = 128, PAD_K = 1040;
    constexpr uint32_t MATRIX_STRIDE = 528, CHUNK_ROWS = 32;
    const uint32_t task = GetBlockIdx();
    const uint32_t originalRow = task / 2 * ROWS;
    const uint32_t firstN = task % 2 * 512;
    const uint32_t validRows = params.m - originalRow < ROWS ? params.m - originalRow : ROWS;
    const uint32_t padRows = (validRows + 15) / 16 * 16;
    const uint32_t validN = task % 2 == 0 ? 512 : params.n - 512;
    TPipe pipe;
    GlobalTensor<float> matrix;
    // host每核原有2×128×512个float，大于本实现128×528的输出跨度。
    matrix.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch) + task * 2 * ROWS * 512);
    if ASCEND_IS_AIC {
        TQue<TPosition::A1, 1> a1Queue;
        TQue<TPosition::B1, 1> b1Queue;
        TQue<TPosition::A2, 2> a2Queue;
        TQue<TPosition::B2, 2> b2Queue;
        TQue<TPosition::CO1, 1> c1Queue;
        pipe.InitBuffer(a1Queue, 1, ROWS * PAD_K * sizeof(bfloat16_t));
        pipe.InitBuffer(b1Queue, 1, TILE_N * PAD_K * sizeof(bfloat16_t));
        pipe.InitBuffer(a2Queue, 2, ROWS * TILE_K * sizeof(bfloat16_t));
        pipe.InitBuffer(b2Queue, 2, TILE_N * TILE_K * sizeof(bfloat16_t));
        pipe.InitBuffer(c1Queue, 1, ROWS * TILE_N * sizeof(float));
        GlobalTensor<bfloat16_t> a, b;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x1));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x2));
        auto a1 = a1Queue.AllocTensor<bfloat16_t>();
        Nd2NzParams copyA{};
        copyA.ndNum = 1;
        copyA.nValue = params.k;
        copyA.dValue = validRows;
        copyA.srcDValue = params.m;
        copyA.dstNzC0Stride = PAD_K;
        copyA.dstNzNStride = 1;
        DataCopy(a1, a[originalRow], copyA);
        a1Queue.EnQue(a1);
        a1 = a1Queue.DeQue<bfloat16_t>();
        for (uint32_t col = 0; col < validN; col += TILE_N) {
            const uint32_t columns = validN - col < TILE_N ? validN - col : TILE_N;
            const uint32_t padColumns = (columns + 15) / 16 * 16;
            auto b1 = b1Queue.AllocTensor<bfloat16_t>();
            Nd2NzParams copyB{};
            copyB.ndNum = 1;
            copyB.nValue = columns;
            copyB.dValue = params.k;
            copyB.srcDValue = params.k;
            copyB.dstNzC0Stride = padColumns;
            copyB.dstNzNStride = 1;
            DataCopy(b1, b[(firstN + col) * params.k], copyB);
            b1Queue.EnQue(b1);
            b1 = b1Queue.DeQue<bfloat16_t>();
            auto c1 = c1Queue.AllocTensor<float>();
            for (uint32_t offset = 0; offset < params.k; offset += TILE_K) {
                const uint32_t validK = params.k - offset < TILE_K ? params.k - offset : TILE_K;
                const uint32_t currentK = (validK + 15) / 16 * 16;
                auto a2 = a2Queue.AllocTensor<bfloat16_t>();
                auto b2 = b2Queue.AllocTensor<bfloat16_t>();
                LoadData2DParams loadA{};
                loadA.repeatTimes = currentK / 16;
                loadA.srcStride = 1;
                loadA.ifTranspose = true;
                for (uint32_t rowBlock = 0; rowBlock < padRows / 16; ++rowBlock) {
                    LoadData(a2[rowBlock * currentK * 16],
                        a1[rowBlock * PAD_K * 16 + offset * 16], loadA);
                }
                LoadData2DParams loadB{};
                loadB.repeatTimes = currentK / 16 * (padColumns / 16);
                loadB.srcStride = 1;
                loadB.ifTranspose = false;
                LoadData(b2, b1[offset * padColumns], loadB);
                a2Queue.EnQue(a2);
                b2Queue.EnQue(b2);
                a2 = a2Queue.DeQue<bfloat16_t>();
                b2 = b2Queue.DeQue<bfloat16_t>();
                MmadParams multiply{};
                // M=1会启用ND格式GEMV；按补齐16行MMAD，Fixpipe仍仅写有效行。
                multiply.m = padRows;
                multiply.n = columns;
                // 只累加实际K；转置A的nValue尾部没有文档保证补零。
                multiply.k = validK;
                multiply.cmatrixInitVal = offset == 0;
                Mmad(c1, a2, b2, multiply);
                a2Queue.FreeTensor(a2);
                b2Queue.FreeTensor(b2);
            }
            b1Queue.FreeTensor(b1);
            c1Queue.EnQue(c1);
            c1 = c1Queue.DeQue<float>();
            FixpipeParamsV220 copyC{};
            copyC.nSize = columns;
            copyC.mSize = validRows;
            copyC.srcStride = padRows;
            copyC.dstStride = MATRIX_STRIDE;
            copyC.ndNum = 1;
            copyC.quantPre = QuantMode_t::NoQuant;
            Fixpipe(matrix[col], c1, copyC);
            // 五个N块分别使用flag0..4，均在本调用消费完毕，不复用GM区域。
            CrossCoreSetFlag<0x2, PIPE_FIX>(col / TILE_N);
            c1Queue.FreeTensor(c1);
        }
        a1Queue.FreeTensor(a1);
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> inputQueue;
        TQue<TPosition::VECOUT, 1> outputQueue;
        TBuf<TPosition::VECCALC> maximumBuffer, currentBuffer, tempBuffer;
        pipe.InitBuffer(inputQueue, 1, ROWS * TILE_N * sizeof(float));
        pipe.InitBuffer(outputQueue, 1, ROWS * sizeof(float));
        pipe.InitBuffer(maximumBuffer, ROWS * sizeof(float));
        pipe.InitBuffer(currentBuffer, ROWS * sizeof(float));
        pipe.InitBuffer(tempBuffer, ROWS * sizeof(float));
        GlobalTensor<float> scores;
        scores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
        auto maxima = maximumBuffer.Get<float>();
        auto current = currentBuffer.Get<float>();
        auto temporary = tempBuffer.Get<float>();
        DataCopyPadExtParams<float> noPadding{false, 0, 0, 0};
        for (uint32_t col = 0; col < validN; col += TILE_N) {
            const uint32_t columns = validN - col < TILE_N ? validN - col : TILE_N;
            const uint32_t localStride = (columns + 7) / 8 * 8;
            CrossCoreWaitFlag(col / TILE_N);
            auto input = inputQueue.AllocTensor<float>();
            DataCopyExtParams readCopy{static_cast<uint16_t>(validRows), columns * 4U,
                (MATRIX_STRIDE - columns) * 4U, 0, 0};
            DataCopyPad(input, matrix[col], readCopy, noPadding);
            inputQueue.EnQue(input);
            input = inputQueue.DeQue<float>();
            WholeReduceMax(current, input, 64, validRows, 1, 1, localStride / 8,
                ReduceOrder::ORDER_ONLY_VALUE);
            if (columns > 64) {
                WholeReduceMax(temporary, input[64], columns - 64, validRows, 1, 1,
                    localStride / 8, ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(current, current, temporary, validRows);
            }
            PipeBarrier<PIPE_V>();
            if (col == 0) {
                Adds(maxima, current, 0.0f, validRows);
            } else {
                Max(maxima, maxima, current, validRows);
            }
            PipeBarrier<PIPE_V>();
            inputQueue.FreeTensor(input);
        }
        auto result = outputQueue.AllocTensor<float>();
        Duplicate(result, 0.0f, ROWS);
        PipeBarrier<PIPE_V>();
        Adds(result, maxima, 0.0f, validRows);
        outputQueue.EnQue(result);
        result = outputQueue.DeQue<float>();
        DataCopy(scores[task * ROWS], result, ROWS);
        outputQueue.FreeTensor(result);
        SyncAll<true>();
        if (task == 0) {
            FinishSplitN<ROWS>(pipe, partial, y, params);
        }
    }
}

template <typename T, uint32_t BASE_ROWS, uint32_t BASE_COLS, bool TRANS_RIGHT>
__aicore__ constexpr auto MakeSwappedTTConfig()
{
    MatmulConfig config = CFG_MDL;
    config.enUnitFlag = true;
    config.enableMixDualMaster = true;
    config.basicM = BASE_ROWS;
    config.basicN = BASE_COLS;
    config.basicK = 64;
    config.enableSetBias = false;
    using InputA = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, false>;
    using InputB = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TRANS_RIGHT>;
    using Output = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
    return AscendC::GetMatmulApiTiling<InputA, InputB, Output, Output>(config);
}
template <typename T, uint32_t BASE_ROWS, uint32_t BASE_COLS, bool TRANS_RIGHT>
constexpr auto SWAPPED_TT_CONFIG = MakeSwappedTTConfig<T, BASE_ROWS, BASE_COLS, TRANS_RIGHT>();

// C'=C转置：原TT使用NN，原NT使用NT；对C'按行取Max得到原C的逐行Max。
// 只交换矩阵乘法的表示，不交换最终Max和Sum的数学顺序。
template <typename T, uint32_t ROWS, uint32_t N_PART, uint32_t BASE_ROWS, uint32_t BASE_COLS,
    bool TRANS_RIGHT = false>
__global__ __aicore__ void ComputeSwappedTT(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR partial, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, Parameters params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    constexpr uint32_t CHUNK_ROWS = ROWS > 128 ? 64 : 128;
    TPipe pipe;
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, T, false>,
        MatmulType<TPosition::GM, CubeFormat::ND, T, TRANS_RIGHT>,
        MatmulType<TPosition::GM, CubeFormat::ND, float>,
        MatmulType<TPosition::GM, CubeFormat::ND, float>, SWAPPED_TT_CONFIG<T, BASE_ROWS, BASE_COLS, TRANS_RIGHT>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &params.cube);
    const uint32_t parts = params.cores / params.rowTiles;
    const uint32_t task = GetBlockIdx();
    const uint32_t rowTask = task / parts;
    const uint32_t part = task % parts;
    const uint32_t originalRow = rowTask * ROWS;
    const uint32_t validOriginalRows = params.m - originalRow < ROWS ? params.m - originalRow : ROWS;
    const uint32_t columnTiles = (params.n + N_PART - 1) / N_PART;
    const uint32_t firstN = columnTiles * part / parts * N_PART;
    const uint32_t endNUnclamped = columnTiles * (part + 1) / parts * N_PART;
    const uint32_t endN = endNUnclamped < params.n ? endNUnclamped : params.n;
    const uint32_t validN = endN - firstN;
    GlobalTensor<T> physicalA;
    GlobalTensor<T> physicalB;
    GlobalTensor<float> matrix;
    GlobalTensor<float> scores;
    physicalA.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    physicalB.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    matrix.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch)
        + static_cast<uint64_t>(task) * (params.n > N_PART ? 2 : 1) * ROWS * N_PART);
    scores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    mm.SetOrgShape(params.n, params.m, params.k, params.k, ROWS);
    mm.SetTail(validN, validOriginalRows, params.k);
    mm.SetTensorA(physicalA[static_cast<uint64_t>(firstN) * params.k], false);
    mm.SetTensorB(physicalB[TRANS_RIGHT ? static_cast<uint64_t>(originalRow) * params.k : originalRow], TRANS_RIGHT);
    mm.template IterateAll<true>(matrix);
    mm.End();
    if ASCEND_IS_AIC {
        return;
    }
    TQue<TPosition::VECIN, 2> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> maximaBuffer;
    pipe.InitBuffer(inputQueue, 2, CHUNK_ROWS * ROWS * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, ROWS * sizeof(float));
    pipe.InitBuffer(maximaBuffer, ROWS * sizeof(float));
    auto maxima = maximaBuffer.Get<float>();
    auto initial = inputQueue.AllocTensor<float>();
    const uint32_t initialRows = validN < CHUNK_ROWS ? validN : CHUNK_ROWS;
    DataCopy(initial, matrix, initialRows * ROWS);
    inputQueue.EnQue(initial);
    for (uint32_t offset = 0; offset < validN; offset += CHUNK_ROWS) {
        const uint32_t rows = validN - offset < CHUNK_ROWS ? validN - offset : CHUNK_ROWS;
        auto tile = inputQueue.DeQue<float>();
        const uint32_t nextOffset = offset + CHUNK_ROWS;
        if (nextOffset < validN) {
            auto next = inputQueue.AllocTensor<float>();
            const uint32_t nextRows = validN - nextOffset < CHUNK_ROWS ? validN - nextOffset : CHUNK_ROWS;
            DataCopy(next, matrix[nextOffset * ROWS], nextRows * ROWS);
            inputQueue.EnQue(next);
        }
        // 固定二叉树按N归约；奇数行保留中间未配对行，所有有效行恰好使用一次。
        for (uint32_t activeRows = rows; activeRows > 1;) {
            const uint32_t nextRows = (activeRows + 1) / 2;
            const uint32_t pairs = activeRows - nextRows;
            Max(tile, tile, tile[nextRows * ROWS], pairs * ROWS);
            PipeBarrier<PIPE_V>();
            activeRows = nextRows;
        }
        if (offset == 0) {
            Adds(maxima, tile, 0.0f, validOriginalRows);
        } else {
            Max(maxima, maxima, tile, validOriginalRows);
        }
        PipeBarrier<PIPE_V>();
        inputQueue.FreeTensor(tile);
    }
    auto result = outputQueue.AllocTensor<float>();
    if (parts > 1) {
        Duplicate(result, 0.0f, ROWS);
        PipeBarrier<PIPE_V>();
        Adds(result, maxima, 0.0f, validOriginalRows);
    } else {
        TBuf<TPosition::VECCALC> sumTemp;
        pipe.InitBuffer(sumTemp, ROWS * sizeof(float));
        auto temporary = sumTemp.Get<float>();
        Duplicate(result, 0.0f, PARTIAL_STRIDE);
        PipeBarrier<PIPE_V>();
        ReduceSum(result, maxima, temporary, validOriginalRows);
    }
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    if (parts > 1) {
        DataCopy(scores[task * ROWS], result, ROWS);
    } else {
        DataCopy(scores[task * PARTIAL_STRIDE], result, PARTIAL_STRIDE);
    }
    outputQueue.FreeTensor(result);
    SyncAll<true>();
    if (task == 0) {
        if (parts > 1) {
            FinishSplitN<ROWS>(pipe, partial, y, params);
        } else {
            Finish(pipe, partial, y, params.rowTiles, params.batch);
        }
    }
}

template <typename T, bool TRANS_A, bool TRANS_B, bool SPLIT_N,
    uint32_t TILE_ROWS, uint32_t TILE_COLS, bool DIRECT_RESULT, bool STATIC_BASE,
    uint32_t BASIC_COLS = TILE_COLS, uint32_t BASIC_ROWS = TILE_ROWS>
__global__ __aicore__ void Compute(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR partial, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, Parameters params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    TPipe pipe;
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, T, TRANS_A>,
        MatmulType<TPosition::GM, CubeFormat::ND, T, TRANS_B>,
        MatmulType<TPosition::GM, CubeFormat::ND, float>,
        MatmulType<TPosition::GM, CubeFormat::ND, float>,
        KERNEL_MATMUL_CONFIG<T, TRANS_A, TRANS_B, BASIC_ROWS, BASIC_COLS, STATIC_BASE>> mm;
    // 专用参数绑定系统工作区；形参是用户区地址，不能作为 KFC 通信区。
    // 必须与编译器初始化的系统区使用同一地址，避免重复调用读取旧退出消息。
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &params.cube);
    // 同次核调用的原始形状与输出行距不变，只发送一次KFC形状消息。
    // 必须在各列块的SetTail、SetTensorA和SetTensorB之前完成设置。
    mm.SetOrgShape(params.m, params.n, params.k, params.k, TILE_COLS);

    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> c;
    GlobalTensor<float> scores;
    GlobalTensor<float> finalOutput;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    const uint32_t scratchTiles = params.n > TILE_COLS ? 2 : 1;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch)
        + GetBlockIdx() * scratchTiles * TILE_ROWS * TILE_COLS);
    scores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    finalOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    if constexpr (COMPUTE_CONFIG<BASIC_ROWS, BASIC_COLS>.enableMixDualMaster) {
        if ASCEND_IS_AIC {
            // AIC按与AIV相同的任务/列块顺序运行；SDK的IterateAll等待AIV许可，
            // 完成FIXPIPE后通知AIV。无需另行占用跨核flag，UB归约仅在AIV执行。
            const uint32_t cubeParts = SPLIT_N ? params.cores / (params.batch * params.rowTiles) : 1;
            const uint32_t cubeTasks = params.batch * params.rowTiles * cubeParts;
            for (uint32_t task = GetBlockIdx(); task < cubeTasks; task += params.cores) {
                const uint32_t rowTask = task / cubeParts;
                const uint32_t columnTiles = (params.n + TILE_COLS - 1) / TILE_COLS;
                const uint32_t part = task % cubeParts;
                const uint32_t firstCol = (columnTiles * part / cubeParts) * TILE_COLS;
                const uint32_t endTileCol = (columnTiles * (part + 1) / cubeParts) * TILE_COLS;
                const uint32_t endCol = endTileCol < params.n ? endTileCol : params.n;
                const uint32_t batch = rowTask / params.rowTiles;
                const uint32_t rowStart = (rowTask % params.rowTiles) * TILE_ROWS;
                const uint32_t validRows = params.m - rowStart < TILE_ROWS ? params.m - rowStart : TILE_ROWS;
                const uint64_t aOffset = static_cast<uint64_t>(batch) * params.m * params.k
                    + (TRANS_A ? rowStart : static_cast<uint64_t>(rowStart) * params.k);
                const uint64_t bOffset = static_cast<uint64_t>(batch) * params.k * params.n;
                for (uint32_t colStart = firstCol; colStart < endCol; colStart += TILE_COLS) {
                    const uint32_t slot = ((colStart - firstCol) / TILE_COLS) % scratchTiles;
                    if (params.n > TILE_COLS) {
                        StartColumn<TILE_COLS, TRANS_A, TRANS_B, true>(mm, a, b,
                            c[slot * TILE_ROWS * TILE_COLS], params, aOffset, bOffset, validRows, colStart);
                    } else {
                        StartColumn<TILE_COLS, TRANS_A, TRANS_B, false>(mm, a, b, c,
                            params, aOffset, bOffset, validRows, colStart);
                    }
                }
            }
            return;
        }
    }

    // 每个batch仅有一个行块且未按N分片时，本核已得到该batch的最终结果。
    // 通过MTE3按字节搬出独立float，不使用会整缓存行回写的GlobalTensor::SetValue。
    const bool directBatchOutput = !SPLIT_N
        && TILE_ROWS == DEFAULT_ROWS && TILE_COLS == DEFAULT_COLS
        && params.batch > 1 && params.rowTiles == 1;

    constexpr bool SEGMENT_REDUCTION = TILE_COLS > 256 || TILE_ROWS * TILE_COLS > 32768;
    constexpr uint32_t REDUCTION_COLUMNS = TILE_ROWS > 128 ? 64 : 128;
    constexpr uint32_t INPUT_BUFFER_COUNT = SEGMENT_REDUCTION ? 2 : 1;
    TQue<TPosition::VECIN, INPUT_BUFFER_COUNT> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> reduceBuffer;
    TBuf<TPosition::VECCALC> resultBuffer;
    constexpr uint32_t INPUT_COLS = SEGMENT_REDUCTION ? REDUCTION_COLUMNS : TILE_COLS;
    pipe.InitBuffer(inputQueue, INPUT_BUFFER_COUNT, TILE_ROWS * INPUT_COLS * sizeof(float));
    constexpr uint32_t outputStride = SPLIT_N ? TILE_ROWS : PARTIAL_STRIDE;
    pipe.InitBuffer(outputQueue, 1, outputStride * sizeof(float));
    constexpr uint32_t REDUCE_ELEMENTS = SEGMENT_REDUCTION ? TILE_ROWS
        : (TILE_COLS > 64 && TILE_ROWS > TILE_COLS ? TILE_ROWS : TILE_COLS);
    pipe.InitBuffer(reduceBuffer, REDUCE_ELEMENTS * sizeof(float));
    pipe.InitBuffer(resultBuffer, 2 * TILE_ROWS * sizeof(float));
    auto reduceTemp = reduceBuffer.Get<float>();
    auto reduced = resultBuffer.Get<float>();
    auto rowMax = reduced[TILE_ROWS];

    const uint32_t parts = SPLIT_N ? params.cores / (params.batch * params.rowTiles) : 1;
    const uint32_t tasks = params.batch * params.rowTiles * parts;
    for (uint32_t task = GetBlockIdx(); task < tasks; task += params.cores) {
        const uint32_t rowTask = task / parts;
        uint32_t firstCol = 0;
        uint32_t endCol = params.n;
        if (SPLIT_N) {
            const uint32_t part = task % parts;
            const uint32_t columnTiles = (params.n + TILE_COLS - 1) / TILE_COLS;
            firstCol = (columnTiles * part / parts) * TILE_COLS;
            const uint32_t endTileCol = (columnTiles * (part + 1) / parts) * TILE_COLS;
            endCol = endTileCol < params.n ? endTileCol : params.n;
        }
        const uint32_t batch = rowTask / params.rowTiles;
        const uint32_t rowStart = (rowTask % params.rowTiles) * TILE_ROWS;
        const uint32_t validRows = params.m - rowStart < TILE_ROWS ? params.m - rowStart : TILE_ROWS;
        const uint64_t aOffset = static_cast<uint64_t>(batch) * params.m * params.k
            + (TRANS_A ? rowStart : static_cast<uint64_t>(rowStart) * params.k);
        const uint64_t bOffset = static_cast<uint64_t>(batch) * params.k * params.n;
        // 多列块采用两个 GM 槽：当前块读回/归约时，Cube 计算下一块。
        if (params.n > TILE_COLS) {
            StartColumn<TILE_COLS, TRANS_A, TRANS_B, true>(mm, a, b, c, params,
                aOffset, bOffset, validRows, firstCol);
        }
        // K 的完整点积仍由 Cube 以 FP32 累加；N 分块之间只合并最大值。
        for (uint32_t colStart = firstCol; colStart < endCol; colStart += TILE_COLS) {
            const uint32_t validCols = params.n - colStart < TILE_COLS ? params.n - colStart : TILE_COLS;
            const uint32_t slot = ((colStart - firstCol) / TILE_COLS) % scratchTiles;
            if (params.n > TILE_COLS) {
                mm.WaitIterateAll();
            } else {
                StartColumn<TILE_COLS, TRANS_A, TRANS_B, false>(mm, a, b, c, params,
                    aOffset, bOffset, validRows, colStart);
            }
            mm.End();

            const uint32_t nextCol = colStart + TILE_COLS;
            if (nextCol < endCol) {
                const uint32_t nextSlot = (slot + 1) % scratchTiles;
                StartColumn<TILE_COLS, TRANS_A, TRANS_B, true>(mm, a, b,
                    c[nextSlot * TILE_ROWS * TILE_COLS], params, aOffset, bOffset, validRows, nextCol);
            }
            if constexpr (SEGMENT_REDUCTION) {
                // 逻辑宽块在Matmul内复用A；AIV按128列分段读取，避免占满UB。
                // 先搬入首段；随后在归约当前段前发出下一段搬运。
                // 两个UB槽只在本列块内流水，列块末尾仍保留完整屏障。
                const uint32_t initialColumns = validCols < REDUCTION_COLUMNS
                    ? validCols : REDUCTION_COLUMNS;
                auto initialTile = inputQueue.template AllocTensor<float>();
                DataCopyExtParams initialCopy{static_cast<uint16_t>(validRows),
                    static_cast<uint32_t>(initialColumns * sizeof(float)),
                    static_cast<uint32_t>((TILE_COLS - initialColumns) * sizeof(float)), 0, 0};
                DataCopyPadExtParams<float> padding{false, 0, 0, 0};
                DataCopyPad(initialTile, c[slot * TILE_ROWS * TILE_COLS], initialCopy, padding);
                inputQueue.EnQue(initialTile);
                for (uint32_t offset = 0; offset < validCols; offset += REDUCTION_COLUMNS) {
                    const uint32_t columns = validCols - offset < REDUCTION_COLUMNS
                        ? validCols - offset : REDUCTION_COLUMNS;
                    const uint32_t localColumns = (columns + 7) / 8 * 8;
                    auto tile = inputQueue.template DeQue<float>();
                    const uint32_t nextOffset = offset + REDUCTION_COLUMNS;
                    if (nextOffset < validCols) {
                        const uint32_t nextColumns = validCols - nextOffset < REDUCTION_COLUMNS
                            ? validCols - nextOffset : REDUCTION_COLUMNS;
                        auto nextTile = inputQueue.template AllocTensor<float>();
                        DataCopyExtParams nextCopy{static_cast<uint16_t>(validRows),
                            static_cast<uint32_t>(nextColumns * sizeof(float)),
                            static_cast<uint32_t>((TILE_COLS - nextColumns) * sizeof(float)), 0, 0};
                        DataCopyPad(nextTile, c[slot * TILE_ROWS * TILE_COLS + nextOffset],
                            nextCopy, padding);
                        inputQueue.EnQue(nextTile);
                    }
                    if constexpr (TILE_ROWS == 112 && TILE_COLS == 1024
                        && !TRANS_A && TRANS_B && !SPLIT_N) {
                        // 点9每段128列先逐元素折成64列，只保留一次水平归约。
                        const uint8_t rowStride = static_cast<uint8_t>(localColumns / 8);
                        if (columns > 64) {
                            BinaryRepeatParams fold{1, 1, 1, rowStride, rowStride, rowStride};
                            Max(tile, tile, tile[64], columns - 64, validRows, fold);
                            PipeBarrier<PIPE_V>();
                        }
                        const uint32_t firstColumns = columns < 64 ? columns : 64;
                        WholeReduceMax(reduced, tile, firstColumns, validRows, 1, 1, rowStride,
                            ReduceOrder::ORDER_ONLY_VALUE);
                        PipeBarrier<PIPE_V>();
                    } else {
                        const uint32_t firstColumns = columns < 64 ? columns : 64;
                        const uint32_t rowStride = localColumns * sizeof(float) / 32;
                        if constexpr (TILE_ROWS > 128) {
                            for (uint32_t rowOffset = 0; rowOffset < validRows; rowOffset += 128) {
                                const uint32_t rows = validRows - rowOffset < 128
                                    ? validRows - rowOffset : 128;
                                WholeReduceMax(reduced[rowOffset], tile[rowOffset * localColumns],
                                    firstColumns, rows, 1, 1, rowStride,
                                    ReduceOrder::ORDER_ONLY_VALUE);
                            }
                        } else {
                            WholeReduceMax(reduced, tile, firstColumns, validRows, 1, 1, rowStride,
                                ReduceOrder::ORDER_ONLY_VALUE);
                        }
                        if (columns > 64) {
                            if constexpr (TILE_ROWS > 128) {
                                for (uint32_t rowOffset = 0; rowOffset < validRows; rowOffset += 128) {
                                    const uint32_t rows = validRows - rowOffset < 128
                                        ? validRows - rowOffset : 128;
                                    WholeReduceMax(reduceTemp[rowOffset],
                                        tile[rowOffset * localColumns + 64], columns - 64,
                                        rows, 1, 1, rowStride, ReduceOrder::ORDER_ONLY_VALUE);
                                }
                            } else {
                                WholeReduceMax(reduceTemp, tile[64], columns - 64,
                                    validRows, 1, 1, rowStride, ReduceOrder::ORDER_ONLY_VALUE);
                            }
                            PipeBarrier<PIPE_V>();
                            Max(reduced, reduced, reduceTemp, validRows);
                        }
                        PipeBarrier<PIPE_V>();
                    }
                    // 第一段直接初始化，不能与0取Max，否则全负相似度会错误。
                    if (colStart == firstCol && offset == 0) {
                        Adds(rowMax, reduced, 0.0f, validRows);
                    } else {
                        Max(rowMax, rowMax, reduced, validRows);
                    }
                    PipeBarrier<PIPE_V>();
                    inputQueue.FreeTensor(tile);
                }
            } else {
                auto tile = inputQueue.template AllocTensor<float>();
                DataCopy(tile, c[slot * TILE_ROWS * TILE_COLS], validRows * TILE_COLS);
                inputQueue.EnQue(tile);
                // 上次使用同一 GM 槽的数据已完成搬运和归约，才会再次提交到该槽。
                tile = inputQueue.template DeQue<float>();
                // 每个 repeat 处理一行的至多64个float，行间跨度由列块宽度决定。
                // 只输出最值时 dstRepStride=1，结果连续存放，无须逐行经 Scalar 中转。
                const uint32_t halfColumns = TILE_COLS < 64 ? TILE_COLS : 64;
                const uint32_t firstColumns = validCols < halfColumns ? validCols : halfColumns;
                const uint32_t rowStride = TILE_COLS * sizeof(float) / 32;
                if constexpr (TILE_ROWS > 128) {
                    // 高窄大行块分组发射，避免repeat次数达到256时溢出。
                    for (uint32_t rowOffset = 0; rowOffset < validRows; rowOffset += 128) {
                        const uint32_t rows = validRows - rowOffset < 128
                            ? validRows - rowOffset : 128;
                        WholeReduceMax(reduced[rowOffset], tile[rowOffset * TILE_COLS],
                            firstColumns, rows, 1, 1, rowStride, ReduceOrder::ORDER_ONLY_VALUE);
                    }
                } else {
                    WholeReduceMax(reduced, tile, firstColumns, validRows, 1, 1, rowStride,
                        ReduceOrder::ORDER_ONLY_VALUE);
                }
                if constexpr (TILE_ROWS > 128 && TILE_COLS > 64) {
                    // 256行分块的后续列段也按128行分组，避免repeat=256溢出。
                    for (uint32_t offset = halfColumns; offset < validCols; offset += halfColumns) {
                        const uint32_t columns = validCols - offset < halfColumns
                            ? validCols - offset : halfColumns;
                        for (uint32_t rowOffset = 0; rowOffset < validRows; rowOffset += 128) {
                            const uint32_t rows = validRows - rowOffset < 128
                                ? validRows - rowOffset : 128;
                            WholeReduceMax(reduceTemp[rowOffset], tile[rowOffset * TILE_COLS + offset],
                                columns, rows, 1, 1, rowStride, ReduceOrder::ORDER_ONLY_VALUE);
                        }
                        PipeBarrier<PIPE_V>();
                        Max(reduced, reduced, reduceTemp, validRows);
                        PipeBarrier<PIPE_V>();
                    }
                } else if constexpr (TILE_COLS > 128) {
                    // 每段至多64个float，加宽列块的最后一段只读有效列。
                    for (uint32_t offset = halfColumns; offset < validCols; offset += halfColumns) {
                        const uint32_t columns = validCols - offset < halfColumns
                            ? validCols - offset : halfColumns;
                        WholeReduceMax(reduceTemp, tile[offset], columns,
                            validRows, 1, 1, rowStride, ReduceOrder::ORDER_ONLY_VALUE);
                        PipeBarrier<PIPE_V>();
                        Max(reduced, reduced, reduceTemp, validRows);
                        PipeBarrier<PIPE_V>();
                    }
                } else if (validCols > halfColumns) {
                    WholeReduceMax(reduceTemp, tile[halfColumns], validCols - halfColumns,
                        validRows, 1, 1, rowStride, ReduceOrder::ORDER_ONLY_VALUE);
                    PipeBarrier<PIPE_V>();
                    Max(reduced, reduced, reduceTemp, validRows);
                }
                PipeBarrier<PIPE_V>();
                // 第一块直接初始化，不能与0取Max，否则全负相似度会错误。
                if (colStart == firstCol) {
                    Adds(rowMax, reduced, 0.0f, validRows);
                } else {
                    Max(rowMax, rowMax, reduced, validRows);
                }
                PipeBarrier<PIPE_V>();
                inputQueue.FreeTensor(tile);
            }
            // 诊断列块间状态复用：完成当前列块的全部流水后再推进下一轮。
            PipeBarrier<PIPE_ALL>();
        }

        auto output = outputQueue.AllocTensor<float>();
        if (SPLIT_N) {
            // 每个分片独占一个完整行块槽，尾行补零仅用于写满槽，不参与最终 Max/Sum。
            Duplicate(output, 0.0f, TILE_ROWS);
            PipeBarrier<PIPE_V>();
            Adds(output, rowMax, 0.0f, validRows);
        } else {
            Duplicate(output, 0.0f, PARTIAL_STRIDE);
            PipeBarrier<PIPE_V>();
            if constexpr (TILE_ROWS > 64) {
                // 单条WholeReduceSum至多归约64个float，长行块使用多段归约API。
                ReduceSum(output, rowMax, reduceTemp, validRows);
            } else {
                WholeReduceSum(output, rowMax, static_cast<int32_t>(validRows), 1, 1, 1, 1);
            }
        }
        outputQueue.EnQue(output);
        output = outputQueue.DeQue<float>();
        if (DIRECT_RESULT || directBatchOutput) {
            DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
            DataCopyPad(finalOutput[batch], output, copy);
        } else {
            DataCopy(scores[task * outputStride], output, outputStride);
        }
        outputQueue.FreeTensor(output);
    }

    if (DIRECT_RESULT || directBatchOutput) {
        return;
    }

    // 普通模式的AIC留在KFC服务循环，双主模式的AIC已执行完独立循环并返回。
    // 等待所有 Vector 核的局部结果落入 GM，再由 0 号核顺序完成最终归约。
    // 不能使用包含Cube的同步：普通模式的Cube仍在服务循环，双主模式已退出。
    if (params.cores > 1) {
        SyncAll<true>();
    } else {
        // 单核无需跨核屏障，但必须等待 partial 写回后才能读取。
        PipeBarrier<PIPE_ALL>();
    }
    if (GetBlockIdx() == 0) {
        if (SPLIT_N) {
            FinishSplitN<TILE_ROWS>(pipe, partial, y, params);
        } else {
            Finish(pipe, partial, y, params.rowTiles, params.batch);
        }
    }
}


// 冷路径统一32×128块；N分片与直接输出仅由tiling参数选择。
// 计算、双GM槽、反向屏障与先Max后Sum的顺序沿用已验证实现。
template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputeGeneric(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR partial, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, GenericParameters generic)
{
    constexpr uint32_t TILE_ROWS = DEFAULT_ROWS;
    constexpr uint32_t TILE_COLS = DEFAULT_COLS;
    constexpr bool STATIC_BASE = false;
    auto& params = generic.base;
    const bool splitN = generic.splitN != 0;
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    TPipe pipe;
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, T, TRANS_A>,
        MatmulType<TPosition::GM, CubeFormat::ND, T, TRANS_B>,
        MatmulType<TPosition::GM, CubeFormat::ND, float>,
        MatmulType<TPosition::GM, CubeFormat::ND, float>,
        KERNEL_MATMUL_CONFIG<T, TRANS_A, TRANS_B, TILE_ROWS, TILE_COLS, STATIC_BASE>> mm;
    // 专用参数绑定系统工作区；形参是用户区地址，不能作为 KFC 通信区。
    // 必须与编译器初始化的系统区使用同一地址，避免重复调用读取旧退出消息。
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &params.cube);
    // 同次核调用的原始形状与输出行距不变，只发送一次KFC形状消息。
    // 必须在各列块的SetTail、SetTensorA和SetTensorB之前完成设置。
    mm.SetOrgShape(params.m, params.n, params.k, params.k, TILE_COLS);

    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> c;
    GlobalTensor<float> scores;
    GlobalTensor<float> finalOutput;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    const uint32_t scratchTiles = params.n > TILE_COLS ? 2 : 1;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch)
        + GetBlockIdx() * scratchTiles * TILE_ROWS * TILE_COLS);
    scores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    finalOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    if constexpr (COMPUTE_CONFIG<TILE_ROWS, TILE_COLS>.enableMixDualMaster) {
        if ASCEND_IS_AIC {
            // AIC按与AIV相同的任务/列块顺序运行；SDK的IterateAll等待AIV许可，
            // 完成FIXPIPE后通知AIV。无需另行占用跨核flag，UB归约仅在AIV执行。
            const uint32_t cubeParts = generic.parts;
            const uint32_t cubeTasks = params.batch * params.rowTiles * cubeParts;
            for (uint32_t task = GetBlockIdx(); task < cubeTasks; task += params.cores) {
                const uint32_t rowTask = task / cubeParts;
                const uint32_t columnTiles = (params.n + TILE_COLS - 1) / TILE_COLS;
                const uint32_t part = task % cubeParts;
                const uint32_t firstCol = (columnTiles * part / cubeParts) * TILE_COLS;
                const uint32_t endTileCol = (columnTiles * (part + 1) / cubeParts) * TILE_COLS;
                const uint32_t endCol = endTileCol < params.n ? endTileCol : params.n;
                const uint32_t batch = rowTask / params.rowTiles;
                const uint32_t rowStart = (rowTask % params.rowTiles) * TILE_ROWS;
                const uint32_t validRows = params.m - rowStart < TILE_ROWS ? params.m - rowStart : TILE_ROWS;
                const uint64_t aOffset = static_cast<uint64_t>(batch) * params.m * params.k
                    + (TRANS_A ? rowStart : static_cast<uint64_t>(rowStart) * params.k);
                const uint64_t bOffset = static_cast<uint64_t>(batch) * params.k * params.n;
                for (uint32_t colStart = firstCol; colStart < endCol; colStart += TILE_COLS) {
                    const uint32_t slot = ((colStart - firstCol) / TILE_COLS) % scratchTiles;
                    if (params.n > TILE_COLS) {
                        StartColumn<TILE_COLS, TRANS_A, TRANS_B, true>(mm, a, b,
                            c[slot * TILE_ROWS * TILE_COLS], params, aOffset, bOffset, validRows, colStart);
                    } else {
                        StartColumn<TILE_COLS, TRANS_A, TRANS_B, false>(mm, a, b, c,
                            params, aOffset, bOffset, validRows, colStart);
                    }
                }
            }
            return;
        }
    }

    // 每个batch仅有一个行块且未按N分片时，本核已得到该batch的最终结果。
    // 通过MTE3按字节搬出独立float，不使用会整缓存行回写的GlobalTensor::SetValue。
    const bool directOutput = generic.directOutput != 0;

    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> reduceBuffer;
    TBuf<TPosition::VECCALC> resultBuffer;
    pipe.InitBuffer(inputQueue, 1, TILE_ROWS * TILE_COLS * sizeof(float));
    const uint32_t outputStride = generic.partialStride;
    pipe.InitBuffer(outputQueue, 1, outputStride * sizeof(float));
    constexpr uint32_t REDUCE_ELEMENTS = TILE_COLS > 64 && TILE_ROWS > TILE_COLS
        ? TILE_ROWS : TILE_COLS;
    pipe.InitBuffer(reduceBuffer, REDUCE_ELEMENTS * sizeof(float));
    pipe.InitBuffer(resultBuffer, 2 * TILE_ROWS * sizeof(float));
    auto reduceTemp = reduceBuffer.Get<float>();
    auto reduced = resultBuffer.Get<float>();
    auto rowMax = reduced[TILE_ROWS];

    const uint32_t parts = generic.parts;
    const uint32_t tasks = params.batch * params.rowTiles * parts;
    for (uint32_t task = GetBlockIdx(); task < tasks; task += params.cores) {
        const uint32_t rowTask = task / parts;
        uint32_t firstCol = 0;
        uint32_t endCol = params.n;
        if (splitN) {
            const uint32_t part = task % parts;
            const uint32_t columnTiles = (params.n + TILE_COLS - 1) / TILE_COLS;
            firstCol = (columnTiles * part / parts) * TILE_COLS;
            const uint32_t endTileCol = (columnTiles * (part + 1) / parts) * TILE_COLS;
            endCol = endTileCol < params.n ? endTileCol : params.n;
        }
        const uint32_t batch = rowTask / params.rowTiles;
        const uint32_t rowStart = (rowTask % params.rowTiles) * TILE_ROWS;
        const uint32_t validRows = params.m - rowStart < TILE_ROWS ? params.m - rowStart : TILE_ROWS;
        const uint64_t aOffset = static_cast<uint64_t>(batch) * params.m * params.k
            + (TRANS_A ? rowStart : static_cast<uint64_t>(rowStart) * params.k);
        const uint64_t bOffset = static_cast<uint64_t>(batch) * params.k * params.n;
        // 多列块采用两个 GM 槽：当前块读回/归约时，Cube 计算下一块。
        if (params.n > TILE_COLS) {
            StartColumn<TILE_COLS, TRANS_A, TRANS_B, true>(mm, a, b, c, params,
                aOffset, bOffset, validRows, firstCol);
        }
        // K 的完整点积仍由 Cube 以 FP32 累加；N 分块之间只合并最大值。
        for (uint32_t colStart = firstCol; colStart < endCol; colStart += TILE_COLS) {
            const uint32_t validCols = params.n - colStart < TILE_COLS ? params.n - colStart : TILE_COLS;
            const uint32_t slot = ((colStart - firstCol) / TILE_COLS) % scratchTiles;
            if (params.n > TILE_COLS) {
                mm.WaitIterateAll();
            } else {
                StartColumn<TILE_COLS, TRANS_A, TRANS_B, false>(mm, a, b, c, params,
                    aOffset, bOffset, validRows, colStart);
            }
            mm.End();

            auto tile = inputQueue.AllocTensor<float>();
            DataCopy(tile, c[slot * TILE_ROWS * TILE_COLS], validRows * TILE_COLS);
            inputQueue.EnQue(tile);
            const uint32_t nextCol = colStart + TILE_COLS;
            if (nextCol < endCol) {
                const uint32_t nextSlot = (slot + 1) % scratchTiles;
                StartColumn<TILE_COLS, TRANS_A, TRANS_B, true>(mm, a, b,
                    c[nextSlot * TILE_ROWS * TILE_COLS], params, aOffset, bOffset, validRows, nextCol);
            }
            // 上次使用同一 GM 槽的数据已完成搬运和归约，才会再次提交到该槽。
            tile = inputQueue.DeQue<float>();
            // 每个 repeat 处理一行的至多64个float，行间跨度由列块宽度决定。
            // 只输出最值时 dstRepStride=1，结果连续存放，无须逐行经 Scalar 中转。
            const uint32_t halfColumns = TILE_COLS < 64 ? TILE_COLS : 64;
            const uint32_t firstColumns = validCols < halfColumns ? validCols : halfColumns;
            const uint32_t rowStride = TILE_COLS * sizeof(float) / 32;
            WholeReduceMax(reduced, tile, firstColumns, validRows, 1, 1, rowStride,
                ReduceOrder::ORDER_ONLY_VALUE);
            if (validCols > halfColumns) {
                WholeReduceMax(reduceTemp, tile[halfColumns], validCols - halfColumns,
                    validRows, 1, 1, rowStride, ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(reduced, reduced, reduceTemp, validRows);
            }
            PipeBarrier<PIPE_V>();
            // 第一块直接初始化，不能与0取Max，否则全负相似度会错误。
            if (colStart == firstCol) {
                Adds(rowMax, reduced, 0.0f, validRows);
            } else {
                Max(rowMax, rowMax, reduced, validRows);
            }
            PipeBarrier<PIPE_V>();
            inputQueue.FreeTensor(tile);
            // 诊断列块间状态复用：完成当前列块的全部流水后再推进下一轮。
            PipeBarrier<PIPE_ALL>();
        }

        auto output = outputQueue.AllocTensor<float>();
        if (splitN) {
            // 每个分片独占一个完整行块槽，尾行补零仅用于写满槽，不参与最终 Max/Sum。
            Duplicate(output, 0.0f, TILE_ROWS);
            PipeBarrier<PIPE_V>();
            Adds(output, rowMax, 0.0f, validRows);
        } else {
            Duplicate(output, 0.0f, PARTIAL_STRIDE);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(output, rowMax, static_cast<int32_t>(validRows), 1, 1, 1, 1);
        }
        outputQueue.EnQue(output);
        output = outputQueue.DeQue<float>();
        if (directOutput) {
            DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
            DataCopyPad(finalOutput[batch], output, copy);
        } else {
            DataCopy(scores[task * outputStride], output, outputStride);
        }
        outputQueue.FreeTensor(output);
    }

    if (directOutput) {
        return;
    }

    // 普通模式的AIC留在KFC服务循环，双主模式的AIC已执行完独立循环并返回。
    // 等待所有 Vector 核的局部结果落入 GM，再由 0 号核顺序完成最终归约。
    // 不能使用包含Cube的同步：普通模式的Cube仍在服务循环，双主模式已退出。
    if (params.cores > 1) {
        SyncAll<true>();
    } else {
        // 单核无需跨核屏障，但必须等待 partial 写回后才能读取。
        PipeBarrier<PIPE_ALL>();
    }
    if (GetBlockIdx() == 0) {
        if (splitN) {
            FinishSplitN<TILE_ROWS>(pipe, partial, y, params);
        } else {
            Finish(pipe, partial, y, params.rowTiles, params.batch);
        }
    }
}


__aicore__ constexpr auto MakeSplitKDualConfig()
{
    MatmulConfig config = CFG_NORM;
    config.enableMixDualMaster = true;
    config.basicM = 64;
    config.basicN = 64;
    config.basicK = 256;
    config.enableSetBias = false;
    // 探索分支仅保留FP16/TT的64×64×8192，K片长和L1参数仍为运行时值。
    using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half, true>;
    using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half, true>;
    using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
    auto tiling = AscendC::GetMatmulApiTiling<AType, BType, CType, CType>(config);
    tiling.M = 64;
    tiling.N = 64;
    tiling.Ka = 8192;
    tiling.Kb = 8192;
    tiling.singleCoreM = 64;
    tiling.singleCoreN = 64;
    return tiling;
}
constexpr auto SPLIT_K_DUAL_CONFIG = MakeSplitKDualConfig();

// 小输出大K矩阵按K分片，所有分片的逐元素FP32和完成后才允许归约N。
template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputeSplitK(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR partial, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, Parameters params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    constexpr uint32_t SIDE = 64;
    constexpr uint32_t MATRIX_ELEMENTS = SIDE * SIDE;
    TPipe pipe;
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, T, TRANS_A>,
        MatmulType<TPosition::GM, CubeFormat::ND, T, TRANS_B>,
        MatmulType<TPosition::GM, CubeFormat::ND, float>,
        MatmulType<TPosition::GM, CubeFormat::ND, float>, SPLIT_K_DUAL_CONFIG> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &params.cube);

    const uint32_t part = GetBlockIdx();
    const uint32_t partK = ((params.k + params.cores - 1) / params.cores + 15) / 16 * 16;
    const uint32_t firstK = part * partK;
    const uint32_t validK = params.k - firstK < partK ? params.k - firstK : partK;
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> partialDots;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    partialDots.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    const uint64_t aOffset = TRANS_A ? static_cast<uint64_t>(firstK) * params.m : firstK;
    const uint64_t bOffset = TRANS_B ? firstK : static_cast<uint64_t>(firstK) * params.n;
    // 原始K仍作为输入行距；SetTail只限定本片参与点积的K长度。
    mm.SetOrgShape(params.m, params.n, params.k, params.k, SIDE);
    mm.SetTail(params.m, params.n, validK);
    mm.SetTensorA(a[aOffset], TRANS_A);
    mm.SetTensorB(b[bOffset], TRANS_B);
    mm.template IterateAll<true>(partialDots[part * MATRIX_ELEMENTS]);
    mm.End();
    // 双主模式的Cube执行完本片后退出；后续只由Vector合并。
    if ASCEND_IS_AIC {
        return;
    }

    // 各Vector按行分工合并K片，逐元素加法顺序仍由片0到片末。
    SyncAll<true>();
    const uint32_t rowsPerCore = (params.m + params.cores - 1) / params.cores;
    const uint32_t firstRow = part * rowsPerCore;
    const uint32_t validRows = firstRow < params.m
        ? (params.m - firstRow < rowsPerCore ? params.m - firstRow : rowsPerCore) : 0;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> accumulatedBuffer;
    TBuf<TPosition::VECCALC> maximaBuffer;
    constexpr uint32_t MERGE_GROUP = 8;
    pipe.InitBuffer(inputQueue, 1, MERGE_GROUP * MATRIX_ELEMENTS * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(accumulatedBuffer, MATRIX_ELEMENTS * sizeof(float));
    pipe.InitBuffer(maximaBuffer, SIDE * sizeof(float));
    GlobalTensor<float> rowSums;
    rowSums.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    auto accumulated = accumulatedBuffer.Get<float>();
    const uint32_t count = validRows * SIDE;
    if (validRows > 0) {
        Duplicate(accumulated, 0.0f, count);
        PipeBarrier<PIPE_V>();
        for (uint32_t sourcePart = 0; sourcePart < params.cores; sourcePart += MERGE_GROUP) {
            const uint32_t remainingParts = params.cores - sourcePart;
            const uint32_t groupParts = remainingParts < MERGE_GROUP ? remainingParts : MERGE_GROUP;
            auto local = inputQueue.AllocTensor<float>();
            DataCopyParams copyParts{
                static_cast<uint16_t>(groupParts),
                static_cast<uint16_t>(count * sizeof(float) / 32),
                static_cast<uint16_t>((MATRIX_ELEMENTS - count) * sizeof(float) / 32), 0};
            DataCopy(local, partialDots[sourcePart * MATRIX_ELEMENTS + firstRow * SIDE], copyParts);
            inputQueue.EnQue(local);
            local = inputQueue.DeQue<float>();
            for (uint32_t groupPart = 0; groupPart < groupParts; ++groupPart) {
                Add(accumulated, accumulated, local[groupPart * count], count);
                PipeBarrier<PIPE_V>();
            }
            inputQueue.FreeTensor(local);
        }
    }
    auto result = outputQueue.AllocTensor<float>();
    if (validRows > 0) {
        auto maxima = maximaBuffer.Get<float>();
        WholeReduceMax(maxima, accumulated, params.n, validRows, 1, 1,
            SIDE * sizeof(float) / 32, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(result, maxima, validRows, 1, 1, 1, 1);
    } else {
        Duplicate(result, 0.0f, 8);
    }
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(rowSums[part], result, copy);
    outputQueue.FreeTensor(result);
    SyncAll<true>();
    if (part == 0) {
        auto local = inputQueue.AllocTensor<float>();
        DataCopyExtParams read{1, static_cast<uint32_t>(params.cores * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> padding{false, 0, 0, 0};
        DataCopyPad(local, rowSums, read, padding);
        inputQueue.EnQue(local);
        local = inputQueue.DeQue<float>();
        result = outputQueue.AllocTensor<float>();
        WholeReduceSum(result, local, params.cores, 1, 1, 1, 1);
        outputQueue.EnQue(result);
        result = outputQueue.DeQue<float>();
        DataCopyPad(output, result, copy);
        outputQueue.FreeTensor(result);
        inputQueue.FreeTensor(local);
    }
}


// 点15保持逐K片的确定性FP32合并顺序；每片按四个K256块使用双缓冲基础Cube计算。
__global__ __aicore__ void ComputePoint15ManualCube(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR partial, GM_ADDR y, Parameters params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    constexpr uint32_t SIDE = 64;
    constexpr uint32_t MATRIX_ELEMENTS = SIDE * SIDE;
    constexpr uint32_t FULL_K = 8192;
    constexpr uint32_t PART_K = 1024;
    constexpr uint32_t TILE_K = 256;
    TPipe pipe;
    const uint32_t part = GetBlockIdx();
    const uint32_t firstK = part * PART_K;
    const uint32_t validK = FULL_K - firstK < PART_K ? FULL_K - firstK : PART_K;
    GlobalTensor<float> partialDots;
    GlobalTensor<float> output;
    partialDots.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    if ASCEND_IS_AIC {
        TQue<TPosition::A1, 1> a1Queue;
        TQue<TPosition::B1, 1> b1Queue;
        TQue<TPosition::A2, 2> a2Queue;
        TQue<TPosition::B2, 2> b2Queue;
        TQue<TPosition::CO1, 1> c1Queue;
        pipe.InitBuffer(a1Queue, 1, SIDE * PART_K * sizeof(half));
        pipe.InitBuffer(b1Queue, 1, SIDE * PART_K * sizeof(half));
        pipe.InitBuffer(a2Queue, 2, SIDE * TILE_K * sizeof(half));
        pipe.InitBuffer(b2Queue, 2, SIDE * TILE_K * sizeof(half));
        pipe.InitBuffer(c1Queue, 1, MATRIX_ELEMENTS * sizeof(float));
        GlobalTensor<half> a, b;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + firstK * SIDE);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) + firstK);
        auto a1 = a1Queue.AllocTensor<half>();
        auto b1 = b1Queue.AllocTensor<half>();
        Nd2NzParams copyA{};
        copyA.ndNum = 1;
        copyA.nValue = validK;
        copyA.dValue = SIDE;
        copyA.srcDValue = SIDE;
        copyA.dstNzC0Stride = validK;
        copyA.dstNzNStride = 1;
        Nd2NzParams copyB{};
        copyB.ndNum = 1;
        copyB.nValue = SIDE;
        copyB.dValue = validK;
        copyB.srcDValue = FULL_K;
        copyB.dstNzC0Stride = SIDE;
        copyB.dstNzNStride = 1;
        DataCopy(a1, a, copyA);
        DataCopy(b1, b, copyB);
        a1Queue.EnQue(a1);
        b1Queue.EnQue(b1);
        a1 = a1Queue.DeQue<half>();
        b1 = b1Queue.DeQue<half>();
        auto c1 = c1Queue.AllocTensor<float>();
        for (uint32_t piece = 0; piece < PART_K / TILE_K; ++piece) {
            auto a2 = a2Queue.AllocTensor<half>();
            auto b2 = b2Queue.AllocTensor<half>();
            LoadData2DParams loadA{};
            loadA.repeatTimes = TILE_K / 16;
            loadA.srcStride = 1;
            loadA.ifTranspose = true;
            for (uint32_t rowBlock = 0; rowBlock < SIDE / 16; ++rowBlock) {
                LoadData(a2[rowBlock * TILE_K * 16],
                    a1[rowBlock * PART_K * 16 + piece * TILE_K * 16], loadA);
            }
            LoadData2DParams loadB{};
            loadB.repeatTimes = (TILE_K / 16) * (SIDE / 16);
            loadB.srcStride = 1;
            loadB.ifTranspose = false;
            LoadData(b2, b1[piece * TILE_K * SIDE], loadB);
            a2Queue.EnQue(a2);
            b2Queue.EnQue(b2);
            a2 = a2Queue.DeQue<half>();
            b2 = b2Queue.DeQue<half>();
            MmadParams multiply{};
            multiply.m = SIDE;
            multiply.n = SIDE;
            multiply.k = TILE_K;
            multiply.cmatrixInitVal = piece == 0;
            Mmad(c1, a2, b2, multiply);
            a2Queue.FreeTensor(a2);
            b2Queue.FreeTensor(b2);
        }
        a1Queue.FreeTensor(a1);
        b1Queue.FreeTensor(b1);
        c1Queue.EnQue(c1);
        c1 = c1Queue.DeQue<float>();
        FixpipeParamsV220 copyC{};
        copyC.nSize = SIDE;
        copyC.mSize = SIDE;
        copyC.srcStride = SIDE;
        copyC.dstStride = SIDE;
        copyC.ndNum = 1;
        copyC.quantPre = QuantMode_t::NoQuant;
        Fixpipe(partialDots[part * MATRIX_ELEMENTS], c1, copyC);
        CrossCoreSetFlag<0x2, PIPE_FIX>(0x8);
        c1Queue.FreeTensor(c1);
    }
    if ASCEND_IS_AIV {
    // 各Vector按行分工合并K片，逐元素加法顺序仍由片0到片末。
    const uint32_t rowsPerCore = (params.m + params.cores - 1) / params.cores;
    const uint32_t firstRow = part * rowsPerCore;
    const uint32_t validRows = firstRow < params.m
        ? (params.m - firstRow < rowsPerCore ? params.m - firstRow : rowsPerCore) : 0;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> accumulatedBuffer;
    TBuf<TPosition::VECCALC> maximaBuffer;
    constexpr uint32_t MERGE_GROUP = 8;
    pipe.InitBuffer(inputQueue, 1, MERGE_GROUP * MATRIX_ELEMENTS * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(accumulatedBuffer, MATRIX_ELEMENTS * sizeof(float));
    pipe.InitBuffer(maximaBuffer, SIDE * sizeof(float));
    GlobalTensor<float> rowSums;
    rowSums.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    auto accumulated = accumulatedBuffer.Get<float>();
    const uint32_t count = validRows * SIDE;
    // 本地队列与地址计算先完成，GM结果只在Cube和全核同步之后读取。
    CrossCoreWaitFlag(0x8);
    SyncAll<true>();
    if (validRows > 0) {
        if (params.cores != 8) {
            Duplicate(accumulated, 0.0f, count);
            PipeBarrier<PIPE_V>();
        }
        for (uint32_t sourcePart = 0; sourcePart < params.cores; sourcePart += MERGE_GROUP) {
            const uint32_t remainingParts = params.cores - sourcePart;
            const uint32_t groupParts = remainingParts < MERGE_GROUP ? remainingParts : MERGE_GROUP;
            auto local = inputQueue.AllocTensor<float>();
            DataCopyParams copyParts{
                static_cast<uint16_t>(groupParts),
                static_cast<uint16_t>(count * sizeof(float) / 32),
                static_cast<uint16_t>((MATRIX_ELEMENTS - count) * sizeof(float) / 32), 0};
            DataCopy(local, partialDots[sourcePart * MATRIX_ELEMENTS + firstRow * SIDE], copyParts);
            inputQueue.EnQue(local);
            local = inputQueue.DeQue<float>();
            if (params.cores == 8 && groupParts == 8) {
                // 固定二叉树，不使用原子加法；每个元素的加法顺序跨次调用一致。
                Add(accumulated, local, local[4 * count], 4 * count);
                PipeBarrier<PIPE_V>();
                Add(accumulated, accumulated, accumulated[2 * count], 2 * count);
                PipeBarrier<PIPE_V>();
                Add(accumulated, accumulated, accumulated[count], count);
                PipeBarrier<PIPE_V>();
            } else {
                for (uint32_t groupPart = 0; groupPart < groupParts; ++groupPart) {
                    Add(accumulated, accumulated, local[groupPart * count], count);
                    PipeBarrier<PIPE_V>();
                }
            }
            inputQueue.FreeTensor(local);
        }
    }
    auto result = outputQueue.AllocTensor<float>();
    if (validRows > 0) {
        auto maxima = maximaBuffer.Get<float>();
        WholeReduceMax(maxima, accumulated, params.n, validRows, 1, 1,
            SIDE * sizeof(float) / 32, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(result, maxima, validRows, 1, 1, 1, 1);
    } else {
        Duplicate(result, 0.0f, 8);
    }
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(rowSums[part], result, copy);
    outputQueue.FreeTensor(result);
    SyncAll<true>();
    if (part == 0) {
        auto local = inputQueue.AllocTensor<float>();
        DataCopyExtParams read{1, static_cast<uint32_t>(params.cores * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> padding{false, 0, 0, 0};
        DataCopyPad(local, rowSums, read, padding);
        inputQueue.EnQue(local);
        local = inputQueue.DeQue<float>();
        result = outputQueue.AllocTensor<float>();
        WholeReduceSum(result, local, params.cores, 1, 1, 1, 1);
        outputQueue.EnQue(result);
        result = outputQueue.DeQue<float>();
        DataCopyPad(output, result, copy);
        outputQueue.FreeTensor(result);
        inputQueue.FreeTensor(local);
    }
    }
}

// 按正式N分片规则估计单batch大矩阵的参与核数，不改变分片算法。
inline uint32_t EstimateLargeCores(int64_t m, int64_t n, uint32_t rows,
    uint32_t columns, int64_t availableCores)
{
    const int64_t rowTasks = (m + rows - 1) / rows;
    const int64_t columnTiles = (n + columns - 1) / columns;
    if (rowTasks * 2 > availableCores || columnTiles < 2) {
        return std::min<int64_t>(availableCores, rowTasks);
    }
    const int64_t maxParts = std::min<int64_t>(availableCores / rowTasks, columnTiles);
    const int64_t blocksPerPart = (columnTiles + maxParts - 1) / maxParts;
    const int64_t parts = (columnTiles + blocksPerPart - 1) / blocksPerPart;
    return std::min<int64_t>(availableCores, rowTasks * parts);
}

inline void CheckAcl(aclError code, const char* operation)
{
    if (code != ACL_SUCCESS) {
        throw std::runtime_error(std::string(operation) + ": " + std::to_string(code));
    }
}

// 普通调用在同步后释放；捕获调用的工作区必须存活到计算图销毁。
struct DeviceMemory {
    void* address = nullptr;
    ~DeviceMemory()
    {
        if (address != nullptr) {
            aclrtFree(address);
        }
    }
    void Allocate(size_t bytes)
    {
        CheckAcl(aclrtMalloc(&address, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
    }
};

struct KernelWorkspace {
    DeviceMemory scratch;
    DeviceMemory partial;
    DeviceMemory system;
};

void DestroyCapturedWorkspace(void* address)
{
    delete static_cast<KernelWorkspace*>(address);
}

void DestroyCapturedDeviceMemory(void* address)
{
    delete static_cast<DeviceMemory*>(address);
}

#if 0 // 完整通用分发暂不编译，保留以便后续恢复。
template <typename T, bool SPLIT_N, uint32_t TILE_ROWS, uint32_t TILE_COLS,
    bool DIRECT_RESULT, bool STATIC_BASE, uint32_t BASIC_COLS = TILE_COLS,
    uint32_t BASIC_ROWS = TILE_ROWS>
void LaunchConfigured(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch, GM_ADDR partial, GM_ADDR y, GM_ADDR workspace,
    const Parameters& params, aclrtStream stream, bool transA, bool transB)
{
    if (transA && transB) {
        Compute<T, true, true, SPLIT_N, TILE_ROWS, TILE_COLS, DIRECT_RESULT, STATIC_BASE,
            BASIC_COLS, BASIC_ROWS>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
    } else if (transA) {
        Compute<T, true, false, SPLIT_N, TILE_ROWS, TILE_COLS, DIRECT_RESULT, STATIC_BASE,
            BASIC_COLS, BASIC_ROWS>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
    } else if (transB) {
        Compute<T, false, true, SPLIT_N, TILE_ROWS, TILE_COLS, DIRECT_RESULT, STATIC_BASE,
            BASIC_COLS, BASIC_ROWS>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
    } else {
        Compute<T, false, false, SPLIT_N, TILE_ROWS, TILE_COLS, DIRECT_RESULT, STATIC_BASE,
            BASIC_COLS, BASIC_ROWS>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
    }
}

inline bool MatchesStaticBase(const Parameters& params, uint32_t rows, uint32_t columns)
{
    const uint32_t baseK = rows == DEFAULT_ROWS && columns == DEFAULT_COLS ? 128 : 64;
    return params.cube.baseM == rows && params.cube.baseN == columns
        && params.cube.baseK == baseK && params.cube.dbL0A == 2
        && params.cube.dbL0B == 2 && params.cube.isBias == 0;
}

template <typename T>
void LaunchGeneric(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch, GM_ADDR partial, GM_ADDR y,
    GM_ADDR workspace, const Parameters& params, aclrtStream stream,
    bool transA, bool transB, bool splitN)
{
    GenericParameters generic{};
    generic.base = params;
    generic.splitN = splitN;
    generic.directOutput = !splitN && params.rowTiles == 1;
    generic.parts = splitN ? params.cores / (params.batch * params.rowTiles) : 1;
    generic.partialStride = splitN ? DEFAULT_ROWS : PARTIAL_STRIDE;
    if (transA && transB) {
        ComputeGeneric<T, true, true><<<params.cores, nullptr, stream>>>(
            x1, x2, scratch, partial, y, workspace, generic);
    } else if (transA) {
        ComputeGeneric<T, true, false><<<params.cores, nullptr, stream>>>(
            x1, x2, scratch, partial, y, workspace, generic);
    } else if (transB) {
        ComputeGeneric<T, false, true><<<params.cores, nullptr, stream>>>(
            x1, x2, scratch, partial, y, workspace, generic);
    } else {
        ComputeGeneric<T, false, false><<<params.cores, nullptr, stream>>>(
            x1, x2, scratch, partial, y, workspace, generic);
    }
}

template <typename T>
void LaunchByShapeKey(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch, GM_ADDR partial, GM_ADDR y,
    GM_ADDR workspace, const Parameters& params, aclrtStream stream, bool transA, bool transB,
    ShapeKey key, bool splitN, bool genericFallback)
{
    if (genericFallback) {
        LaunchGeneric<T>(x1, x2, scratch, partial, y, workspace,
            params, stream, transA, transB, splitN);
        return;
    }
    if (key == ShapeKey::SPLIT_K) {
        if (transA && transB) {
            ComputeSplitK<T, true, true><<<params.cores, nullptr, stream>>>(
                x1, x2, scratch, partial, y, workspace, params);
        } else if (transA) {
            ComputeSplitK<T, true, false><<<params.cores, nullptr, stream>>>(
                x1, x2, scratch, partial, y, workspace, params);
        } else if (transB) {
            ComputeSplitK<T, false, true><<<params.cores, nullptr, stream>>>(
                x1, x2, scratch, partial, y, workspace, params);
        } else {
            ComputeSplitK<T, false, false><<<params.cores, nullptr, stream>>>(
                x1, x2, scratch, partial, y, workspace, params);
        }

    } else if (key == ShapeKey::LARGE_BALANCED) {
        if (splitN) {
            LaunchConfigured<T, true, LARGE_BALANCED_ROWS, LARGE_BALANCED_COLS, false, true,
                LARGE_BALANCED_BASE_COLS, LARGE_BALANCED_BASE_ROWS>(x1, x2, scratch, partial, y, workspace,
                params, stream, transA, transB);
        } else {
            LaunchConfigured<T, false, LARGE_BALANCED_ROWS, LARGE_BALANCED_COLS, false, true,
                LARGE_BALANCED_BASE_COLS, LARGE_BALANCED_BASE_ROWS>(x1, x2, scratch, partial, y, workspace,
                params, stream, transA, transB);
        }
    } else if (key == ShapeKey::LARGE_TALL) {
        LaunchConfigured<T, true, 256, 128, false, true>(x1, x2, scratch, partial, y,
            workspace, params, stream, transA, transB);
    } else if (key == ShapeKey::TALL_NARROW) {
        LaunchConfigured<T, false, 512, 64, false, false>(x1, x2, scratch, partial, y,
            workspace, params, stream, transA, transB);
    } else if (key == ShapeKey::WIDE_SHALLOW) {
        LaunchConfigured<T, true, 64, 256, false, false>(x1, x2, scratch, partial, y,
            workspace, params, stream, transA, transB);
    } else {
        LaunchConfigured<T, false, 32, 128, false, true>(x1, x2, scratch, partial, y,
            workspace, params, stream, transA, transB);
    }
}

template <typename T>
void LaunchPackedDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t m, uint32_t n, uint32_t k,
    aclrtStream stream, bool transA, bool transB)
{
    if (transA && transB) {
        ComputePackedDots<T, true, true><<<1, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else if (transA) {
        ComputePackedDots<T, true, false><<<1, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else if (transB) {
        ComputePackedDots<T, false, true><<<1, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else {
        ComputePackedDots<T, false, false><<<1, nullptr, stream>>>(x1, x2, y, m, n, k);
    }
}

template <typename T, bool COMPACT_K>
void LaunchSmallBatchDotsByLayout(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, aclrtStream stream, bool transA, bool transB)
{
    if (transA && transB) {
        ComputeSmallBatchDots<T, true, true, COMPACT_K>
            <<<batch, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else if (transA) {
        ComputeSmallBatchDots<T, true, false, COMPACT_K>
            <<<batch, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else if (transB) {
        ComputeSmallBatchDots<T, false, true, COMPACT_K>
            <<<batch, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else {
        ComputeSmallBatchDots<T, false, false, COMPACT_K>
            <<<batch, nullptr, stream>>>(x1, x2, y, m, n, k);
    }
}

template <typename T>
void LaunchSmallBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, aclrtStream stream, bool transA, bool transB)
{
    if ((k & 15u) == 0) {
        LaunchSmallBatchDotsByLayout<T, true>(x1, x2, y, batch, m, n, k,
            stream, transA, transB);
    } else {
        LaunchSmallBatchDotsByLayout<T, false>(x1, x2, y, batch, m, n, k,
            stream, transA, transB);
    }
}

template <typename T>
void LaunchMediumBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR staging, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, aclrtStream stream, bool transA, bool transB)
{
    const uint32_t rowTiles = (m + MEDIUM_BATCH_ROW_TILE - 1) / MEDIUM_BATCH_ROW_TILE;
    const uint32_t taskCount = batch * rowTiles;
    if (transA && transB) {
        ComputeMediumBatchDots<T, true, true>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else if (transA) {
        ComputeMediumBatchDots<T, true, false>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else if (transB) {
        ComputeMediumBatchDots<T, false, true>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else {
        ComputeMediumBatchDots<T, false, false>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    }
}

template <typename T>
void LaunchLargeBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR staging, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, aclrtStream stream, bool transA, bool transB)
{
    const uint32_t rowTiles = (m + LARGE_BATCH_M_TILE - 1) / LARGE_BATCH_M_TILE;
    const uint32_t colTiles = (n + LARGE_BATCH_COL_TILE - 1) / LARGE_BATCH_COL_TILE;
    const uint32_t taskCount = batch * rowTiles * colTiles;
    if (transA && transB) {
        ComputeLargeBatchDots<T, true, true>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else if (transA) {
        ComputeLargeBatchDots<T, true, false>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else if (transB) {
        ComputeLargeBatchDots<T, false, true>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else {
        ComputeLargeBatchDots<T, false, false>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    }
}

#endif

inline bool MatchesStaticBase(const Parameters& params, uint32_t rows, uint32_t columns)
{
    const uint32_t baseK = rows == DEFAULT_ROWS && columns == DEFAULT_COLS ? 128 : 64;
    return params.cube.baseM == rows && params.cube.baseN == columns
        && params.cube.baseK == baseK && params.cube.dbL0A == 2
        && params.cube.dbL0B == 2 && params.cube.isBias == 0;
}

// 探索分支：只编译已确认的类型、布局与调度组合。
// 原分发完整保留在上方禁用区；恢复通用覆盖时再逐组启用。
void LaunchExploration(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch, GM_ADDR partial,
    GM_ADDR y, GM_ADDR workspace, const Parameters& params, aclrtStream stream,
    bool fp16, bool transA, bool transB, ShapeKey key, bool splitN, bool genericFallback)
{
    if (!fp16 && !transA && transB && params.batch == 13
        && params.m == 23 && params.n == 73 && params.k == 192
        && params.cores >= params.batch) {
        ComputePoint6ManualCube<<<params.batch, nullptr, stream>>>(x1, x2, scratch, y);
        return;
    }
    if (fp16 && transA && !transB && params.batch == 16
        && params.m == 32 && params.n == 128 && params.k == 256
        && params.cores >= params.batch) {
        ComputePoint7ManualCube<<<params.batch, nullptr, stream>>>(x1, x2, scratch, y);
        return;
    }
    if (genericFallback) {
        throw std::invalid_argument("BatchMatmulMaxSum: generic path not compiled in exploration branch");
    }
    if (fp16 && !transA && !transB && key == ShapeKey::DEFAULT && !splitN) {
        Compute<half, false, false, false, 32, 128, false, true>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (fp16 && transA && !transB && key == ShapeKey::DEFAULT && !splitN) {
        Compute<half, true, false, false, 32, 128, false, true>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (!fp16 && !transA && transB && key == ShapeKey::DEFAULT && !splitN) {
        Compute<bfloat16_t, false, true, false, 32, 128, false, true>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (!fp16 && transA && transB && key == ShapeKey::LARGE_BALANCED && splitN
        && params.batch == 1 && params.m == 1025 && params.n == 1031 && params.k == 1032
        && params.rowTiles == 9 && params.cores == 18) {
        ComputePoint8ManualCube<<<params.cores, nullptr, stream>>>(
            x1, x2, scratch, partial, y, params);
        return;
    }
    if (!fp16 && transA && transB && key == ShapeKey::LARGE_BALANCED && splitN) {
        Compute<bfloat16_t, true, true, true, LARGE_BALANCED_ROWS, LARGE_BALANCED_COLS, false, true,
            LARGE_BALANCED_BASE_COLS, LARGE_BALANCED_BASE_ROWS>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (fp16 && !transA && transB && key == ShapeKey::LARGE_BALANCED && !splitN
        && params.batch == 1 && params.m == 2048 && params.n == 1536 && params.k == 1280
        && params.rowTiles == 19 && params.cores == 19) {
        Compute<half, false, true, false, 112, 1024, false, true, 256, 112>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (fp16 && !transA && transB && key == ShapeKey::LARGE_BALANCED && !splitN) {
        Compute<half, false, true, false, LARGE_BALANCED_ROWS, 1024, false, true,
            LARGE_BALANCED_BASE_COLS, LARGE_BALANCED_BASE_ROWS>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (!fp16 && !transA && !transB && key == ShapeKey::LARGE_BALANCED && !splitN
        && params.batch == 1 && params.m == 4096 && params.n == 1280 && params.k == 1152
        && params.rowTiles == 20 && params.cores == 20) {
        Compute<bfloat16_t, false, false, false, 208, 1024, false, true, 128, 208>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (!fp16 && !transA && !transB && key == ShapeKey::LARGE_BALANCED && !splitN) {
        Compute<bfloat16_t, false, false, false, LARGE_BALANCED_ROWS, 1024, false, true,
            LARGE_BALANCED_BASE_COLS, LARGE_BALANCED_BASE_ROWS>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (fp16 && transA && transB && key == ShapeKey::LARGE_TALL && splitN) {
        ComputeSwappedTT<half, 256, 688, 128, 256>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (!fp16 && transA && !transB && key == ShapeKey::LARGE_BALANCED && splitN) {
        Compute<bfloat16_t, true, false, true, LARGE_BALANCED_ROWS, 1024, false, true,
            LARGE_BALANCED_BASE_COLS, LARGE_BALANCED_BASE_ROWS>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (fp16 && !transA && !transB && key == ShapeKey::TALL_NARROW && !splitN
        && params.batch == 1 && params.m == 8192 && params.n == 64 && params.k == 128
        && params.rowTiles == 20 && params.cores == 20) {
        ComputePoint13ManualCube<<<params.cores, nullptr, stream>>>(
            x1, x2, scratch, partial, y, params);
        return;
    }
    if (fp16 && !transA && !transB && key == ShapeKey::TALL_NARROW && !splitN) {
        Compute<half, false, false, false, 416, 64, false, false>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (!fp16 && !transA && transB && key == ShapeKey::WIDE_SHALLOW && splitN
        && params.batch == 1 && params.m == 64 && params.n == 8192 && params.k == 128
        && params.rowTiles == 1 && params.cores == 16) {
        ComputePoint14ManualCube<<<params.cores, nullptr, stream>>>(
            x1, x2, scratch, partial, y, params);
        return;
    }
    if (!fp16 && !transA && transB && key == ShapeKey::WIDE_SHALLOW && splitN) {
        Compute<bfloat16_t, false, true, true, 64, 512, false, false, 256, 64>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    if (fp16 && transA && transB && key == ShapeKey::SPLIT_K && !splitN
        && params.batch == 1 && params.m == 64 && params.n == 64 && params.k == 8192
        && params.cores == 8) {
        ComputePoint15ManualCube<<<params.cores, nullptr, stream>>>(
            x1, x2, scratch, partial, y, params);
        return;
    }
    if (fp16 && transA && transB && key == ShapeKey::SPLIT_K && !splitN) {
        ComputeSplitK<half, true, true><<<params.cores, nullptr, stream>>>(
            x1, x2, scratch, partial, y, workspace, params);
        return;
    }
    throw std::invalid_argument("BatchMatmulMaxSum: dispatch variant not compiled in exploration branch");
}

} // namespace batch_max_sum

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    using namespace batch_max_sum;
    const auto& a = info_x1.tensors[0];
    const auto& b = info_x2.tensors[0];
    if (a.numDims != 3 || b.numDims != 3 || a.dtype != b.dtype || (a.dtype != 1 && a.dtype != 2)) {
        throw std::invalid_argument("BatchMatmulMaxSum: invalid input rank or dtype");
    }
    const int64_t batch = a.shape[0];
    const int64_t m = a.shape[transposeX1 ? 2 : 1];
    const int64_t k = a.shape[transposeX1 ? 1 : 2];
    const int64_t n = b.shape[transposeX2 ? 1 : 2];
    if (batch < 1 || batch > 64 || m < 1 || m > 8192 || n < 1 || n > 8192
        || k < 32 || k > 8192 || k % 8 != 0 || b.shape[0] != batch
        || b.shape[transposeX2 ? 2 : 1] != k || batch * m * k > (1LL << 26)
        || batch * n * k > (1LL << 26) || availableCoreNum <= 0
        || info_y.tensors[0].dtype != 0 || info_y.tensors[0].numDims != 1
        || info_y.tensors[0].shape[0] != batch) {
        throw std::invalid_argument("BatchMatmulMaxSum: invalid shape or core count");
    }
    const bool manualSmall5 = batch >= 5 && batch <= 8 && m <= 16 && n <= 32
        && k == 128 && a.dtype == 1 && !transposeX1 && !transposeX2;
    if (manualSmall5) {
        aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
        aclmdlRI capturedModel = nullptr;
        CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel), "aclmdlRICaptureGetInfo");
        const bool capturing = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
        std::unique_ptr<DeviceMemory> scratchMemory(new DeviceMemory);
        scratchMemory->Allocate(static_cast<size_t>(batch) * 16 * 32 * sizeof(float));
        auto scratch = (GM_ADDR)scratchMemory->address;
        if (capturing) {
            CheckAcl(aclmdlRIDestroyRegisterCallback(capturedModel, DestroyCapturedDeviceMemory,
                scratchMemory.get()), "aclmdlRIDestroyRegisterCallback");
            scratchMemory.release();
        }
        ComputeSmallManualCube<half, false, false, 32><<<batch, nullptr, stream>>>(
            x1, x2, scratch, y, static_cast<uint32_t>(m), static_cast<uint32_t>(n));
        if (!capturing) {
            CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
        return;
    }
    const bool smallVector = batch == 1 && k <= SMALL_VECTOR_K_LIMIT
        && m * n <= SMALL_VECTOR_OUTPUT_LIMIT;
    if (smallVector) {
        aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
        aclmdlRI capturedModel = nullptr;
        CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel), "aclmdlRICaptureGetInfo");
#if 0 // 保留其他点积类型和布局，暂不实例化。
        if (m == 1 && n == 1 && k == 32 && a.dtype == 1) {
            ComputeDot32<half><<<1, nullptr, stream>>>(x1, x2, y);
        } else if (m == 1 && n == 1 && a.dtype == 1) {
            ComputeDot<half><<<1, nullptr, stream>>>(x1, x2, y, static_cast<uint32_t>(k));
        } else if (a.dtype == 1) {
            LaunchPackedDots<half>(x1, x2, y, static_cast<uint32_t>(m), static_cast<uint32_t>(n),
                static_cast<uint32_t>(k), stream, transposeX1, transposeX2);
        } else {
            LaunchPackedDots<bfloat16_t>(x1, x2, y, static_cast<uint32_t>(m), static_cast<uint32_t>(n),
                static_cast<uint32_t>(k), stream, transposeX1, transposeX2);
        }
#else
        if (m == 1 && n == 1 && k == 32 && a.dtype == 1) {
            ComputeDot32<half><<<4, nullptr, stream>>>(x1, x2, y);
        } else if (a.dtype == 2 && transposeX1 && !transposeX2) {
            if (batch == 1 && m == 3 && n == 5 && k == 40) {
                ComputePackedDotsFixed<bfloat16_t, true, false><<<1, nullptr, stream>>>(
                    x1, x2, y, static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k));
            } else {
                ComputePackedDots<bfloat16_t, true, false><<<1, nullptr, stream>>>(
                    x1, x2, y, static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k));
            }
        } else {
            throw std::invalid_argument("BatchMatmulMaxSum: vector variant not compiled in exploration branch");
        }
#endif
        if (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE) {
            CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
        return;
    }
    const bool smallBatchVector = batch >= 2 && batch <= SMALL_BATCH_LIMIT
        && m <= SMALL_BATCH_M_LIMIT && n <= SMALL_BATCH_N_LIMIT
        && k <= SMALL_VECTOR_K_LIMIT;
    if (smallBatchVector) {
        aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
        aclmdlRI capturedModel = nullptr;
        CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel), "aclmdlRICaptureGetInfo");
#if 0 // 保留其他类型和布局，暂不实例化。
        if (a.dtype == 1) {
            LaunchSmallBatchDots<half>(x1, x2, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        } else {
            LaunchSmallBatchDots<bfloat16_t>(x1, x2, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        }
#else
        if (!(a.dtype == 1 && !transposeX1 && transposeX2 && (k & 15u) == 0)) {
            throw std::invalid_argument("BatchMatmulMaxSum: vector variant not compiled in exploration branch");
        }
        ComputeSmallBatchDots<half, false, true, true><<<batch, nullptr, stream>>>(
            x1, x2, y, static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k));
#endif
        if (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE) {
            CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
        return;
    }
    const bool mediumVectorOnMixedTask = batch >= 2 && batch <= 4
        && m <= 16 && n <= 16
        && k >= MEDIUM_BATCH_K_TILE && k <= MEDIUM_BATCH_K_LIMIT
        && (k & 63u) == 0;
    if (mediumVectorOnMixedTask) {
        aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
        aclmdlRI capturedModel = nullptr;
        CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel), "aclmdlRICaptureGetInfo");
        const bool capturing = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
        std::unique_ptr<DeviceMemory> stagingMemory(new DeviceMemory);
        const uint32_t rowTiles = (static_cast<uint32_t>(m) + MEDIUM_BATCH_ROW_TILE - 1)
            / MEDIUM_BATCH_ROW_TILE;
        stagingMemory->Allocate(static_cast<size_t>(batch) * rowTiles
            * MEDIUM_BATCH_OUTPUT_STRIDE * sizeof(float));
        auto stagingAddress = (GM_ADDR)stagingMemory->address;
        if (capturing) {
            CheckAcl(aclmdlRIDestroyRegisterCallback(capturedModel, DestroyCapturedDeviceMemory,
                stagingMemory.get()), "aclmdlRIDestroyRegisterCallback");
            stagingMemory.release();
        }
#if 0 // 保留其他类型和布局，暂不实例化。
        if (a.dtype == 1) {
            LaunchMediumBatchDots<half>(x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        } else {
            LaunchMediumBatchDots<bfloat16_t>(x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        }
#else
        if (!(a.dtype == 2 && transposeX1 && transposeX2)) {
            throw std::invalid_argument("BatchMatmulMaxSum: vector variant not compiled in exploration branch");
        }
        if (batch == 4 && m == 16 && n == 16 && k == 128) {
            ComputeBatchDirectDotsFixed<bfloat16_t, true, true><<<batch, nullptr, stream>>>(
                x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k));
        } else {
            ComputeBatchDirectDots<bfloat16_t, true, true><<<batch, nullptr, stream>>>(
                x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k));
        }
#endif
        if (!capturing) {
            CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
        return;
    }
    // 仅精确匹配的紧凑矩阵试用既有32x128双主Cube路径，其余仍走动态Vector。
    const bool point5Cube = batch == 8 && m == 16 && n == 32 && k == 128
        && a.dtype == 1 && !transposeX1 && !transposeX2;
    const bool compactBatchVector = !point5Cube && batch >= 5 && batch <= 8
        && m <= 16 && n <= 32
        && k >= LARGE_BATCH_K_TILE && k <= MEDIUM_BATCH_K_LIMIT
        && (k & 63u) == 0;
    if (compactBatchVector) {
        aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
        aclmdlRI capturedModel = nullptr;
        CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel),
            "aclmdlRICaptureGetInfo");
        const bool capturing = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
        std::unique_ptr<DeviceMemory> stagingMemory(new DeviceMemory);
        const uint32_t rowTiles = (static_cast<uint32_t>(m) + LARGE_BATCH_M_TILE - 1)
            / LARGE_BATCH_M_TILE;
        const uint32_t colTiles = (static_cast<uint32_t>(n) + LARGE_BATCH_COL_TILE - 1)
            / LARGE_BATCH_COL_TILE;
        stagingMemory->Allocate(static_cast<size_t>(batch) * rowTiles * colTiles
            * LARGE_BATCH_M_TILE * sizeof(float));
        auto stagingAddress = (GM_ADDR)stagingMemory->address;
        if (capturing) {
            CheckAcl(aclmdlRIDestroyRegisterCallback(capturedModel, DestroyCapturedDeviceMemory,
                stagingMemory.get()), "aclmdlRIDestroyRegisterCallback");
            stagingMemory.release();
        }
#if 0 // 保留其他类型和布局，暂不实例化。
        if (a.dtype == 1) {
            LaunchLargeBatchDots<half>(x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        } else {
            LaunchLargeBatchDots<bfloat16_t>(x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        }
#else
        if (!(a.dtype == 1 && !transposeX1 && !transposeX2)) {
            throw std::invalid_argument("BatchMatmulMaxSum: vector variant not compiled in exploration branch");
        }
        ComputeBatchDirectDots<half, false, false><<<batch, nullptr, stream>>>(
            x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
            static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k));
#endif
        if (!capturing) {
            CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
        return;
    }
    ShapeKey shapeKey = ShapeKey::DEFAULT;
    uint32_t tileRows = DEFAULT_ROWS;
    uint32_t tileCols = DEFAULT_COLS;
    if (!point5Cube && batch >= 2 && batch <= 8 && m <= 16 && n <= 32
        && k > SMALL_VECTOR_K_LIMIT && k <= 128) {
        tileRows = 16;
        if (n <= 16) {
            shapeKey = ShapeKey::COMPACT_16;
            tileCols = 16;
        } else {
            shapeKey = ShapeKey::COMPACT_32;
            tileCols = 32;
        }
    } else if (batch == 1 && m <= 64 && n <= 64 && k >= 4096
        && availableCoreNum >= 2) {
        shapeKey = ShapeKey::SPLIT_K;
        tileRows = 64;
        tileCols = 64;
    } else if (batch == 1 && m >= 1024 && n >= 512) {
        const uint32_t cores128 = EstimateLargeCores(
            m, n, LARGE_BALANCED_ROWS, LARGE_BALANCED_BASE_COLS, availableCoreNum);
        const uint32_t cores256 = EstimateLargeCores(m, n, 256, 128, availableCoreNum);
        // 只有参与核数至少增加25%时采用更高行块，否则保留均衡块。
        if (cores256 * 4 >= cores128 * 5) {
            shapeKey = ShapeKey::LARGE_TALL;
            tileRows = 256;
            tileCols = 256;
        } else {
            shapeKey = ShapeKey::LARGE_BALANCED;
            tileRows = LARGE_BALANCED_ROWS;
            tileCols = LARGE_BALANCED_COLS;
        }
    } else if (n <= 64 && m >= 64) {
        shapeKey = ShapeKey::TALL_NARROW;
        if (m >= 512) {
            // 用416行分块将8192行划为20个任务，减少空闲Cube核。
            tileRows = 416;
        } else if (m >= 256) {
            tileRows = 256;
        } else if (m >= 128) {
            tileRows = 128;
        } else {
            tileRows = 64;
        }
        tileCols = 64;
    } else if (m <= 64 && n >= 512) {
        shapeKey = ShapeKey::WIDE_SHALLOW;
        tileRows = 64;
        tileCols = 512;
    }

    // 完整K的均衡大块加宽逻辑N，Matmul内部复用A，物理块仍为128×256。
    if (shapeKey == ShapeKey::LARGE_BALANCED && k % 64 == 0) {
        tileCols = 1024;
    }
    // 点9交换输出实验较慢，关闭并保留代码以便对照；继续使用原NT路径。
    constexpr bool swappedNT = false;
    const bool swappedTT = swappedNT || (batch == 1 && a.dtype == 1 && transposeX1 && transposeX2
        && m >= 1024 && n >= 512);
    if (swappedTT) {
        shapeKey = a.dtype == 1 ? ShapeKey::LARGE_TALL : ShapeKey::LARGE_BALANCED;
        tileRows = a.dtype == 1 ? 256 : 128;
        tileCols = a.dtype == 1 ? 688 : 528;
    }
    if (swappedNT) {
        shapeKey = ShapeKey::LARGE_BALANCED;
        tileRows = 112;
        tileCols = 1536;
    }
    constexpr bool point12Rows64 = false; // R18行块64实验较慢，恢复原128行两路N分片。
    if (point12Rows64) {
        shapeKey = ShapeKey::LARGE_BALANCED;
        tileRows = 64;
        tileCols = 1024;
    }
    const bool point9Rows112 = batch == 1 && a.dtype == 1 && !transposeX1 && transposeX2
        && m == 2048 && n == 1536 && k == 1280 && availableCoreNum >= 19;
    if (point9Rows112) {
        shapeKey = ShapeKey::LARGE_BALANCED;
        tileRows = 112;
        tileCols = 1024;
    }
    const bool point10Rows208 = batch == 1 && a.dtype != 1 && !transposeX1 && !transposeX2
        && m == 4096 && n == 1280 && k == 1152 && availableCoreNum >= 20;
    if (point10Rows208) {
        shapeKey = ShapeKey::LARGE_BALANCED;
        tileRows = 208;
        tileCols = 1024;
    }
    Parameters params{};
    params.batch = batch;
    params.m = m;
    params.n = n;
    params.k = k;
    params.rowTiles = (m + tileRows - 1) / tileRows;
    const int64_t rowTasks = batch * params.rowTiles;
    const int64_t columnTiles = (n + tileCols - 1) / tileCols;
    // 大矩阵允许两路N分片，利用128行块减少行任务后留下的空闲核。
    // 其他路径保持原四路门槛；每片至少一个列块，所有分片一轮落到可用核上。
    const bool largeMatrix = shapeKey == ShapeKey::LARGE_BALANCED || shapeKey == ShapeKey::LARGE_TALL;
    const uint32_t minimumParts = largeMatrix ? 2 : MIN_N_PARTS;
    bool splitN = rowTasks * minimumParts <= availableCoreNum && columnTiles >= minimumParts;
    const uint32_t maxParts = splitN
        ? std::min<int64_t>(availableCoreNum / rowTasks, columnTiles) : 1;
    // 保持最慢分片的列块数不增加，减少不能缩短临界路径的额外分片。
    // 例如 64 个列块、20 个空闲核：每片上限均为4块，16片即可覆盖。
    const uint32_t blocksPerPart = (columnTiles + maxParts - 1) / maxParts;
    uint32_t parts = splitN ? (columnTiles + blocksPerPart - 1) / blocksPerPart : 1;
    params.cores = std::min<int64_t>(availableCoreNum, rowTasks * parts);
    if (shapeKey == ShapeKey::SPLIT_K) {
        params.cores = std::min<int64_t>(availableCoreNum, (k + 1023) / 1024);
    }

    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance(aclrtGetSocName());
    if (platform == nullptr) {
        throw std::runtime_error("BatchMatmulMaxSum: cannot query platform");
    }
    matmul_tiling::MatmulApiTiling tiling(*platform);
    const auto dtype = a.dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                                   : matmul_tiling::DataType::DT_BF16;
    tiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype,
        swappedTT ? false : transposeX1);
    tiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype,
        swappedTT ? swappedNT : transposeX2);
    tiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT);
    // 固定基础块不能大于单核计算块；有效尺寸在核内通过 SetTail 指定。
    const int64_t singleCoreK = shapeKey == ShapeKey::SPLIT_K
        ? ((k + params.cores - 1) / params.cores + 15) / 16 * 16 : k;
    const uint32_t baseTileRows = point10Rows208 ? 208 : point9Rows112 ? 112 : point12Rows64 ? 64 : (shapeKey == ShapeKey::LARGE_BALANCED
        ? LARGE_BALANCED_BASE_ROWS : tileRows);
    const uint32_t baseTileCols = point10Rows208 ? 128 : shapeKey == ShapeKey::LARGE_BALANCED
        ? LARGE_BALANCED_BASE_COLS : tileCols;
    tiling.SetShape(swappedTT ? tileCols : tileRows,
        swappedTT ? tileRows : tileCols, singleCoreK);
    tiling.SetOrgShape(swappedTT ? n : m, swappedTT ? m : n, k);
    tiling.SetFixSplit(swappedTT ? (swappedNT ? 256 : (a.dtype == 1 ? 128 : 256)) : baseTileRows,
        swappedTT ? (swappedNT ? 112 : (a.dtype == 1 ? 256 : 128)) : (shapeKey == ShapeKey::LARGE_TALL ? 128
            : (shapeKey == ShapeKey::WIDE_SHALLOW ? 256 : baseTileCols)));
    tiling.SetBias(false);
    tiling.SetBufferSpace(-1, -1, -1);
    if (tiling.GetTiling(params.cube) != 0) {
        throw std::runtime_error("BatchMatmulMaxSum: Matmul tiling failed");
    }

    // 大矩阵每个基本块只覆盖一块M/N；让A/B以相同的K批量搬入L1，
    // 减少一侧stepK=1时的细碎MTE2搬运。保持baseK和MMAD累加顺序。
    // 依照TCubeTiling约束：stepM/stepN=1，depth=stepK*2，A/B迭代数相等。
    // 探索：尾K也使用对称分段，避免点8保留A全载造成搬运等待。
    constexpr int32_t LARGE_K_STEP = 4;
    if (!point10Rows208 && largeMatrix && params.cube.stepM == 1 && params.cube.stepN == 1
        && params.cube.baseK > 0 && singleCoreK >= params.cube.baseK * LARGE_K_STEP) {
        uint64_t l1Bytes = 0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1Bytes);
        const uint64_t requiredBytes = static_cast<uint64_t>(params.cube.baseM + params.cube.baseN)
            * params.cube.baseK * LARGE_K_STEP * 2 * sizeof(uint16_t);
        if (requiredBytes <= l1Bytes) {
            params.cube.stepKa = LARGE_K_STEP;
            params.cube.stepKb = LARGE_K_STEP;
            params.cube.depthA1 = LARGE_K_STEP * 2;
            params.cube.depthB1 = LARGE_K_STEP * 2;
        }
    }

    // K有基础块尾部时保留A全载，只合并B的细碎搬运；完整K块沿用上面的四块策略。
    // A只有一轮K加载，B的迭代数与之天然成整数倍；B使用两个三块L1缓冲。
    constexpr int32_t TAIL_B_K_STEP = 3;
    if (largeMatrix && params.cube.stepM == 1 && params.cube.stepN == 1
        && params.cube.baseK > 0 && singleCoreK % params.cube.baseK != 0
        && singleCoreK > params.cube.baseK * TAIL_B_K_STEP
        && singleCoreK <= static_cast<int64_t>(params.cube.baseK) * params.cube.stepKa
        && params.cube.stepKb > 0 && params.cube.stepKb < TAIL_B_K_STEP) {
        uint64_t l1Bytes = 0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1Bytes);
        const uint64_t requiredBytes = (static_cast<uint64_t>(params.cube.baseM)
            * params.cube.depthA1 + static_cast<uint64_t>(params.cube.baseN) * TAIL_B_K_STEP * 2)
            * params.cube.baseK * sizeof(uint16_t);
        if (requiredBytes <= l1Bytes) {
            params.cube.stepKb = TAIL_B_K_STEP;
            params.cube.depthB1 = TAIL_B_K_STEP * 2;
        }
    }

    // 宽逻辑N块在片内重复使用A；完整K时尝试A全载，B保留双缓冲。
    // A只有一轮K迭代，因此与B任意正整数迭代数满足MDL整数倍约束。
    if (a.dtype != 1 && shapeKey == ShapeKey::LARGE_BALANCED && singleCoreK % 64 == 0
        && (params.cube.baseM == 128 || point12Rows64) && params.cube.baseN == 256
        && params.cube.baseK == 64 && params.cube.stepM == 1 && params.cube.stepN == 1) {
        uint64_t l1Bytes = 0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1Bytes);
        const int32_t fullAK = (singleCoreK + params.cube.baseK - 1) / params.cube.baseK;
        const int32_t initialStepB = point12Rows64 ? 4 : 2;
        for (int32_t stepB = initialStepB; stepB >= 1; --stepB) {
            const uint64_t requiredBytes = (static_cast<uint64_t>(params.cube.baseM) * fullAK
                + static_cast<uint64_t>(params.cube.baseN) * stepB * 2)
                * params.cube.baseK * sizeof(uint16_t);
            if (requiredBytes <= l1Bytes) {
                params.cube.stepKa = fullAK;
                params.cube.depthA1 = fullAK;
                params.cube.stepKb = stepB;
                params.cube.depthB1 = stepB * 2;
                break;
            }
        }
    }

    // 右侧为原A的112行：完整K驻留L1并跨六个M块复用，左侧双缓冲两块K。
    if (swappedNT) {
        const int32_t fullBK = (singleCoreK + params.cube.baseK - 1) / params.cube.baseK;
        uint64_t l1Bytes = 0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1Bytes);
        const uint64_t requiredBytes = (static_cast<uint64_t>(params.cube.baseM) * 4
            + static_cast<uint64_t>(params.cube.baseN) * fullBK)
            * params.cube.baseK * sizeof(uint16_t);
        if (requiredBytes <= l1Bytes) {
            params.cube.stepKa = 2;
            params.cube.depthA1 = 4;
            params.cube.stepKb = fullBK;
            params.cube.depthB1 = fullBK;
        }
    }

    bool keepFastPath = false;
    switch (shapeKey) {
        case ShapeKey::SPLIT_K:
            keepFastPath = true;
            break;
        case ShapeKey::DEFAULT:
            keepFastPath = !splitN && MatchesStaticBase(params, DEFAULT_ROWS, DEFAULT_COLS);
            break;
        case ShapeKey::LARGE_BALANCED:
            keepFastPath = point10Rows208 ? MatchesStaticBase(params, 208, 128)
                : (swappedNT ? MatchesStaticBase(params, 256, 112)
                : (swappedTT ? MatchesStaticBase(params, 256, 128)
                    : MatchesStaticBase(params, point9Rows112 ? 112 : (point12Rows64 ? 64 : LARGE_BALANCED_BASE_ROWS),
                        LARGE_BALANCED_BASE_COLS)));
            break;
        case ShapeKey::LARGE_TALL:
            keepFastPath = splitN && MatchesStaticBase(params,
                swappedTT ? 128 : 256, swappedTT ? 256 : 128);
            break;
        case ShapeKey::TALL_NARROW:
            keepFastPath = tileRows == 416;
            break;
        case ShapeKey::WIDE_SHALLOW:
            keepFastPath = splitN;
            break;
        default:
            break;
    }
    const bool genericFallback = !keepFastPath;
    if (genericFallback) {
        tileRows = DEFAULT_ROWS;
        tileCols = DEFAULT_COLS;
        params.rowTiles = (m + tileRows - 1) / tileRows;
        const int64_t genericRowTasks = batch * params.rowTiles;
        const int64_t genericColumns = (n + tileCols - 1) / tileCols;
        splitN = genericRowTasks * MIN_N_PARTS <= availableCoreNum
            && genericColumns >= MIN_N_PARTS;
        const uint32_t genericMaxParts = splitN
            ? std::min<int64_t>(availableCoreNum / genericRowTasks, genericColumns) : 1;
        const uint32_t genericBlocksPerPart = (genericColumns + genericMaxParts - 1) / genericMaxParts;
        parts = splitN ? (genericColumns + genericBlocksPerPart - 1) / genericBlocksPerPart : 1;
        params.cores = std::min<int64_t>(availableCoreNum, genericRowTasks * parts);

        // 旧专用块的base、步长和L1参数不能传入通用32×128核。
        matmul_tiling::MatmulApiTiling genericTiling(*platform);
        genericTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            dtype, transposeX1);
        genericTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            dtype, transposeX2);
        genericTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_FLOAT);
        genericTiling.SetShape(tileRows, tileCols, k);
        genericTiling.SetOrgShape(m, n, k);
        genericTiling.SetFixSplit(tileRows, tileCols);
        genericTiling.SetBias(false);
        genericTiling.SetBufferSpace(-1, -1, -1);
        params.cube = {};
        if (genericTiling.GetTiling(params.cube) != 0) {
            throw std::runtime_error("BatchMatmulMaxSum: generic Matmul tiling failed");
        }
    }

    aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
    aclmdlRI capturedModel = nullptr;
    CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel), "aclmdlRICaptureGetInfo");
    const bool capturing = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
    std::unique_ptr<KernelWorkspace> memory(new KernelWorkspace);
    const size_t scratchTiles = params.n > tileCols ? 2 : 1;
    memory->scratch.Allocate(static_cast<size_t>(params.cores) * scratchTiles
        * tileRows * tileCols * sizeof(float));
    const uint32_t partialStride = splitN ? tileRows : PARTIAL_STRIDE;
    memory->partial.Allocate(static_cast<size_t>(params.batch) * params.rowTiles * parts * partialStride * sizeof(float));
    const size_t workspaceBytes = platform->GetLibApiWorkSpaceSize();
    memory->system.Allocate(workspaceBytes);
    if (!capturing) {
        CheckAcl(aclrtMemset(memory->system.address, workspaceBytes, 0, workspaceBytes), "aclrtMemset");
    }
    auto scratchAddr = (GM_ADDR)memory->scratch.address;
    auto partialAddr = (GM_ADDR)memory->partial.address;
    auto workspaceAddr = (GM_ADDR)memory->system.address;
    if (capturing) {
        // 编译器生成的核内初始化随计算图一起重放，无须同步 Host 清零。
        // 注册成功后由计算图接管内存；run_kernel 返回时不能提前释放。
        CheckAcl(aclmdlRIDestroyRegisterCallback(capturedModel, DestroyCapturedWorkspace, memory.get()),
            "aclmdlRIDestroyRegisterCallback");
        memory.release();
    }
#if 0 // 原完整分发。
    if (a.dtype == 1) {
        LaunchByShapeKey<half>(x1, x2, scratchAddr, partialAddr, y, workspaceAddr,
            params, stream, transposeX1, transposeX2, shapeKey, splitN, genericFallback);
    } else {
        LaunchByShapeKey<bfloat16_t>(x1, x2, scratchAddr, partialAddr, y, workspaceAddr,
            params, stream, transposeX1, transposeX2, shapeKey, splitN, genericFallback);
    }
#else
    LaunchExploration(x1, x2, scratchAddr, partialAddr, y, workspaceAddr,
        params, stream, a.dtype == 1, transposeX1, transposeX2, shapeKey, splitN, genericFallback);
#endif
    if (!capturing) {
        CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
    }
}
