#include <algorithm>
#include <cstdint>
#include <memory>
#include <stdexcept>
#include <string>
#include "kernel_operator.h"
#include "adv_api/matmul/matmul_intf.h"
#include "adv_api/matmul/matmul_tiling.h"
#include "utils/tiling/platform/platform_ascendc.h"

namespace batch_max_sum {
constexpr uint32_t DEFAULT_ROWS = 32;
constexpr uint32_t DEFAULT_COLS = 128;
constexpr uint32_t MIN_N_PARTS = 4;
constexpr uint32_t SMALL_VECTOR_K_LIMIT = 64;
constexpr uint32_t SMALL_VECTOR_OUTPUT_LIMIT = 16;
constexpr uint32_t SMALL_VECTOR_MATRIX_ELEMENTS = SMALL_VECTOR_OUTPUT_LIMIT * SMALL_VECTOR_K_LIMIT;
constexpr uint32_t SMALL_BATCH_LIMIT = 4;
constexpr uint32_t SMALL_BATCH_M_LIMIT = 8;
constexpr uint32_t SMALL_BATCH_N_LIMIT = 16;
constexpr uint32_t SMALL_BATCH_A_ELEMENTS = SMALL_BATCH_M_LIMIT * SMALL_VECTOR_K_LIMIT;
constexpr uint32_t SMALL_BATCH_B_ELEMENTS = SMALL_BATCH_N_LIMIT * SMALL_VECTOR_K_LIMIT;
constexpr uint32_t SMALL_BATCH_PRODUCT_ELEMENTS =
    SMALL_BATCH_M_LIMIT * SMALL_BATCH_N_LIMIT * SMALL_VECTOR_K_LIMIT;
constexpr uint32_t MEDIUM_BATCH_LIMIT = 8;
constexpr uint32_t MEDIUM_BATCH_M_LIMIT = 16;
constexpr uint32_t MEDIUM_BATCH_N_LIMIT = 32;
constexpr uint32_t MEDIUM_BATCH_K_LIMIT = 128;
constexpr uint32_t MEDIUM_BATCH_COL_TILE = 16;
constexpr uint32_t MEDIUM_BATCH_K_TILE = 64;
constexpr uint32_t MEDIUM_BATCH_ROW_TILE = 4;
constexpr uint32_t MEDIUM_BATCH_A_ELEMENTS = MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_K_LIMIT;
constexpr uint32_t MEDIUM_BATCH_B_ELEMENTS = MEDIUM_BATCH_N_LIMIT * MEDIUM_BATCH_K_LIMIT;
constexpr uint32_t MEDIUM_BATCH_PRODUCT_ELEMENTS =
    MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE;
constexpr uint32_t MEDIUM_BATCH_DOT_ELEMENTS = MEDIUM_BATCH_M_LIMIT * MEDIUM_BATCH_COL_TILE;
constexpr uint32_t MEDIUM_BATCH_OUTPUT_STRIDE = 8;
constexpr uint32_t LARGE_BATCH_LIMIT = 16;
constexpr uint32_t LARGE_BATCH_M_LIMIT = 32;
constexpr uint32_t LARGE_BATCH_N_LIMIT = 128;
constexpr uint32_t LARGE_BATCH_K_LIMIT = 256;
constexpr uint32_t LARGE_BATCH_M_TILE = 8;
constexpr uint32_t LARGE_BATCH_COL_TILE = 16;
constexpr uint32_t LARGE_BATCH_K_TILE = 64;
constexpr uint32_t LARGE_BATCH_A_ELEMENTS = LARGE_BATCH_M_TILE * LARGE_BATCH_K_TILE;
constexpr uint32_t LARGE_BATCH_B_ELEMENTS = LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE;
constexpr uint32_t LARGE_BATCH_PRODUCT_ELEMENTS =
    LARGE_BATCH_M_TILE * LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE;
constexpr uint32_t LARGE_BATCH_DOT_ELEMENTS = LARGE_BATCH_M_TILE * LARGE_BATCH_COL_TILE;
constexpr uint32_t LARGE_BATCH_M_TILES = LARGE_BATCH_M_LIMIT / LARGE_BATCH_M_TILE;
// 每个任务独占一个 64 字节槽，避免不同核写同一缓存行。
constexpr uint32_t PARTIAL_STRIDE = 16;

enum class ShapeKey : uint32_t {
    DEFAULT,
    COMPACT_16,
    COMPACT_32,
    LARGE_BALANCED,
    TALL_NARROW,
    WIDE_SHALLOW,
};

struct Parameters {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t rowTiles;
    uint32_t cores;
    AscendC::tiling::TCubeTiling cube;
};

// 单点积的Max和Sum均为恒等操作，用纯Vector消除Cube/KFC固定开销。
template <typename T>
__global__ __aicore__ void ComputeDot(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> convertedBuffer;
    TBuf<TPosition::VECCALC> reduceBuffer;
    pipe.InitBuffer(inputQueue, 1, 2 * SMALL_VECTOR_K_LIMIT * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(convertedBuffer, 2 * SMALL_VECTOR_K_LIMIT * sizeof(float));
    pipe.InitBuffer(reduceBuffer, SMALL_VECTOR_K_LIMIT * sizeof(float));

    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    auto input = inputQueue.AllocTensor<T>();
    DataCopyExtParams inputCopy{1, static_cast<uint32_t>(k * sizeof(T)), 0, 0, 0};
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyPad(input, a, inputCopy, padding);
    DataCopyPad(input[SMALL_VECTOR_K_LIMIT], b, inputCopy, padding);
    inputQueue.EnQue(input);
    input = inputQueue.DeQue<T>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[SMALL_VECTOR_K_LIMIT];
    Cast(aFloat, input, RoundMode::CAST_NONE, k);
    Cast(bFloat, input[SMALL_VECTOR_K_LIMIT], RoundMode::CAST_NONE, k);
    PipeBarrier<PIPE_V>();
    Mul(aFloat, aFloat, bFloat, k);
    PipeBarrier<PIPE_V>();
    auto result = outputQueue.AllocTensor<float>();
    ReduceSum(result, aFloat, reduceBuffer.Get<float>(), k);
    inputQueue.FreeTensor(input);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output, result, outputCopy);
    outputQueue.FreeTensor(result);
}

// 小输出矩阵先把转置方向打包为连续K向量，再以FP32 Vector点积完成Max-Sum。
template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputePackedDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t m, uint32_t n, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> packedBuffer;
    TBuf<TPosition::VECCALC> offsetBuffer;
    TBuf<TPosition::VECCALC> convertedBuffer;
    TBuf<TPosition::VECCALC> productBuffer;
    TBuf<TPosition::VECCALC> dotBuffer;
    pipe.InitBuffer(inputQueue, 1, 2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(packedBuffer, 2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(T));
    pipe.InitBuffer(offsetBuffer, 2 * SMALL_VECTOR_K_LIMIT * sizeof(uint32_t));
    pipe.InitBuffer(convertedBuffer, 2 * SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float));
    pipe.InitBuffer(productBuffer, SMALL_VECTOR_MATRIX_ELEMENTS * sizeof(float));
    pipe.InitBuffer(dotBuffer, SMALL_VECTOR_OUTPUT_LIMIT * sizeof(float));

    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    DataCopyPad(input, a, aCopy, padding);
    DataCopyPad(input[SMALL_VECTOR_MATRIX_ELEMENTS], b, bCopy, padding);
    inputQueue.EnQue(input);
    input = inputQueue.DeQue<T>();

    auto rawA = input;
    auto rawB = input[SMALL_VECTOR_MATRIX_ELEMENTS];
    auto packedA = packedBuffer.Get<T>();
    auto packedB = packedA[SMALL_VECTOR_MATRIX_ELEMENTS];
    auto aOffsets = offsetBuffer.Get<int32_t>();
    auto bOffsets = aOffsets[SMALL_VECTOR_K_LIMIT];
    if constexpr (TRANS_A) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t row = 0; row < m; ++row) {
            Gather(packedA[row * SMALL_VECTOR_K_LIMIT], rawA, gatherOffsets,
                row * sizeof(T), k);
        }
    }
    if constexpr (!TRANS_B) {
        CreateVecIndex(bOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(bOffsets, bOffsets, static_cast<int32_t>(n * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = bOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t col = 0; col < n; ++col) {
            Gather(packedB[col * SMALL_VECTOR_K_LIMIT], rawB, gatherOffsets,
                col * sizeof(T), k);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[SMALL_VECTOR_MATRIX_ELEMENTS];
    for (uint32_t row = 0; row < m; ++row) {
        auto aSource = TRANS_A ? packedA[row * SMALL_VECTOR_K_LIMIT] : rawA[row * k];
        Cast(aFloat[row * SMALL_VECTOR_K_LIMIT], aSource, RoundMode::CAST_NONE, k);
    }
    for (uint32_t col = 0; col < n; ++col) {
        auto bSource = TRANS_B ? rawB[col * k] : packedB[col * SMALL_VECTOR_K_LIMIT];
        Cast(bFloat[col * SMALL_VECTOR_K_LIMIT], bSource, RoundMode::CAST_NONE, k);
    }
    PipeBarrier<PIPE_V>();

    auto products = productBuffer.Get<float>();
    auto dots = dotBuffer.Get<float>();
    BinaryRepeatParams multiplyRepeats{1, 1, 1, 8, 0, 8};
    for (uint32_t row = 0; row < m; ++row) {
        auto aVector = aFloat[row * SMALL_VECTOR_K_LIMIT];
        Mul(products[row * n * SMALL_VECTOR_K_LIMIT], aVector, bFloat,
            static_cast<uint64_t>(k), static_cast<uint8_t>(n), multiplyRepeats);
    }
    PipeBarrier<PIPE_V>();
    WholeReduceSum(dots, products, static_cast<int32_t>(k),
        static_cast<int32_t>(m * n), 1, 1,
        SMALL_VECTOR_K_LIMIT * sizeof(float) / 32);
    PipeBarrier<PIPE_V>();

    SetFlag<HardEvent::V_S>(EVENT_ID0);
    WaitFlag<HardEvent::V_S>(EVENT_ID0);
    float total = 0.0f;
    for (uint32_t row = 0; row < m; ++row) {
        float rowMax = dots[row * n].GetValue(0);
        for (uint32_t col = 1; col < n; ++col) {
            const float value = dots[row * n + col].GetValue(0);
            rowMax = value > rowMax ? value : rowMax;
        }
        total += rowMax;
    }
    inputQueue.FreeTensor(input);

    auto result = outputQueue.AllocTensor<float>();
    result.SetValue(0, total);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output, result, outputCopy);
    outputQueue.FreeTensor(result);
}

// 小批量短矩阵按batch分核；点积、行最大值和最终求和均在Vector流水中完成。
template <typename T, bool TRANS_A, bool TRANS_B, bool COMPACT_K>
__global__ __aicore__ void ComputeSmallBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t m, uint32_t n, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> packedBuffer;
    TBuf<TPosition::VECCALC> offsetBuffer;
    TBuf<TPosition::VECCALC> convertedBuffer;
    TBuf<TPosition::VECCALC> productBuffer;
    TBuf<TPosition::VECCALC> dotBuffer;
    TBuf<TPosition::VECCALC> maximumBuffer;
    pipe.InitBuffer(inputQueue, 1,
        (SMALL_BATCH_A_ELEMENTS + SMALL_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(packedBuffer,
        (SMALL_BATCH_A_ELEMENTS + SMALL_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(offsetBuffer, 2 * SMALL_VECTOR_K_LIMIT * sizeof(uint32_t));
    pipe.InitBuffer(convertedBuffer,
        (SMALL_BATCH_A_ELEMENTS + SMALL_BATCH_B_ELEMENTS) * sizeof(float));
    pipe.InitBuffer(productBuffer, SMALL_BATCH_PRODUCT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(dotBuffer,
        SMALL_BATCH_M_LIMIT * SMALL_BATCH_N_LIMIT * sizeof(float));
    pipe.InitBuffer(maximumBuffer, SMALL_BATCH_M_LIMIT * sizeof(float));

    const uint32_t batch = GetBlockIdx();
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1)
        + static_cast<uint64_t>(batch) * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2)
        + static_cast<uint64_t>(batch) * n * k);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    DataCopyPad(input, a, aCopy, padding);
    DataCopyPad(input[SMALL_BATCH_A_ELEMENTS], b, bCopy, padding);
    inputQueue.EnQue(input);
    input = inputQueue.DeQue<T>();

    auto rawA = input;
    auto rawB = input[SMALL_BATCH_A_ELEMENTS];
    auto packedA = packedBuffer.Get<T>();
    auto packedB = packedA[SMALL_BATCH_A_ELEMENTS];
    auto aOffsets = offsetBuffer.Get<int32_t>();
    auto bOffsets = aOffsets[SMALL_VECTOR_K_LIMIT];
    const uint32_t vectorStride = COMPACT_K ? k : SMALL_VECTOR_K_LIMIT;
    if constexpr (TRANS_A) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t row = 0; row < m; ++row) {
            Gather(packedA[row * vectorStride], rawA, gatherOffsets,
                row * sizeof(T), k);
        }
    }
    if constexpr (!TRANS_B) {
        CreateVecIndex(bOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(bOffsets, bOffsets, static_cast<int32_t>(n * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = bOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t col = 0; col < n; ++col) {
            Gather(packedB[col * vectorStride], rawB, gatherOffsets,
                col * sizeof(T), k);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[SMALL_BATCH_A_ELEMENTS];
    if constexpr (COMPACT_K) {
        auto aSource = TRANS_A ? packedA : rawA;
        auto bSource = TRANS_B ? rawB : packedB;
        Cast(aFloat, aSource, RoundMode::CAST_NONE, m * k);
        Cast(bFloat, bSource, RoundMode::CAST_NONE, n * k);
    } else {
        for (uint32_t row = 0; row < m; ++row) {
            auto source = TRANS_A ? packedA[row * SMALL_VECTOR_K_LIMIT] : rawA[row * k];
            Cast(aFloat[row * SMALL_VECTOR_K_LIMIT], source, RoundMode::CAST_NONE, k);
        }
        for (uint32_t col = 0; col < n; ++col) {
            auto source = TRANS_B ? rawB[col * k] : packedB[col * SMALL_VECTOR_K_LIMIT];
            Cast(bFloat[col * SMALL_VECTOR_K_LIMIT], source, RoundMode::CAST_NONE, k);
        }
    }
    PipeBarrier<PIPE_V>();

    auto products = productBuffer.Get<float>();
    const uint32_t vectorBlocks = vectorStride * sizeof(float) / 32;
    BinaryRepeatParams multiplyRepeats{1, 1, 1,
        static_cast<uint8_t>(vectorBlocks), 0, static_cast<uint8_t>(vectorBlocks)};
    for (uint32_t row = 0; row < m; ++row) {
        Mul(products[row * SMALL_BATCH_N_LIMIT * vectorStride],
            aFloat[row * vectorStride], bFloat,
            static_cast<uint64_t>(k), static_cast<uint8_t>(n), multiplyRepeats);
    }
    PipeBarrier<PIPE_V>();

    auto dots = dotBuffer.Get<float>();
    for (uint32_t row = 0; row < m; ++row) {
        WholeReduceSum(dots[row * SMALL_BATCH_N_LIMIT],
            products[row * SMALL_BATCH_N_LIMIT * vectorStride],
            static_cast<int32_t>(k), static_cast<int32_t>(n), 1, 1,
            static_cast<int32_t>(vectorBlocks));
    }
    PipeBarrier<PIPE_V>();

    auto maxima = maximumBuffer.Get<float>();
    WholeReduceMax(maxima, dots, static_cast<int32_t>(n), static_cast<int32_t>(m),
        1, 1, SMALL_BATCH_N_LIMIT * sizeof(float) / 32,
        ReduceOrder::ORDER_ONLY_VALUE);
    PipeBarrier<PIPE_V>();

    auto result = outputQueue.AllocTensor<float>();
    WholeReduceSum(result, maxima, static_cast<int32_t>(m), 1, 1, 1, 1);
    inputQueue.FreeTensor(input);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};
    DataCopyPad(output[batch], result, outputCopy);
    outputQueue.FreeTensor(result);
}

// 点4按batch和行块并行；按16列复用转换结果，K=128分两段累加。
// 各任务先写独立32字节GM槽，再由0号任务合并写回，避免并发写同一缓存行。
template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputeMediumBatchDots(GM_ADDR x1, GM_ADDR x2,
    GM_ADDR staging, GM_ADDR y, uint32_t batchCount, uint32_t m, uint32_t n, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    if ASCEND_IS_AIV {
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> packedBuffer;
    TBuf<TPosition::VECCALC> offsetBuffer;
    TBuf<TPosition::VECCALC> convertedBuffer;
    TBuf<TPosition::VECCALC> productBuffer;
    TBuf<TPosition::VECCALC> dotBuffer;
    TBuf<TPosition::VECCALC> maximumBuffer;
    TBuf<TPosition::VECCALC> tileMaximumBuffer;
    pipe.InitBuffer(inputQueue, 1,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(packedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(offsetBuffer, 2 * MEDIUM_BATCH_K_LIMIT * sizeof(uint32_t));
    pipe.InitBuffer(convertedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(float));
    pipe.InitBuffer(productBuffer, MEDIUM_BATCH_PRODUCT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(dotBuffer, MEDIUM_BATCH_DOT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(maximumBuffer, MEDIUM_BATCH_M_LIMIT * sizeof(float));
    pipe.InitBuffer(tileMaximumBuffer, MEDIUM_BATCH_M_LIMIT * sizeof(float));

    const uint32_t rowTiles = (m + MEDIUM_BATCH_ROW_TILE - 1) / MEDIUM_BATCH_ROW_TILE;
    const uint32_t taskIndex = GetBlockIdx();
    const uint32_t batchIndex = taskIndex / rowTiles;
    const uint32_t rowTileIndex = taskIndex % rowTiles;
    const uint32_t rowStart = rowTileIndex * MEDIUM_BATCH_ROW_TILE;
    const uint32_t validRows = m - rowStart < MEDIUM_BATCH_ROW_TILE
        ? m - rowStart : MEDIUM_BATCH_ROW_TILE;
    const uint32_t taskCount = batchCount * rowTiles;
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> stagedOutput;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1)
        + static_cast<uint64_t>(batchIndex) * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2)
        + static_cast<uint64_t>(batchIndex) * n * k);
    stagedOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(staging));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    DataCopyPad(input, a, aCopy, padding);
    DataCopyPad(input[MEDIUM_BATCH_A_ELEMENTS], b, bCopy, padding);
    inputQueue.EnQue(input);
    input = inputQueue.DeQue<T>();

    auto rawA = input;
    auto rawB = input[MEDIUM_BATCH_A_ELEMENTS];
    auto packedA = packedBuffer.Get<T>();
    auto packedB = packedA[MEDIUM_BATCH_ROW_TILE * MEDIUM_BATCH_K_LIMIT];
    auto aOffsets = offsetBuffer.Get<int32_t>();
    auto bOffsets = aOffsets[MEDIUM_BATCH_K_LIMIT];
    if constexpr (TRANS_A) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
            Gather(packedA[localRow * k], rawA, gatherOffsets,
                (rowStart + localRow) * sizeof(T), k);
        }
    }
    if constexpr (!TRANS_B) {
        CreateVecIndex(bOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(bOffsets, bOffsets, static_cast<int32_t>(n * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = bOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t col = 0; col < n; ++col) {
            Gather(packedB[col * k], rawB, gatherOffsets, col * sizeof(T), k);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[MEDIUM_BATCH_ROW_TILE * MEDIUM_BATCH_K_LIMIT];
    auto aSource = TRANS_A ? packedA : rawA[rowStart * k];
    auto bSource = TRANS_B ? rawB : packedB;
    Cast(aFloat, aSource, RoundMode::CAST_NONE, validRows * k);
    Cast(bFloat, bSource, RoundMode::CAST_NONE, n * k);
    PipeBarrier<PIPE_V>();
    inputQueue.FreeTensor(input);

    auto products = productBuffer.Get<float>();
    auto dots = dotBuffer.Get<float>();
    auto maxima = maximumBuffer.Get<float>();
    auto tileMaxima = tileMaximumBuffer.Get<float>();
    BinaryRepeatParams multiplyRepeats{1, 1, 1, 8, 0,
        static_cast<uint8_t>(k * sizeof(float) / 32)};
    for (uint32_t colStart = 0; colStart < n; colStart += MEDIUM_BATCH_COL_TILE) {
        const uint32_t validCols = n - colStart < MEDIUM_BATCH_COL_TILE
            ? n - colStart : MEDIUM_BATCH_COL_TILE;
        for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
            auto destination = products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE];
            Mul(destination, aFloat[localRow * k], bFloat[colStart * k],
                static_cast<uint64_t>(MEDIUM_BATCH_K_TILE),
                static_cast<uint8_t>(validCols), multiplyRepeats);
        }
        PipeBarrier<PIPE_V>();
        if (k > MEDIUM_BATCH_K_TILE) {
            for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
                auto destination = products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE];
                MulAddDst(destination, aFloat[localRow * k + MEDIUM_BATCH_K_TILE],
                    bFloat[colStart * k + MEDIUM_BATCH_K_TILE],
                    static_cast<uint64_t>(MEDIUM_BATCH_K_TILE),
                    static_cast<uint8_t>(validCols), multiplyRepeats);
            }
            PipeBarrier<PIPE_V>();
        }
        if (validCols == MEDIUM_BATCH_COL_TILE) {
            WholeReduceSum(dots, products,
                static_cast<int32_t>(MEDIUM_BATCH_K_TILE),
                static_cast<int32_t>(validRows * MEDIUM_BATCH_COL_TILE), 1, 1, 8);
        } else {
            for (uint32_t localRow = 0; localRow < validRows; ++localRow) {
                WholeReduceSum(dots[localRow * MEDIUM_BATCH_COL_TILE],
                    products[localRow * MEDIUM_BATCH_COL_TILE * MEDIUM_BATCH_K_TILE],
                    static_cast<int32_t>(MEDIUM_BATCH_K_TILE),
                    static_cast<int32_t>(validCols), 1, 1, 8);
            }
        }
        PipeBarrier<PIPE_V>();
        WholeReduceMax(tileMaxima, dots, static_cast<int32_t>(validCols),
            static_cast<int32_t>(validRows), 1, 1,
            MEDIUM_BATCH_COL_TILE * sizeof(float) / 32,
            ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        if (colStart == 0) {
            Adds(maxima, tileMaxima, 0.0f, validRows);
        } else {
            Max(maxima, maxima, tileMaxima, validRows);
        }
        PipeBarrier<PIPE_V>();
    }

    auto result = outputQueue.AllocTensor<float>();
    Duplicate(result, 0.0f, MEDIUM_BATCH_OUTPUT_STRIDE);
    PipeBarrier<PIPE_V>();
    WholeReduceSum(result, maxima, static_cast<int32_t>(validRows), 1, 1, 1, 1);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopy(stagedOutput[taskIndex * MEDIUM_BATCH_OUTPUT_STRIDE], result,
        MEDIUM_BATCH_OUTPUT_STRIDE);
    outputQueue.FreeTensor(result);

    SyncAll<true>();
    if (taskIndex == 0) {
        auto stagedInput = inputQueue.AllocTensor<T>();
        auto stagedFloat = stagedInput.template ReinterpretCast<float>();
        DataCopy(stagedFloat, stagedOutput,
            taskCount * MEDIUM_BATCH_OUTPUT_STRIDE);
        inputQueue.EnQue(stagedInput);
        stagedInput = inputQueue.DeQue<T>();
        stagedFloat = stagedInput.template ReinterpretCast<float>();

        auto gatherOffsets = offsetBuffer.Get<int32_t>();
        CreateVecIndex(gatherOffsets, static_cast<int32_t>(0), rowTiles);
        PipeBarrier<PIPE_V>();
        Muls(gatherOffsets, gatherOffsets,
            static_cast<int32_t>(MEDIUM_BATCH_OUTPUT_STRIDE * sizeof(float)),
            rowTiles);
        PipeBarrier<PIPE_V>();

        auto merged = productBuffer.Get<float>();
        for (uint32_t batch = 0; batch < batchCount; ++batch) {
            Gather(merged[batch * MEDIUM_BATCH_OUTPUT_STRIDE],
                stagedFloat[batch * rowTiles * MEDIUM_BATCH_OUTPUT_STRIDE],
                gatherOffsets.ReinterpretCast<uint32_t>(), static_cast<uint32_t>(0), rowTiles);
        }
        PipeBarrier<PIPE_V>();
        inputQueue.FreeTensor(stagedInput);

        auto finalResults = outputQueue.AllocTensor<float>();
        WholeReduceSum(finalResults, merged, static_cast<int32_t>(rowTiles),
            static_cast<int32_t>(batchCount), 1, 1,
            MEDIUM_BATCH_OUTPUT_STRIDE * sizeof(float) / 32);
        outputQueue.EnQue(finalResults);
        finalResults = outputQueue.DeQue<float>();
        DataCopyExtParams outputCopy{1,
            static_cast<uint32_t>(batchCount * sizeof(float)), 0, 0, 0};
        DataCopyPad(output, finalResults, outputCopy);
        outputQueue.FreeTensor(finalResults);
    }
    }
}

// 紧凑批量按batch、行块和列块分核，让全部AIV并行计算后在核内合并行最大值。
template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __aicore__ void ComputeLargeBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR staging,
    GM_ADDR y, uint32_t batchCount, uint32_t m, uint32_t n, uint32_t k)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace AscendC;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> packedBuffer;
    TBuf<TPosition::VECCALC> offsetBuffer;
    TBuf<TPosition::VECCALC> convertedBuffer;
    TBuf<TPosition::VECCALC> productBuffer;
    TBuf<TPosition::VECCALC> dotBuffer;
    TBuf<TPosition::VECCALC> maximumBuffer;
    pipe.InitBuffer(inputQueue, 1,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(outputQueue, 1, 32);
    pipe.InitBuffer(packedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(T));
    pipe.InitBuffer(offsetBuffer, 2 * MEDIUM_BATCH_K_LIMIT * sizeof(uint32_t));
    pipe.InitBuffer(convertedBuffer,
        (MEDIUM_BATCH_A_ELEMENTS + MEDIUM_BATCH_B_ELEMENTS) * sizeof(float));
    pipe.InitBuffer(productBuffer, LARGE_BATCH_PRODUCT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(dotBuffer, LARGE_BATCH_DOT_ELEMENTS * sizeof(float));
    pipe.InitBuffer(maximumBuffer, LARGE_BATCH_M_TILE * sizeof(float));

    const uint32_t rowTiles = (m + LARGE_BATCH_M_TILE - 1) / LARGE_BATCH_M_TILE;
    const uint32_t colTiles = (n + LARGE_BATCH_COL_TILE - 1) / LARGE_BATCH_COL_TILE;
    const uint32_t tasksPerBatch = rowTiles * colTiles;
    const uint32_t taskIndex = GetBlockIdx();
    const uint32_t batch = taskIndex / tasksPerBatch;
    const uint32_t localTask = taskIndex % tasksPerBatch;
    const uint32_t rowTile = localTask / colTiles;
    const uint32_t colTile = localTask % colTiles;
    const uint32_t rowStart = rowTile * LARGE_BATCH_M_TILE;
    const uint32_t colStart = colTile * LARGE_BATCH_COL_TILE;
    const uint32_t validRows = m - rowStart < LARGE_BATCH_M_TILE
        ? m - rowStart : LARGE_BATCH_M_TILE;
    const uint32_t validCols = n - colStart < LARGE_BATCH_COL_TILE
        ? n - colStart : LARGE_BATCH_COL_TILE;
    const uint32_t taskCount = batchCount * tasksPerBatch;
    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> stagedOutput;
    GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1)
        + static_cast<uint64_t>(batch) * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2)
        + static_cast<uint64_t>(batch) * n * k);
    stagedOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(staging));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    auto input = inputQueue.AllocTensor<T>();
    DataCopyPadExtParams<T> padding{false, 0, 0, 0};
    DataCopyExtParams aCopy{1, static_cast<uint32_t>(m * k * sizeof(T)), 0, 0, 0};
    DataCopyExtParams bCopy{1, static_cast<uint32_t>(n * k * sizeof(T)), 0, 0, 0};
    DataCopyPad(input, a, aCopy, padding);
    DataCopyPad(input[MEDIUM_BATCH_A_ELEMENTS], b, bCopy, padding);
    inputQueue.EnQue(input);
    input = inputQueue.DeQue<T>();

    auto rawA = input;
    auto rawB = input[MEDIUM_BATCH_A_ELEMENTS];
    auto packedA = packedBuffer.Get<T>();
    auto packedB = packedA[MEDIUM_BATCH_A_ELEMENTS];
    auto aOffsets = offsetBuffer.Get<int32_t>();
    auto bOffsets = aOffsets[MEDIUM_BATCH_K_LIMIT];
    if constexpr (TRANS_A) {
        CreateVecIndex(aOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(aOffsets, aOffsets, static_cast<int32_t>(m * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = aOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t row = 0; row < validRows; ++row) {
            Gather(packedA[row * k], rawA, gatherOffsets,
                (rowStart + row) * sizeof(T), k);
        }
    }
    if constexpr (!TRANS_B) {
        CreateVecIndex(bOffsets, static_cast<int32_t>(0), k);
        PipeBarrier<PIPE_V>();
        Muls(bOffsets, bOffsets, static_cast<int32_t>(n * sizeof(T)), k);
        PipeBarrier<PIPE_V>();
        auto gatherOffsets = bOffsets.ReinterpretCast<uint32_t>();
        for (uint32_t col = 0; col < validCols; ++col) {
            Gather(packedB[col * k], rawB, gatherOffsets,
                (colStart + col) * sizeof(T), k);
        }
    }
    PipeBarrier<PIPE_V>();

    auto aFloat = convertedBuffer.Get<float>();
    auto bFloat = aFloat[MEDIUM_BATCH_A_ELEMENTS];
    auto aSource = TRANS_A ? packedA : rawA[rowStart * k];
    auto bSource = TRANS_B ? rawB[colStart * k] : packedB;
    Cast(aFloat, aSource, RoundMode::CAST_NONE, validRows * k);
    Cast(bFloat, bSource, RoundMode::CAST_NONE, validCols * k);
    PipeBarrier<PIPE_V>();
    inputQueue.FreeTensor(input);

    auto products = productBuffer.Get<float>();
    auto dots = dotBuffer.Get<float>();
    auto maxima = maximumBuffer.Get<float>();
    BinaryRepeatParams multiplyRepeats{1, 1, 1, 8, 0,
        static_cast<uint8_t>(k * sizeof(float) / 32)};

    for (uint32_t row = 0; row < validRows; ++row) {
        auto destination = products[row * LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE];
        Mul(destination, aFloat[row * k], bFloat,
            static_cast<uint64_t>(LARGE_BATCH_K_TILE),
            static_cast<uint8_t>(validCols), multiplyRepeats);
    }
    PipeBarrier<PIPE_V>();
    if (k > LARGE_BATCH_K_TILE) {
        for (uint32_t row = 0; row < validRows; ++row) {
            auto destination = products[row * LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE];
            MulAddDst(destination, aFloat[row * k + LARGE_BATCH_K_TILE],
                bFloat[LARGE_BATCH_K_TILE], static_cast<uint64_t>(LARGE_BATCH_K_TILE),
                static_cast<uint8_t>(validCols), multiplyRepeats);
        }
        PipeBarrier<PIPE_V>();
    }
    for (uint32_t row = 0; row < validRows; ++row) {
        WholeReduceSum(dots[row * LARGE_BATCH_COL_TILE],
            products[row * LARGE_BATCH_COL_TILE * LARGE_BATCH_K_TILE],
            static_cast<int32_t>(LARGE_BATCH_K_TILE),
            static_cast<int32_t>(validCols), 1, 1, 8);
    }
    PipeBarrier<PIPE_V>();
    WholeReduceMax(maxima, dots, static_cast<int32_t>(validCols),
        static_cast<int32_t>(validRows), 1, 1,
        LARGE_BATCH_COL_TILE * sizeof(float) / 32,
        ReduceOrder::ORDER_ONLY_VALUE);
    PipeBarrier<PIPE_V>();

    auto result = outputQueue.AllocTensor<float>();
    Duplicate(result, 0.0f, LARGE_BATCH_M_TILE);
    PipeBarrier<PIPE_V>();
    Adds(result, maxima, 0.0f, validRows);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopy(stagedOutput[taskIndex * LARGE_BATCH_M_TILE], result, LARGE_BATCH_M_TILE);
    outputQueue.FreeTensor(result);

    SyncAll<true>();
    if (taskIndex == 0) {
        auto stagedInput = inputQueue.AllocTensor<T>();
        auto stagedFloat = stagedInput.template ReinterpretCast<float>();
        DataCopy(stagedFloat, stagedOutput, taskCount * LARGE_BATCH_M_TILE);
        inputQueue.EnQue(stagedInput);
        stagedInput = inputQueue.DeQue<T>();
        stagedFloat = stagedInput.template ReinterpretCast<float>();

        auto merged = productBuffer.Get<float>();
        for (uint32_t batchIndex = 0; batchIndex < batchCount; ++batchIndex) {
            for (uint32_t rowIndex = 0; rowIndex < rowTiles; ++rowIndex) {
                const uint32_t sourceTask = batchIndex * tasksPerBatch + rowIndex * colTiles;
                auto destination = merged[batchIndex * MEDIUM_BATCH_M_LIMIT
                    + rowIndex * LARGE_BATCH_M_TILE];
                Adds(destination, stagedFloat[sourceTask * LARGE_BATCH_M_TILE], 0.0f,
                    LARGE_BATCH_M_TILE);
                PipeBarrier<PIPE_V>();
                for (uint32_t colIndex = 1; colIndex < colTiles; ++colIndex) {
                    Max(destination, destination,
                        stagedFloat[(sourceTask + colIndex) * LARGE_BATCH_M_TILE],
                        LARGE_BATCH_M_TILE);
                    PipeBarrier<PIPE_V>();
                }
            }
        }
        PipeBarrier<PIPE_V>();
        inputQueue.FreeTensor(stagedInput);

        auto finalResults = outputQueue.AllocTensor<float>();
        for (uint32_t batchIndex = 0; batchIndex < batchCount; ++batchIndex) {
            WholeReduceSum(finalResults[batchIndex],
                merged[batchIndex * MEDIUM_BATCH_M_LIMIT], static_cast<int32_t>(m),
                1, 1, 1, 1);
        }
        outputQueue.EnQue(finalResults);
        finalResults = outputQueue.DeQue<float>();
        DataCopyExtParams outputCopy{1,
            static_cast<uint32_t>(batchCount * sizeof(float)), 0, 0, 0};
        DataCopyPad(output, finalResults, outputCopy);
        outputQueue.FreeTensor(finalResults);
    }
}

__aicore__ inline void Finish(AscendC::TPipe& pipe, GM_ADDR partial, GM_ADDR y,
    uint32_t rowTiles, uint32_t batch)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> tempBuffer;
    TBuf<TPosition::VECCALC> reduceBuffer;
    const uint32_t count = rowTiles * PARTIAL_STRIDE;
    pipe.InitBuffer(inputQueue, 1, count * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, 64 * sizeof(float));
    pipe.InitBuffer(tempBuffer, count * sizeof(float));
    pipe.InitBuffer(reduceBuffer, 32);
    GlobalTensor<float> input;
    GlobalTensor<float> output;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    auto result = outputQueue.AllocTensor<float>();
    auto reduced = reduceBuffer.Get<float>();
    for (uint32_t b = 0; b < batch; ++b) {
        auto local = inputQueue.AllocTensor<float>();
        DataCopy(local, input[b * count], count);
        inputQueue.EnQue(local);
        local = inputQueue.DeQue<float>();
        ReduceSum(reduced, local, tempBuffer.Get<float>(), count);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        result.SetValue(b, reduced.GetValue(0));
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        inputQueue.FreeTensor(local);
    }
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    // 单核连续写 B 个 float，既不越界，也不产生跨核缓存行共享写。
    DataCopyExtParams copy{1, static_cast<uint32_t>(batch * sizeof(float)), 0, 0, 0};
    DataCopyPad(output, result, copy);
    outputQueue.FreeTensor(result);
}


// N 分片不能先对行求和：先合并同一行的各片局部最大值，再沿 M 求和。
template <uint32_t TILE_ROWS>
__aicore__ inline void FinishSplitN(AscendC::TPipe& pipe, GM_ADDR partial, GM_ADDR y,
    const Parameters& params)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> maximaBuffer;
    TBuf<TPosition::VECCALC> sumsBuffer;
    TBuf<TPosition::VECCALC> tempBuffer;
    TBuf<TPosition::VECCALC> reduceBuffer;
    const uint32_t count = params.rowTiles * PARTIAL_STRIDE;
    // 分片分支的全部任务恰好各占一核，可由核数还原片数，无须扩展核参数布局。
    const uint32_t parts = params.cores / (params.batch * params.rowTiles);
    pipe.InitBuffer(inputQueue, 1, parts * TILE_ROWS * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, 64 * sizeof(float));
    pipe.InitBuffer(maximaBuffer, TILE_ROWS * sizeof(float));
    pipe.InitBuffer(sumsBuffer, count * sizeof(float));
    pipe.InitBuffer(tempBuffer, count * sizeof(float));
    pipe.InitBuffer(reduceBuffer, 32);
    GlobalTensor<float> input;
    GlobalTensor<float> output;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    auto result = outputQueue.AllocTensor<float>();
    auto maxima = maximaBuffer.Get<float>();
    auto sums = sumsBuffer.Get<float>();
    auto reduced = reduceBuffer.Get<float>();
    for (uint32_t b = 0; b < params.batch; ++b) {
        for (uint32_t i = 0; i < count; ++i) {
            sums.SetValue(i, 0.0f);
        }
        for (uint32_t rowTile = 0; rowTile < params.rowTiles; ++rowTile) {
            const uint32_t rowStart = rowTile * TILE_ROWS;
            const uint32_t validRows = params.m - rowStart < TILE_ROWS ? params.m - rowStart : TILE_ROWS;
            const uint32_t offset = (b * params.rowTiles + rowTile) * parts * TILE_ROWS;
            auto local = inputQueue.AllocTensor<float>();
            DataCopy(local, input[offset], parts * TILE_ROWS);
            inputQueue.EnQue(local);
            local = inputQueue.DeQue<float>();
            Max(maxima, local, local[TILE_ROWS], validRows);
            for (uint32_t part = 2; part < parts; ++part) {
                PipeBarrier<PIPE_V>();
                Max(maxima, maxima, local[part * TILE_ROWS], validRows);
            }
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            float sum = 0.0f;
            for (uint32_t row = 0; row < validRows; ++row) {
                sum += maxima.GetValue(row);
            }
            // 复现基线每个行块一个 sum、其余槽补零的布局及 ReduceSum 顺序。
            sums.SetValue(rowTile * PARTIAL_STRIDE, sum);
            SetFlag<HardEvent::S_V>(EVENT_ID0);
            WaitFlag<HardEvent::S_V>(EVENT_ID0);
            inputQueue.FreeTensor(local);
        }
        ReduceSum(reduced, sums, tempBuffer.Get<float>(), count);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        result.SetValue(b, reduced.GetValue(0));
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
    }
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    outputQueue.EnQue(result);
    result = outputQueue.DeQue<float>();
    DataCopyExtParams copy{1, static_cast<uint32_t>(params.batch * sizeof(float)), 0, 0, 0};
    DataCopyPad(output, result, copy);
    outputQueue.FreeTensor(result);
}


// 异步模式显式请求完成通知，读回对应结果块前必须 WaitIterateAll。
template <uint32_t TILE_COLS, bool TRANS_A, bool TRANS_B, bool ASYNC, typename MM, typename T>
__aicore__ inline void StartColumn(MM& mm, const AscendC::GlobalTensor<T>& a,
    const AscendC::GlobalTensor<T>& b, const AscendC::GlobalTensor<float>& destination,
    const Parameters& params, uint64_t aOffset, uint64_t bOffset,
    uint32_t validRows, uint32_t colStart)
{
    const uint32_t validCols = params.n - colStart < TILE_COLS ? params.n - colStart : TILE_COLS;
    const uint64_t tileBOffset = bOffset
        + (TRANS_B ? static_cast<uint64_t>(colStart) * params.k : colStart);
    mm.SetOrgShape(params.m, params.n, params.k, params.k, TILE_COLS);
    mm.SetTail(validRows, validCols, params.k);
    mm.SetTensorA(a[aOffset], TRANS_A);
    mm.SetTensorB(b[tileBOffset], TRANS_B);
    mm.template IterateAll<!ASYNC>(destination, 0, false, ASYNC);
}

template <typename T, bool TRANS_A, bool TRANS_B, bool SPLIT_N,
    uint32_t TILE_ROWS, uint32_t TILE_COLS, bool DIRECT_RESULT>
__global__ __aicore__ void Compute(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch,
    GM_ADDR partial, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, Parameters params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    using namespace AscendC;
    TPipe pipe;
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, T, TRANS_A>,
        MatmulType<TPosition::GM, CubeFormat::ND, T, TRANS_B>,
        MatmulType<TPosition::GM, CubeFormat::ND, float>> mm;
    // 专用参数绑定系统工作区；形参是用户区地址，不能作为 KFC 通信区。
    // 必须与编译器初始化的系统区使用同一地址，避免重复调用读取旧退出消息。
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &params.cube);

    GlobalTensor<T> a;
    GlobalTensor<T> b;
    GlobalTensor<float> c;
    GlobalTensor<float> scores;
    GlobalTensor<float> finalOutput;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
    const uint32_t scratchTiles = params.n > TILE_COLS ? 2 : 1;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratch)
        + GetBlockIdx() * scratchTiles * TILE_ROWS * TILE_COLS);
    scores.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial));
    finalOutput.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));

    TQue<TPosition::VECIN, 1> inputQueue;
    TQue<TPosition::VECOUT, 1> outputQueue;
    TBuf<TPosition::VECCALC> reduceBuffer;
    TBuf<TPosition::VECCALC> resultBuffer;
    pipe.InitBuffer(inputQueue, 1, TILE_ROWS * TILE_COLS * sizeof(float));
    constexpr uint32_t outputStride = SPLIT_N ? TILE_ROWS : PARTIAL_STRIDE;
    pipe.InitBuffer(outputQueue, 1, outputStride * sizeof(float));
    pipe.InitBuffer(reduceBuffer, TILE_COLS * sizeof(float));
    pipe.InitBuffer(resultBuffer, TILE_ROWS * sizeof(float));
    auto reduceTemp = reduceBuffer.Get<float>();
    auto reduced = resultBuffer.Get<float>();

    const uint32_t parts = SPLIT_N ? params.cores / (params.batch * params.rowTiles) : 1;
    const uint32_t tasks = params.batch * params.rowTiles * parts;
    for (uint32_t task = GetBlockIdx(); task < tasks; task += params.cores) {
        const uint32_t rowTask = task / parts;
        uint32_t firstCol = 0;
        uint32_t endCol = params.n;
        if (SPLIT_N) {
            const uint32_t part = task % parts;
            const uint32_t columnTiles = (params.n + TILE_COLS - 1) / TILE_COLS;
            firstCol = (columnTiles * part / parts) * TILE_COLS;
            const uint32_t endTileCol = (columnTiles * (part + 1) / parts) * TILE_COLS;
            endCol = endTileCol < params.n ? endTileCol : params.n;
        }
        const uint32_t batch = rowTask / params.rowTiles;
        const uint32_t rowStart = (rowTask % params.rowTiles) * TILE_ROWS;
        const uint32_t validRows = params.m - rowStart < TILE_ROWS ? params.m - rowStart : TILE_ROWS;
        const uint64_t aOffset = static_cast<uint64_t>(batch) * params.m * params.k
            + (TRANS_A ? rowStart : static_cast<uint64_t>(rowStart) * params.k);
        const uint64_t bOffset = static_cast<uint64_t>(batch) * params.k * params.n;
        float rowMax[TILE_ROWS];

        // 多列块采用两个 GM 槽：当前块读回/归约时，Cube 计算下一块。
        if (params.n > TILE_COLS) {
            StartColumn<TILE_COLS, TRANS_A, TRANS_B, true>(mm, a, b, c, params,
                aOffset, bOffset, validRows, firstCol);
        }
        // K 的完整点积仍由 Cube 以 FP32 累加；N 分块之间只合并最大值。
        for (uint32_t colStart = firstCol; colStart < endCol; colStart += TILE_COLS) {
            const uint32_t validCols = params.n - colStart < TILE_COLS ? params.n - colStart : TILE_COLS;
            const uint32_t slot = ((colStart - firstCol) / TILE_COLS) % scratchTiles;
            if (params.n > TILE_COLS) {
                mm.WaitIterateAll();
            } else {
                StartColumn<TILE_COLS, TRANS_A, TRANS_B, false>(mm, a, b, c, params,
                    aOffset, bOffset, validRows, colStart);
            }
            mm.End();

            auto tile = inputQueue.AllocTensor<float>();
            DataCopy(tile, c[slot * TILE_ROWS * TILE_COLS], validRows * TILE_COLS);
            inputQueue.EnQue(tile);
            const uint32_t nextCol = colStart + TILE_COLS;
            if (nextCol < endCol) {
                const uint32_t nextSlot = (slot + 1) % scratchTiles;
                StartColumn<TILE_COLS, TRANS_A, TRANS_B, true>(mm, a, b,
                    c[nextSlot * TILE_ROWS * TILE_COLS], params, aOffset, bOffset, validRows, nextCol);
            }
            // 上次使用同一 GM 槽的数据已完成搬运和归约，才会再次提交到该槽。
            tile = inputQueue.DeQue<float>();
            // 每个 repeat 处理一行的至多64个float，行间跨度由列块宽度决定。
            // 只输出最值时 dstRepStride=1，结果连续存放，无须逐行经 Scalar 中转。
            const uint32_t halfColumns = TILE_COLS < 64 ? TILE_COLS : 64;
            const uint32_t firstColumns = validCols < halfColumns ? validCols : halfColumns;
            const uint32_t rowStride = TILE_COLS * sizeof(float) / 32;
            WholeReduceMax(reduced, tile, firstColumns, validRows, 1, 1, rowStride,
                ReduceOrder::ORDER_ONLY_VALUE);
            if (validCols > halfColumns) {
                WholeReduceMax(reduceTemp, tile[halfColumns], validCols - halfColumns,
                    validRows, 1, 1, rowStride, ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(reduced, reduced, reduceTemp, validRows);
            }
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            for (uint32_t row = 0; row < validRows; ++row) {
                const float value = reduced.GetValue(row);
                // 第一块初始化，不能用 0，否则全负相似度的结果会错误。
                if (colStart == firstCol || value > rowMax[row]) {
                    rowMax[row] = value;
                }
            }
            // 下一列块复用结果缓冲前，等待本块全部 Scalar 读取完成。
            SetFlag<HardEvent::S_V>(EVENT_ID0);
            WaitFlag<HardEvent::S_V>(EVENT_ID0);
            inputQueue.FreeTensor(tile);
        }

        auto output = outputQueue.AllocTensor<float>();
        if (SPLIT_N) {
            // 每个分片独占一个完整行块槽，尾行补零仅用于写满槽，不参与最终 Max/Sum。
            for (uint32_t row = 0; row < TILE_ROWS; ++row) {
                output.SetValue(row, row < validRows ? rowMax[row] : 0.0f);
            }
        } else {
            float sum = 0.0f;
            for (uint32_t row = 0; row < validRows; ++row) {
                sum += rowMax[row];
            }
            for (uint32_t i = 0; i < PARTIAL_STRIDE; ++i) {
                output.SetValue(i, i == 0 ? sum : 0.0f);
            }
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        outputQueue.EnQue(output);
        output = outputQueue.DeQue<float>();
        if (DIRECT_RESULT) {
            DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
            DataCopyPad(finalOutput, output, copy);
        } else {
            DataCopy(scores[task * outputStride], output, outputStride);
        }
        outputQueue.FreeTensor(output);
    }

    if (DIRECT_RESULT) {
        return;
    }

    // REGIST_MATMUL_OBJ 后的这段代码只在 Vector 侧执行。
    // 等待所有 Vector 核的局部结果落入 GM，再由 0 号核顺序完成最终归约。
    // 不能使用包含 Cube 的同步：Cube 此时仍在 KFC 服务循环中。
    if (params.cores > 1) {
        SyncAll<true>();
    } else {
        // 单核无需跨核屏障，但必须等待 partial 写回后才能读取。
        PipeBarrier<PIPE_ALL>();
    }
    if (GetBlockIdx() == 0) {
        if (SPLIT_N) {
            FinishSplitN<TILE_ROWS>(pipe, partial, y, params);
        } else {
            Finish(pipe, partial, y, params.rowTiles, params.batch);
        }
    }
}


inline void CheckAcl(aclError code, const char* operation)
{
    if (code != ACL_SUCCESS) {
        throw std::runtime_error(std::string(operation) + ": " + std::to_string(code));
    }
}

// 普通调用在同步后释放；捕获调用的工作区必须存活到计算图销毁。
struct DeviceMemory {
    void* address = nullptr;
    ~DeviceMemory()
    {
        if (address != nullptr) {
            aclrtFree(address);
        }
    }
    void Allocate(size_t bytes)
    {
        CheckAcl(aclrtMalloc(&address, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
    }
};

struct KernelWorkspace {
    DeviceMemory scratch;
    DeviceMemory partial;
    DeviceMemory system;
};

void DestroyCapturedWorkspace(void* address)
{
    delete static_cast<KernelWorkspace*>(address);
}

void DestroyCapturedDeviceMemory(void* address)
{
    delete static_cast<DeviceMemory*>(address);
}

template <typename T, bool SPLIT_N, uint32_t TILE_ROWS, uint32_t TILE_COLS, bool DIRECT_RESULT>
void Launch(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch, GM_ADDR partial, GM_ADDR y, GM_ADDR workspace,
    const Parameters& params, aclrtStream stream, bool transA, bool transB)
{
    if (transA && transB) {
        Compute<T, true, true, SPLIT_N, TILE_ROWS, TILE_COLS, DIRECT_RESULT>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
    } else if (transA) {
        Compute<T, true, false, SPLIT_N, TILE_ROWS, TILE_COLS, DIRECT_RESULT>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
    } else if (transB) {
        Compute<T, false, true, SPLIT_N, TILE_ROWS, TILE_COLS, DIRECT_RESULT>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
    } else {
        Compute<T, false, false, SPLIT_N, TILE_ROWS, TILE_COLS, DIRECT_RESULT>
            <<<params.cores, nullptr, stream>>>(x1, x2, scratch, partial, y, workspace, params);
    }
}

template <typename T>
void LaunchByShapeKey(GM_ADDR x1, GM_ADDR x2, GM_ADDR scratch, GM_ADDR partial, GM_ADDR y,
    GM_ADDR workspace, const Parameters& params, aclrtStream stream, bool transA, bool transB,
    ShapeKey key, bool splitN)
{
    if (key == ShapeKey::COMPACT_16) {
        Launch<T, false, 16, 16, false>(x1, x2, scratch, partial, y, workspace,
            params, stream, transA, transB);
    } else if (key == ShapeKey::COMPACT_32) {
        Launch<T, false, 16, 32, false>(x1, x2, scratch, partial, y, workspace,
            params, stream, transA, transB);
    } else if (key == ShapeKey::LARGE_BALANCED) {
        if (splitN) {
            Launch<T, true, 64, 128, false>(x1, x2, scratch, partial, y, workspace,
                params, stream, transA, transB);
        } else {
            Launch<T, false, 64, 128, false>(x1, x2, scratch, partial, y, workspace,
                params, stream, transA, transB);
        }
    } else if (key == ShapeKey::TALL_NARROW) {
        if (params.batch * params.rowTiles == 1) {
            Launch<T, false, 64, 64, true>(x1, x2, scratch, partial, y, workspace,
                params, stream, transA, transB);
        } else {
            Launch<T, false, 64, 64, false>(x1, x2, scratch, partial, y, workspace,
                params, stream, transA, transB);
        }
    } else if (key == ShapeKey::WIDE_SHALLOW) {
        if (splitN) {
            Launch<T, true, 64, 128, false>(x1, x2, scratch, partial, y, workspace,
                params, stream, transA, transB);
        } else if (params.batch * params.rowTiles == 1) {
            Launch<T, false, 64, 128, true>(x1, x2, scratch, partial, y, workspace,
                params, stream, transA, transB);
        } else {
            Launch<T, false, 64, 128, false>(x1, x2, scratch, partial, y, workspace,
                params, stream, transA, transB);
        }
    } else if (splitN) {
        Launch<T, true, 32, 128, false>(x1, x2, scratch, partial, y, workspace,
            params, stream, transA, transB);
    } else {
        Launch<T, false, 32, 128, false>(x1, x2, scratch, partial, y, workspace,
            params, stream, transA, transB);
    }
}

template <typename T>
void LaunchPackedDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t m, uint32_t n, uint32_t k,
    aclrtStream stream, bool transA, bool transB)
{
    if (transA && transB) {
        ComputePackedDots<T, true, true><<<1, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else if (transA) {
        ComputePackedDots<T, true, false><<<1, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else if (transB) {
        ComputePackedDots<T, false, true><<<1, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else {
        ComputePackedDots<T, false, false><<<1, nullptr, stream>>>(x1, x2, y, m, n, k);
    }
}

template <typename T, bool COMPACT_K>
void LaunchSmallBatchDotsByLayout(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, aclrtStream stream, bool transA, bool transB)
{
    if (transA && transB) {
        ComputeSmallBatchDots<T, true, true, COMPACT_K>
            <<<batch, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else if (transA) {
        ComputeSmallBatchDots<T, true, false, COMPACT_K>
            <<<batch, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else if (transB) {
        ComputeSmallBatchDots<T, false, true, COMPACT_K>
            <<<batch, nullptr, stream>>>(x1, x2, y, m, n, k);
    } else {
        ComputeSmallBatchDots<T, false, false, COMPACT_K>
            <<<batch, nullptr, stream>>>(x1, x2, y, m, n, k);
    }
}

template <typename T>
void LaunchSmallBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, aclrtStream stream, bool transA, bool transB)
{
    if ((k & 15u) == 0) {
        LaunchSmallBatchDotsByLayout<T, true>(x1, x2, y, batch, m, n, k,
            stream, transA, transB);
    } else {
        LaunchSmallBatchDotsByLayout<T, false>(x1, x2, y, batch, m, n, k,
            stream, transA, transB);
    }
}

template <typename T>
void LaunchMediumBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR staging, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, aclrtStream stream, bool transA, bool transB)
{
    const uint32_t rowTiles = (m + MEDIUM_BATCH_ROW_TILE - 1) / MEDIUM_BATCH_ROW_TILE;
    const uint32_t taskCount = batch * rowTiles;
    if (transA && transB) {
        ComputeMediumBatchDots<T, true, true>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else if (transA) {
        ComputeMediumBatchDots<T, true, false>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else if (transB) {
        ComputeMediumBatchDots<T, false, true>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else {
        ComputeMediumBatchDots<T, false, false>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    }
}

template <typename T>
void LaunchLargeBatchDots(GM_ADDR x1, GM_ADDR x2, GM_ADDR staging, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, aclrtStream stream, bool transA, bool transB)
{
    const uint32_t rowTiles = (m + LARGE_BATCH_M_TILE - 1) / LARGE_BATCH_M_TILE;
    const uint32_t colTiles = (n + LARGE_BATCH_COL_TILE - 1) / LARGE_BATCH_COL_TILE;
    const uint32_t taskCount = batch * rowTiles * colTiles;
    if (transA && transB) {
        ComputeLargeBatchDots<T, true, true>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else if (transA) {
        ComputeLargeBatchDots<T, true, false>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else if (transB) {
        ComputeLargeBatchDots<T, false, true>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    } else {
        ComputeLargeBatchDots<T, false, false>
            <<<taskCount, nullptr, stream>>>(x1, x2, staging, y, batch, m, n, k);
    }
}

} // namespace batch_max_sum

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    using namespace batch_max_sum;
    const auto& a = info_x1.tensors[0];
    const auto& b = info_x2.tensors[0];
    if (a.numDims != 3 || b.numDims != 3 || a.dtype != b.dtype || (a.dtype != 1 && a.dtype != 2)) {
        throw std::invalid_argument("BatchMatmulMaxSum: invalid input rank or dtype");
    }
    const int64_t batch = a.shape[0];
    const int64_t m = a.shape[transposeX1 ? 2 : 1];
    const int64_t k = a.shape[transposeX1 ? 1 : 2];
    const int64_t n = b.shape[transposeX2 ? 1 : 2];
    if (batch < 1 || batch > 64 || m < 1 || m > 8192 || n < 1 || n > 8192
        || k < 32 || k > 8192 || k % 8 != 0 || b.shape[0] != batch
        || b.shape[transposeX2 ? 2 : 1] != k || batch * m * k > (1LL << 26)
        || batch * n * k > (1LL << 26) || availableCoreNum <= 0
        || info_y.tensors[0].dtype != 0 || info_y.tensors[0].numDims != 1
        || info_y.tensors[0].shape[0] != batch) {
        throw std::invalid_argument("BatchMatmulMaxSum: invalid shape or core count");
    }
    const bool smallVector = batch == 1 && k <= SMALL_VECTOR_K_LIMIT
        && m * n <= SMALL_VECTOR_OUTPUT_LIMIT;
    if (smallVector) {
        aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
        aclmdlRI capturedModel = nullptr;
        CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel), "aclmdlRICaptureGetInfo");
        if (m == 1 && n == 1 && a.dtype == 1) {
            ComputeDot<half><<<1, nullptr, stream>>>(x1, x2, y, static_cast<uint32_t>(k));
        } else if (a.dtype == 1) {
            LaunchPackedDots<half>(x1, x2, y, static_cast<uint32_t>(m), static_cast<uint32_t>(n),
                static_cast<uint32_t>(k), stream, transposeX1, transposeX2);
        } else {
            LaunchPackedDots<bfloat16_t>(x1, x2, y, static_cast<uint32_t>(m), static_cast<uint32_t>(n),
                static_cast<uint32_t>(k), stream, transposeX1, transposeX2);
        }
        if (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE) {
            CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
        return;
    }
    const bool smallBatchVector = batch >= 2 && batch <= SMALL_BATCH_LIMIT
        && m <= SMALL_BATCH_M_LIMIT && n <= SMALL_BATCH_N_LIMIT
        && k <= SMALL_VECTOR_K_LIMIT;
    if (smallBatchVector) {
        aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
        aclmdlRI capturedModel = nullptr;
        CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel), "aclmdlRICaptureGetInfo");
        if (a.dtype == 1) {
            LaunchSmallBatchDots<half>(x1, x2, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        } else {
            LaunchSmallBatchDots<bfloat16_t>(x1, x2, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        }
        if (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE) {
            CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
        return;
    }
    const bool mediumVectorOnMixedTask = batch >= 2 && batch <= 4
        && m <= 16 && n <= 16
        && k >= MEDIUM_BATCH_K_TILE && k <= MEDIUM_BATCH_K_LIMIT
        && (k & 63u) == 0;
    if (mediumVectorOnMixedTask) {
        aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
        aclmdlRI capturedModel = nullptr;
        CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel), "aclmdlRICaptureGetInfo");
        const bool capturing = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
        std::unique_ptr<DeviceMemory> stagingMemory(new DeviceMemory);
        const uint32_t rowTiles = (static_cast<uint32_t>(m) + MEDIUM_BATCH_ROW_TILE - 1)
            / MEDIUM_BATCH_ROW_TILE;
        stagingMemory->Allocate(static_cast<size_t>(batch) * rowTiles
            * MEDIUM_BATCH_OUTPUT_STRIDE * sizeof(float));
        auto stagingAddress = (GM_ADDR)stagingMemory->address;
        if (capturing) {
            CheckAcl(aclmdlRIDestroyRegisterCallback(capturedModel, DestroyCapturedDeviceMemory,
                stagingMemory.get()), "aclmdlRIDestroyRegisterCallback");
            stagingMemory.release();
        }
        if (a.dtype == 1) {
            LaunchMediumBatchDots<half>(x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        } else {
            LaunchMediumBatchDots<bfloat16_t>(x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        }
        if (!capturing) {
            CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
        return;
    }
    const bool compactBatchVector = batch >= 5 && batch <= 8
        && m <= 16 && n <= 32
        && k >= LARGE_BATCH_K_TILE && k <= MEDIUM_BATCH_K_LIMIT
        && (k & 63u) == 0;
    if (compactBatchVector) {
        aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
        aclmdlRI capturedModel = nullptr;
        CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel),
            "aclmdlRICaptureGetInfo");
        const bool capturing = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
        std::unique_ptr<DeviceMemory> stagingMemory(new DeviceMemory);
        const uint32_t rowTiles = (static_cast<uint32_t>(m) + LARGE_BATCH_M_TILE - 1)
            / LARGE_BATCH_M_TILE;
        const uint32_t colTiles = (static_cast<uint32_t>(n) + LARGE_BATCH_COL_TILE - 1)
            / LARGE_BATCH_COL_TILE;
        stagingMemory->Allocate(static_cast<size_t>(batch) * rowTiles * colTiles
            * LARGE_BATCH_M_TILE * sizeof(float));
        auto stagingAddress = (GM_ADDR)stagingMemory->address;
        if (capturing) {
            CheckAcl(aclmdlRIDestroyRegisterCallback(capturedModel, DestroyCapturedDeviceMemory,
                stagingMemory.get()), "aclmdlRIDestroyRegisterCallback");
            stagingMemory.release();
        }
        if (a.dtype == 1) {
            LaunchLargeBatchDots<half>(x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        } else {
            LaunchLargeBatchDots<bfloat16_t>(x1, x2, stagingAddress, y, static_cast<uint32_t>(batch),
                static_cast<uint32_t>(m), static_cast<uint32_t>(n), static_cast<uint32_t>(k),
                stream, transposeX1, transposeX2);
        }
        if (!capturing) {
            CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        }
        return;
    }
    ShapeKey shapeKey = ShapeKey::DEFAULT;
    uint32_t tileRows = DEFAULT_ROWS;
    uint32_t tileCols = DEFAULT_COLS;
    if (batch >= 2 && batch <= 8 && m <= 16 && n <= 32
        && k > SMALL_VECTOR_K_LIMIT && k <= 128) {
        tileRows = 16;
        if (n <= 16) {
            shapeKey = ShapeKey::COMPACT_16;
            tileCols = 16;
        } else {
            shapeKey = ShapeKey::COMPACT_32;
            tileCols = 32;
        }
    } else if (batch == 1 && m >= 1024 && n >= 512) {
        shapeKey = ShapeKey::LARGE_BALANCED;
        tileRows = 64;
    } else if (n <= 64 && m >= 64) {
        shapeKey = ShapeKey::TALL_NARROW;
        tileRows = 64;
        tileCols = 64;
    } else if (m <= 64 && n >= 512) {
        shapeKey = ShapeKey::WIDE_SHALLOW;
        tileRows = 64;
    }

    Parameters params{};
    params.batch = batch;
    params.m = m;
    params.n = n;
    params.k = k;
    params.rowTiles = (m + tileRows - 1) / tileRows;
    const int64_t rowTasks = batch * params.rowTiles;
    const int64_t columnTiles = (n + tileCols - 1) / tileCols;
    // 保留四路分片的触发范围，在该范围内按空闲核数增加分片。
    // 所有分片仍能一轮落到可用核上，且每片至少处理一个列块。
    const bool splitN = rowTasks * MIN_N_PARTS <= availableCoreNum && columnTiles >= MIN_N_PARTS;
    const uint32_t parts = splitN
        ? std::min<int64_t>(availableCoreNum / rowTasks, columnTiles) : 1;
    params.cores = std::min<int64_t>(availableCoreNum, rowTasks * parts);

    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance(aclrtGetSocName());
    if (platform == nullptr) {
        throw std::runtime_error("BatchMatmulMaxSum: cannot query platform");
    }
    matmul_tiling::MatmulApiTiling tiling(*platform);
    const auto dtype = a.dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                                   : matmul_tiling::DataType::DT_BF16;
    tiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX1);
    tiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX2);
    tiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT);
    // 固定基础块不能大于单核计算块；有效尺寸在核内通过 SetTail 指定。
    tiling.SetShape(tileRows, tileCols, k);
    tiling.SetOrgShape(m, n, k);
    tiling.SetFixSplit(tileRows, tileCols);
    tiling.SetBias(false);
    tiling.SetBufferSpace(-1, -1, -1);
    if (tiling.GetTiling(params.cube) != 0) {
        throw std::runtime_error("BatchMatmulMaxSum: Matmul tiling failed");
    }

    aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
    aclmdlRI capturedModel = nullptr;
    CheckAcl(aclmdlRICaptureGetInfo(stream, &captureStatus, &capturedModel), "aclmdlRICaptureGetInfo");
    const bool capturing = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
    std::unique_ptr<KernelWorkspace> memory(new KernelWorkspace);
    const size_t scratchTiles = params.n > tileCols ? 2 : 1;
    memory->scratch.Allocate(static_cast<size_t>(params.cores) * scratchTiles
        * tileRows * tileCols * sizeof(float));
    const uint32_t partialStride = splitN ? tileRows : PARTIAL_STRIDE;
    memory->partial.Allocate(static_cast<size_t>(rowTasks) * parts * partialStride * sizeof(float));
    const size_t workspaceBytes = platform->GetLibApiWorkSpaceSize();
    memory->system.Allocate(workspaceBytes);
    if (!capturing) {
        CheckAcl(aclrtMemset(memory->system.address, workspaceBytes, 0, workspaceBytes), "aclrtMemset");
    }
    auto scratchAddr = (GM_ADDR)memory->scratch.address;
    auto partialAddr = (GM_ADDR)memory->partial.address;
    auto workspaceAddr = (GM_ADDR)memory->system.address;
    if (capturing) {
        // 编译器生成的核内初始化随计算图一起重放，无须同步 Host 清零。
        // 注册成功后由计算图接管内存；run_kernel 返回时不能提前释放。
        CheckAcl(aclmdlRIDestroyRegisterCallback(capturedModel, DestroyCapturedWorkspace, memory.get()),
            "aclmdlRIDestroyRegisterCallback");
        memory.release();
    }
    if (a.dtype == 1) {
        LaunchByShapeKey<half>(x1, x2, scratchAddr, partialAddr, y, workspaceAddr,
            params, stream, transposeX1, transposeX2, shapeKey, splitN);
    } else {
        LaunchByShapeKey<bfloat16_t>(x1, x2, scratchAddr, partialAddr, y, workspaceAddr,
            params, stream, transposeX1, transposeX2, shapeKey, splitN);
    }
    if (!capturing) {
        CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
    }
}
